<item name='$$FormScript' summary='false' sign='true'><text>'++LotusScript Development Environment:2:5:(Options):0:66

'++LotusScript Development Environment:2:5:(Forward):0:1
Declare Sub Querysave(Source As Notesuidocument, Continue As Variant)
Declare Sub Querymodechange(Source As Notesuidocument, Continue As Variant)
Declare Sub Postopen(Source As Notesuidocument)
Declare Sub Queryopen(Source As Notesuidocument, Mode As Integer, Isnewdoc As Variant, Continue As Variant)

'++LotusScript Development Environment:2:5:(Declarations):0:2

'++LotusScript Development Environment:2:2:BindEvents:1:129
Private Sub BindEvents(Byval Objectname_ As String)
     Static Source As NOTESUIDOCUMENT
     Set Source = Bind(Objectname_)
     On Event Querysave From Source Call Querysave
     On Event Querymodechange From Source Call Querymodechange
     On Event Postopen From Source Call Postopen
     On Event Queryopen From Source Call Queryopen
End Sub

'++LotusScript Development Environment:2:2:Querysave:1:12
Sub Querysave(Source As Notesuidocument, Continue As Variant)
     
     Dim ws As New notesuiworkspace
     Dim uidoc As notesuidocument
     Dim doc As notesdocument
     Dim flagnumber As Integer
     
     Set uidoc=ws.currentdocument
     Set doc = uidoc.document
     If uidoc.IsNewDoc Then
          Call uidoc.FieldSetText("budgetOp_com", "0")
          Call uidoc.FieldSetText("budgetTrav_com", "0")
          Call uidoc.FieldSetText("budgetContr_com", "0")
          Call uidoc.FieldSetText("budgetCap_com", "0")
          Call uidoc.Refresh
     End If
     ' -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
     ' This section fills the "CategoriesAllowed" field.
     ' We are using flag numbers to determine which categories of spending are allowed for this project.
     ' 8 = Operating
     ' 4 = Travel
     ' 2 = Contract
     ' 1= Capital
     ' If there is a value larger than 0 in any of the sections, then the corresponding number is added to 'flagnumber'.
     ' This will give us unique numbers for each combination of Operating, Travel, Contract and Capital
     ' IE:  A value of 15 will return all 4... 8 (Operating) + 4 (Travel) + 2 (Contract) +1 (Capital) = 15
     '       A value of 6 will return Travel and Contract ...  4 (Travel) + 2 (Contract) = 6
     ' We can then use this number to determine whether or not to list certain Cost Code items from the Cost Code dialogue
     ' ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
     flagnumber = 0
     
     If Not (uidoc.fieldGetText("budgetOp")) = "$0.00" Then
          flagnumber = flagnumber + 8
     End If
     If Not (uidoc.fieldGetText("budgetTrav")="$0.00")  Then
          flagnumber = flagnumber + 4
     End If
     If Not (uidoc.fieldgettext("budgetContr")= "$0.00") Then
          flagnumber =flagnumber + 2
     End If
     If Not (uidoc.fieldgettext("budgetCap")="$0.00") Then 
          flagnumber = flagnumber + 1
     End If
     Call uidoc.fieldsettext("CategoriesAllowed", Cstr(flagnumber))
' -------------------------------------------------------------------------------------------------------------------------------------------------------------------     
     Call uidoc.refresh
     
End Sub
'++LotusScript Development Environment:2:2:Querymodechange:1:12
Sub Querymodechange(Source As Notesuidocument, Continue As Variant)
     Dim test As String
     Dim answer As Variant
     test="@IsMember('[Admin]';@userRoles)"
     answer=Evaluate(test)
     If Not(answer(0)=1) Then
          Continue=False
     End If
End Sub
'++LotusScript Development Environment:2:2:Postopen:1:12
Sub Postopen(Source As Notesuidocument)
     
End Sub
'++LotusScript Development Environment:2:2:Queryopen:1:12
Sub Queryopen(Source As Notesuidocument, Mode As Integer, Isnewdoc As Variant, Continue As Variant)
     Dim test As String
     Dim answer As Variant
     test="@IsMember('[Admin]';@userRoles)"
     answer=Evaluate(test)
     If Mode = 1 And Not(answer(0)=1) Then
          Continue=False
     End If
End Sub<break/></text></item>
<item name='$$FiscalYearEnd' summary='false' sign='true'><text>'++LotusScript Development Environment:2:5:(Options):0:66

'++LotusScript Development Environment:2:5:(Forward):0:1
Declare Sub Exiting(Source As Field)

'++LotusScript Development Environment:2:5:(Declarations):0:10
Const NPB_STATUSBAR% = 1

Declare Sub NEMProgressEnd Lib "nnotesws.dll" ( Byval hwnd As Long )
Declare Function NEMProgressBegin Lib "nnotesws.dll" ( Byval wFlags As Integer ) As Long
Declare Sub NEMProgressSetBarPos Lib "nnotesws.dll" ( Byval hwnd As Long, Byval dwPos As Long)
Declare Sub NEMProgressSetBarRange Lib "nnotesws.dll" ( Byval hwnd As Long, Byval dwMax As Long )
Declare Sub NEMProgressSetText Lib "nnotesws.dll" ( Byval hwnd As Long, Byval pcszLine1 As String, Byval pcszLine2 As String )

'++LotusScript Development Environment:2:2:BindEvents:1:129
Private Sub BindEvents(Byval Objectname_ As String)
	Static Source As FIELD
	Set Source = Bind(Objectname_)
	On Event Exiting From Source Call Exiting
End Sub

'++LotusScript Development Environment:2:2:Exiting:1:12
Sub Exiting(Source As Field)
	
	'======================
	' For the status bar
	On Error Goto killbar
	Dim hwnd As Long
	Dim i As Long
	'======================
	
	Dim ws As New notesuiworkspace
	Dim uidoc As notesuidocument
	Dim bOpTotal As Currency
	Dim bTravTotal As Currency
	Dim bConTotal As Currency
	Dim bCapTotal As Currency
	Dim purchCat As String
	
	Dim s As New notessession
	Dim db As notesdatabase
	Dim dv As notesview
	Dim dvc As notesviewentrycollection
	Dim oDoc As notesdocument
	
	bOpTotal = 0
	bTravTotal = 0
	bConTotal = 0
	bCapTotal = 0
	
	Set uidoc=ws.currentdocument
	Set db=s.CurrentDatabase
	Set dv=db.GetView("reflookup")
	Set dvc=dv.AllEntries
	Set oDoc = dv.GetFirstDocument
	'============================
	' Start the status bar
	i = 1
	''NEMProgressSetText hwnd, "Please wait...", "Recalculating budget..."
	''hwnd = NEMProgressBegin(NPB_STATUSBAR)
	''NEMProgressSetBarRange hwnd, dvc.Count
	''NEMProgressSetText hwnd, "Calculating...", "Please wait while all orders for " &amp; uidoc.FieldGetText("FiscalYearStart") &amp; " to " &amp; uidoc.FieldGetText("FiscalYearEnd") &amp; " are totaled"
	
	'============================
	Dim item As NotesItem
	Dim dtIssueDate As NotesDateTime
	Dim dtFYStart As NotesDateTime
	Dim dtFYEnd As NotesDateTime
	Set item = uidoc.Document.GetFirstItem( "FiscalYearStart" )
	Set dtFYStart = item.DateTimeValue
	Set item = uidoc.Document.GetFirstItem( "FiscalYearEnd" )
	Set dtFYEnd = item.DateTimeValue	
	
	While Not (oDoc Is Nothing)
		Set item = oDoc.GetFirstItem( "IssueDate" )
		Set dtIssueDate = item.DateTimeValue	
		
		'2009-05-21: JML: ADR#3550: the field "Created" was replaced with "IssueDate" becasue that date is not affected when copying documents from Prod to Dev
		'If oDoc.Created &gt;= uidoc.Document.FiscalYearStart(0) And oDoc.Created &lt;= uidoc.Document.FiscalYearEnd(0) Then
		If dtIssueDate.DateOnly &gt;= dtFYStart.DateOnly And dtIssueDate.DateOnly &lt;= dtFYEnd.DateOnly Then		
			purchCat = oDoc.FinCategory(0)
			If oDoc.ProjectSelection(0)=uidoc.FieldGetText("Project") And oDoc.BudgetCalculated(0) = "Yes" Then
				Select Case purchCat
				Case "Operating"
					If oDoc.GSTExempt(0)="Yes" Then
						bOpTotal = bOpTotal + oDoc.TotCost(0)                       
					Else
						bOpTotal = bOpTotal + oDoc.TotCostTaxed(0)
					End If
				Case "Travel"
					If oDoc.GSTExempt(0)="Yes" Then
						bTravTotal = bTravTotal + oDoc.TotCost(0)                       
					Else
						bTravTotal = bTravTotal + oDoc.TotCostTaxed(0)
					End If
				Case "Contract"
					If oDoc.GSTExempt(0)="Yes" Then
						bConTotal = bConTotal + oDoc.TotCost(0)                       
					Else
						bConTotal = bConTotal + oDoc.TotCostTaxed(0)
					End If
				Case "Capital"
					If oDoc.GSTExempt(0)="Yes" Then
						bCapTotal = bCapTotal + oDoc.TotCost(0)                       
					Else
						bCapTotal = bCapTotal + oDoc.TotCostTaxed(0)
					End If
				End Select
			End If
		End If
		Set oDoc=dv.GetNextDocument(oDoc)
		''NEMProgressSetText hwnd, "Calculating...", "Please wait while all orders for " &amp; uidoc.FieldGetText("FiscalYearStart") &amp; " to " &amp; uidoc.FieldGetText("FiscalYearEnd") &amp; " are processed. (" &amp; i &amp;"/" &amp;Cstr(dvc.Count)&amp;")"
		''NEMProgressSetBarPos hwnd, i
		i = i + 1
		
	Wend
	
	Call uidoc.FieldSetText("budgetOp_com",Cstr(bOpTotal))
	Call uidoc.FieldSetText("budgetTrav_com", Cstr(bTravTotal))
	Call uidoc.FieldSetText("budgetContr_com", Cstr(bConTotal))
	Call uidoc.FieldSetText("budgetCap_com", Cstr(bCapTotal))
killbar:
	''NEMProgressEnd hwnd
	
	' Use the Err function to return the error number and 
	' the Error$ function to return the error message.
	Messagebox "Error" &amp; Str(Err) &amp; ": " &amp; Error$
	
	uidoc.Refresh
End Sub<break/></text></item>
