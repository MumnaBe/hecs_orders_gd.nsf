<item name='$$FormScript' summary='false' sign='true'><text>'++LotusScript Development Environment:2:5:(Options):0:66

'++LotusScript Development Environment:2:5:(Forward):0:1
Declare Sub Queryopen(Source As Notesuidocument, Mode As Integer, Isnewdoc As Variant, Continue As Variant)
Declare Sub Querysave(Source As Notesuidocument, Continue As Variant)
Declare Sub Queryclose(Source As Notesuidocument, Continue As Variant)
Declare Sub Querymodechange(Source As Notesuidocument, Continue As Variant)
Declare Sub Postopen(Source As Notesuidocument)
Declare Sub Postmodechange(Source As Notesuidocument)

'++LotusScript Development Environment:2:5:(Declarations):0:2

'++LotusScript Development Environment:2:2:BindEvents:1:129
Private Sub BindEvents(Byval Objectname_ As String)
	Static Source As NOTESUIDOCUMENT
	Set Source = Bind(Objectname_)
	On Event Queryopen From Source Call Queryopen
	On Event Querysave From Source Call Querysave
	On Event Queryclose From Source Call Queryclose
	On Event Querymodechange From Source Call Querymodechange
	On Event Postopen From Source Call Postopen
	On Event Postmodechange From Source Call Postmodechange
End Sub

'++LotusScript Development Environment:2:2:Queryopen:1:12
Sub Queryopen(Source As Notesuidocument, Mode As Integer, Isnewdoc As Variant, Continue As Variant)
	
End Sub
'++LotusScript Development Environment:2:2:Querysave:1:12
Sub Querysave(Source As Notesuidocument, Continue As Variant)
	
	Dim s As New notessession
	Dim db As notesdatabase
	Dim dv As notesview
	Dim dv2 As notesview
	Dim doc2 As notesdocument
	Dim documentCounter As Integer
	Dim projName As String
	
	
     ' Field Validation
	If Source.FieldGetText("ProjectSelection")="" Then 
		Messagebox "A Project must be selected." &amp; Chr(10) &amp; Chr(10) &amp; "Veuillez sélectionner un projet."
		continue = False
	Elseif Source.FieldGetText("FinCode")="" Then
		Messagebox "A financial code is needed for this order. Press the 'Generate Financial Code' button in the action bar above." &amp; Chr(10) &amp; Chr(10) &amp; _
		"Un code financier est nécessaire pour cette commande. Veuiller cliquer sur le bouton `Générer Code Financier`"
		continue = False  
	Elseif Source.FieldGetText("PurchaseType") = "" Then
		Messagebox "Please select a purchase type."&amp;Chr(10) &amp; Chr(10) &amp; "Veuillez sélectionner un Type d\'achat"
		continue = False
	Elseif Source.FieldGetText("CardHolder") = "" And Source.FieldGetText("SignAuth") = "" Then
		Messagebox "Please select a card holder/signing authority." &amp; Chr(10) &amp; Chr(10) &amp; "Veuillez sélectionner un détenteur de carte/pouvoir de signature."
		continue = False
	Elseif Source.FieldGetText("ShipTo") = "" Or Source.FieldGetText("InvName")="" Then
		Messagebox "Please ensure that shipping/billing information is complete." &amp; Chr(10) &amp; Chr(10) &amp; "Assurez-vous que la commande est complète"
		continue = False
		Elseif Source.FieldGetText("CompanyName")="" Or Source.FieldGetText("CompPhone")="" Or _
	Source.FieldGetText("CompFax")="" Then
		Messagebox "Please ensure that company information is complete."  &amp; Chr(10) &amp; Chr(10) &amp; "Veuillez sélectionner une compagnie."
		continue = False
	End If     
	
	
     ' Sets the readers and authors fields.
     ' This is done to limit documents to the Manager, PI, Employees of specific documents, as well as the Admin person responsible for placing orders
     ' If uidoc.IsnewDoc Then
     ' End If
	Set doc=Source.Document
	If Not(doc.SendWarning(0)="Sent" Or doc.SendWarning2(0)="Sent") Then
		Call BudgetLimit   
		Call CreditCardLimit  
	End If
	
	Call Source.FieldSetText("SaveOptions", "1")
	
	Source.Refresh
	Source.RefreshHideFormulas        
	
	Set db=s.CurrentDatabase
	Set dv=db.GetView("PLV")
	Set dv2=db.GetView("KeywordLookup")
	Set doc2=dv2.GetDocumentByKey("SendToAdmin")
	' Messagebox doc2.EkeyWord(0)
	
	projName=doc.ProjectSelection(0)
	Set projdoc=dv.GetDocumentByKey(projName)
	doc.ReplaceItemValue "Authors", "LNOG_HECS"
	doc.ReplaceItemValue "Readers", "LNOG_HECS"
	Source.Reload
	Set authorItem=doc.GetFirstItem("Authors")
	Set readerItem=doc.GetFirstItem("Readers")
	
	authorItem.AppendToTextList(doc2.EKeyWord(0))
	readerItem.AppendToTextList(doc2.EKeyWord(0))
	authorItem.AppendToTextList(db.Server)
	readerItem.AppendToTextList(db.Server)
	authorItem.AppendToTextList(projdoc.PI(0))
	readerItem.AppendToTextList(projdoc.PI(0))
	authorItem.AppendToTextList(projdoc.Manager(0))
	readerItem.AppendToTextList(projdoc.Manager(0))
	authorItem.AppendToTextList("[Admin]")
	readerItem.AppendToTextList("[Admin]")
	'authorItem.AppendToTextList("[LNOG_Admin]")
	'readerItem.AppendToTextList("[LNOG_Admin]")
	Forall x In projdoc.Employees
		If doc.Status(0)="New" Then
			authorItem.AppendToTextList(x)
		End If
		readerItem.AppendToTextList(x)
	End Forall
	
End Sub
'++LotusScript Development Environment:2:2:Queryclose:1:12
Sub Queryclose(Source As Notesuidocument, Continue As Variant)
	
End Sub
'++LotusScript Development Environment:2:2:Querymodechange:1:12
Sub Querymodechange(Source As Notesuidocument, Continue As Variant)
' This is in order to prevent the author of an order to go back and edit an order that was already sent to the Admin.
	Dim sent As String
	Dim role As Variant
	
	role = Evaluate("@IsMember('[Admin]';@UserRoles)")
	If Not ( source.EditMode ) Then        ' If we're not in edit mode then
		sent = source.FieldGetText( "Sent" )
		If ( sent = "Yes" ) And ( role(0) = 0 ) Then     ' If the user does not have the [Admin] role and the order has already been sent to the admin
			Messagebox ( "Sorry! This document is available for browsing only." &amp; Chr(10) &amp; Chr(10) &amp; "Aucun modification est possible." )
			continue = False
		End If
	End If     
	
End Sub
'++LotusScript Development Environment:2:2:Postopen:1:12
Sub Postopen(Source As Notesuidocument)
	Dim ws As New notesuiworkspace
	Dim uidoc As notesuidocument     
	Dim s As New notessession
	Dim db As notesdatabase
	Dim dv As notesview
	Dim projdoc As notesdocument
	Dim projitem As notesitem
	Dim inproj As Integer
	
	inproj = 0
	Set uidoc=ws.currentdocument
	Set db=s.currentdatabase
	Set dv=db.getview("PLV")
	Set projdoc=dv.getfirstdocument
	While Not (projdoc Is Nothing)
		Set projitem=projdoc.getfirstitem("PI")
		Forall x In projitem.values
			If x=s.Commonusername Then
				inproj=1
			End If
		End Forall
		If Not (inproj=1) Then
			Set projitem=projdoc.getfirstitem("Manager")
			Forall y In projitem.values
				If y=s.Commonusername Then
					inproj=1
				End If
			End Forall
		End If
		If Not (inproj=1) Then
			Set projitem=projdoc.getfirstitem("Employees")
			Forall z In projitem.values
				If z=s.commonusername Then
					inproj=1
				End If
			End Forall
		End If
		If inproj = 1 And uidoc.EditMode = True Then Call uidoc.fieldsettext("ProjectSelection1", uidoc.fieldgettext("ProjectSelection1") + "," + projdoc.Project(0))
		inproj = 0
		Set projdoc=dv.GetNextDocument(projdoc)
	Wend
	If uidoc.IsNewDoc Then 
		Call InvoiceAddress
		Call ShippingAddress
	End If
	
	If uidoc.EditMode=True Then uidoc.Refresh
	
	
End Sub
'++LotusScript Development Environment:2:2:Postmodechange:1:12
Sub Postmodechange(Source As Notesuidocument)
	If source.EditMode = True Then
		Call source.FieldSetText("LastProjectSelected", source.FieldGetText("ProjectSelection"))
	End If
End Sub<break/><break/></text></item>
<item name='$Script' summary='false' sign='true'><text>'++LotusScript Development Environment:2:5:(Options):0:74
Option Public
Use "AddressFill"
