<item name='$$FormScript' summary='false' sign='true'><text>'++LotusScript Development Environment:2:5:(Options):0:66

'++LotusScript Development Environment:2:5:(Forward):0:1
Declare Sub Querysave(Source As Notesuidocument, Continue As Variant)
Declare Sub Querymodechange(Source As Notesuidocument, Continue As Variant)
Declare Sub Postopen(Source As Notesuidocument)
Declare Sub Queryopen(Source As Notesuidocument, Mode As Integer, Isnewdoc As Variant, Continue As Variant)

'++LotusScript Development Environment:2:5:(Declarations):0:2

'++LotusScript Development Environment:2:2:BindEvents:1:129
Private Sub BindEvents(Byval Objectname_ As String)
     Static Source As NOTESUIDOCUMENT
     Set Source = Bind(Objectname_)
     On Event Querysave From Source Call Querysave
     On Event Querymodechange From Source Call Querymodechange
     On Event Postopen From Source Call Postopen
     On Event Queryopen From Source Call Queryopen
End Sub

'++LotusScript Development Environment:2:2:Querysave:1:12
Sub Querysave(Source As Notesuidocument, Continue As Variant)
     
     Dim ws As New notesuiworkspace
     Dim uidoc As notesuidocument
     Dim doc As notesdocument
     Dim flagnumber As Integer
     
     Set uidoc=ws.currentdocument
     Set doc = uidoc.document
     If uidoc.IsNewDoc Then
          Call uidoc.FieldSetText("budgetOp_com", "0")
          Call uidoc.FieldSetText("budgetTrav_com", "0")
          Call uidoc.FieldSetText("budgetContr_com", "0")
          Call uidoc.FieldSetText("budgetCap_com", "0")
          Call uidoc.Refresh
     End If
     ' -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
     ' This section fills the "CategoriesAllowed" field.
     ' We are using flag numbers to determine which categories of spending are allowed for this project.
     ' 8 = Operating
     ' 4 = Travel
     ' 2 = Contract
     ' 1= Capital
     ' If there is a value larger than 0 in any of the sections, then the corresponding number is added to 'flagnumber'.
     ' This will give us unique numbers for each combination of Operating, Travel, Contract and Capital
     ' IE:  A value of 15 will return all 4... 8 (Operating) + 4 (Travel) + 2 (Contract) +1 (Capital) = 15
     '       A value of 6 will return Travel and Contract ...  4 (Travel) + 2 (Contract) = 6
     ' We can then use this number to determine whether or not to list certain Cost Code items from the Cost Code dialogue
     ' ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
     flagnumber = 0
     
     If Not (uidoc.fieldGetText("budgetOp")) = "$0.00" Then
          flagnumber = flagnumber + 8
     End If
     If Not (uidoc.fieldGetText("budgetTrav")="$0.00")  Then
          flagnumber = flagnumber + 4
     End If
     If Not (uidoc.fieldgettext("budgetContr")= "$0.00") Then
          flagnumber =flagnumber + 2
     End If
     If Not (uidoc.fieldgettext("budgetCap")="$0.00") Then 
          flagnumber = flagnumber + 1
     End If
     Call uidoc.fieldsettext("CategoriesAllowed", Cstr(flagnumber))
' -------------------------------------------------------------------------------------------------------------------------------------------------------------------     
     Call uidoc.refresh
     
End Sub
'++LotusScript Development Environment:2:2:Querymodechange:1:12
Sub Querymodechange(Source As Notesuidocument, Continue As Variant)
     Dim test As String
     Dim answer As Variant
     test="@IsMember('[Admin]';@userRoles)"
     answer=Evaluate(test)
     If Not(answer(0)=1) Then
          Continue=False
     End If
End Sub
'++LotusScript Development Environment:2:2:Postopen:1:12
Sub Postopen(Source As Notesuidocument)
     
End Sub
'++LotusScript Development Environment:2:2:Queryopen:1:12
Sub Queryopen(Source As Notesuidocument, Mode As Integer, Isnewdoc As Variant, Continue As Variant)
     Dim test As String
     Dim answer As Variant
     test="@IsMember('[Admin]';@userRoles)"
     answer=Evaluate(test)
     If Mode = 1 And Not(answer(0)=1) Then
          Continue=False
     End If
End Sub<break/></text></item>
