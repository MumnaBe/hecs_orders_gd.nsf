<item name='$$FormScript' summary='false' sign='true'><text>'++LotusScript Development Environment:2:5:(Options):0:66

'++LotusScript Development Environment:2:5:(Forward):0:1
Declare Sub Querysave(Source As Notesuidocument, Continue As Variant)
Declare Sub Querymodechange(Source As Notesuidocument, Continue As Variant)
Declare Sub Postopen(Source As Notesuidocument)
Declare Sub Postmodechange(Source As Notesuidocument)

'++LotusScript Development Environment:2:5:(Declarations):0:2

'++LotusScript Development Environment:2:2:BindEvents:1:129
Private Sub BindEvents(Byval Objectname_ As String)
	Static Source As NOTESUIDOCUMENT
	Set Source = Bind(Objectname_)
	On Event Querysave From Source Call Querysave
	On Event Querymodechange From Source Call Querymodechange
	On Event Postopen From Source Call Postopen
	On Event Postmodechange From Source Call Postmodechange
End Sub

'++LotusScript Development Environment:2:2:Querysave:1:12
Sub Querysave(Source As Notesuidocument, Continue As Variant)
	
	Dim s As New notessession
	Dim db As notesdatabase
	Dim dv As notesview
	Dim dv2 As notesview
	Dim doc2 As notesdocument
	Dim doc As NotesDocument
	Dim documentCounter As Integer
	Dim projName As String	
	Dim projdoc As notesdocument	
	Dim status As String
	Dim itemReceivedStatus As String
	Dim answer As Integer
	
     ' Field Validation
	If Source.FieldGetText("ProjectSelection")="" Then 
		Messagebox "A Project must be selected." &amp; Chr(10) &amp; Chr(10) &amp; "Veuillez sélectionner un projet."
		continue = False
	Elseif Source.FieldGetText("FinCode")="" Then
		Messagebox "A financial code is needed for this order. Press the 'Generate Financial Code' button in the action bar above." &amp; Chr(10) &amp; Chr(10) &amp; _
		"Un code financier est nécessaire pour cette commande. Veuiller cliquer sur le bouton `Générer Code Financier`"
		continue = False  
	Elseif Source.FieldGetText("PurchaseType") = "" Then
		Messagebox "Please select a purchase type."&amp;Chr(10) &amp; Chr(10) &amp; "Veuillez sélectionner un Type d\'achat"
		continue = False
	Elseif Source.FieldGetText("CardHolder") = "" And Source.FieldGetText("SignAuth") = "" Then
		Messagebox "Please select a card holder/signing authority." &amp; Chr(10) &amp; Chr(10) &amp; "Veuillez sélectionner un détenteur de carte/pouvoir de signature."
		continue = False
	Elseif Source.FieldGetText("ShipTo") = "" Or Source.FieldGetText("InvName")="" Then
		Messagebox "Please ensure that shipping/billing information is complete." &amp; Chr(10) &amp; Chr(10) &amp; "Assurez-vous que la commande est complète"
		continue = False
	Elseif Source.FieldGetText("Floor") = "" Then
		Messagebox "Please ensure that floor information is entered." &amp; Chr(10) &amp; Chr(10) &amp; "Assurez-vous que l'information de l'étage est entrée"
		continue = False
	Elseif Source.FieldGetText("Room") = "" Then
		Messagebox "Please ensure that room information is entered." &amp; Chr(10) &amp; Chr(10) &amp; "Assurez-vous que l'information de la pièce est entrée"
		continue = False
		Elseif Source.FieldGetText("CompanyName")="" Or Source.FieldGetText("CompPhone")="" Or _
	Source.FieldGetText("CompFax")="" Then
		Messagebox "Please ensure that company information is complete."  &amp; Chr(10) &amp; Chr(10) &amp; "Veuillez sélectionner une compagnie."
		continue = False
	End If     
	
     ' Sets the readers and authors fields.
     ' This is done to limit documents to the Manager, PI, Employees of specific documents, as well as the Admin person responsible for placing orders
     ' If uidoc.IsnewDoc Then
     ' End If
	Set doc=Source.Document
	If Not(doc.SendWarning(0)="Sent" Or doc.SendWarning2(0)="Sent") Then
		Call BudgetLimit   
		Call CreditCardLimit  
	End If
	
	Call Source.FieldSetText("SaveOptions", "1")
	
	Source.Refresh
	Source.RefreshHideFormulas        
	
	' 2009-06-11: JML: ADR 3550: to handle cases where the CTRL-S is used before _
	' choosing a Project Name, the following exit has been created.	 Otherwise it was _
	' Generating a variable not found error with projdoc.
	If continue = False Then
		Exit Sub
	End If
	
	Set db=s.CurrentDatabase
	Set dv=db.GetView("PLV")
	Set dv2=db.GetView("KeywordLookup")
	Set doc2=dv2.GetDocumentByKey("SendToAdmin")
	
	projName=doc.ProjectSelection(0)
	Set projdoc=dv.GetDocumentByKey(projName)
	
	If projdoc Is Nothing Then
		' The project could not be found.  Its either a missing document or th eproject has been renamed.
		answer% = Messagebox( "The project " &amp; projName &amp; " could not be found.  Please contact the administrator.  The changes will not be saved.   Le projet " &amp; projName &amp; " n'a pas été trouvé.  Veuillez contacter l'administrateur. Les changements ne seront pas sauvegardés" , 0+16, "Operation Cancelled / Opération annulée" )					
		continue = False
		Exit Sub
	Else
		doc.ReplaceItemValue "Authors", "LNOG_HECS"
		doc.ReplaceItemValue "Readers", "LNOG_HECS"
		Source.Reload
		Set authorItem=doc.GetFirstItem("Authors")
		Set readerItem=doc.GetFirstItem("Readers")
		
		authorItem.AppendToTextList(doc2.EKeyWord(0))
		readerItem.AppendToTextList(doc2.EKeyWord(0))
		authorItem.AppendToTextList(db.Server)
		readerItem.AppendToTextList(db.Server)
		authorItem.AppendToTextList(projdoc.PI(0))
		readerItem.AppendToTextList(projdoc.PI(0))
		authorItem.AppendToTextList(projdoc.Manager(0))
		readerItem.AppendToTextList(projdoc.Manager(0))
		authorItem.AppendToTextList("[Admin]")
		readerItem.AppendToTextList("[Admin]")
		authorItem.AppendToTextList("[LNOG_Admin]")
		readerItem.AppendToTextList("[LNOG_Admin]")
		Forall x In projdoc.Employees
			If doc.Status(0)="New" Then
				authorItem.AppendToTextList(x)
			End If
			readerItem.AppendToTextList(x)
		End Forall		
	End If
	
	' /*******Track changes to the order's cost
	' If the TotCostTaxed have changed for orders for which the budget has already been calucated, then we have to update the budget
	Dim tmpCostBefore As Currency
	Dim tmpCostAfter As Currency
	Dim costDifference As Currency
	tmpCostBefore = Ccur(Replace(source.FieldGetText("TrackOriginalCost"), "$", "")) ' Remove the $ because the field is displayed as Curency
	tmpCostAfter = Ccur(Replace(source.FieldGetText("TotCostTaxed"), "$", ""))  ' Remove the $ because the field is displayed as Curency
	If 	tmpCostBefore -  tmpCostAfter &lt;&gt; 0 Then ' TotCostTaxed has changed
		If doc.BudgetCalculated(0) = "Yes" Then ' The budget for that Order has been calculated already
			Dim category As String
			Dim purchasetype As String
			Dim projectname As String
			
			Dim language As String
			Language = s.GetEnvironmentString("HECS_Language")  ' get the current language
			
			' Get the user's confirmation to make sure we can update the budget and save.
			If Language = "F" Then
				answer% = Messagebox ( "Le montant de la commande à changé.  En sauvegardant ce document, vous allez mettre à jour le montant engagé pour le projet et le montant restant sur la carte de crédit?" , 3+48, "Continuer ?" )					
			Else
				answer% = Messagebox ( "The cost of this Order has changed.  Saving the document will update the committed amount on the project's budget and the Remaining Credit on Credit Card?" , 3+48, "Continue?" )	
			End If
			Select Case answer%
			Case 6 ' Answer is Yes, we have to update the Project's Budget and the Remaining Credit on the Credit Card.
				
				' Calculate the difference.  Nothe that the positive and negative values are handled
				costDifference = tmpCostAfter - tmpCostBefore
				
				'If there is no project, the user should be informed and the operation will stop.  The user should make sure the project exist and retry.
				If projdoc Is Nothing Then					
					If Language = "F" Then
						Messagebox "Le projet n’a pas été trouvé, donc le budget n’a pas été calculé.  Veuillez vérifier que le projet existe et réessayer.", 0+48, "Le budget n'as pas été mis à jour"
					Else
						Messagebox "The project cannot be found.  The project`s budget has not been calculated.  Please ensure the project exists and try again.", 0+48, "The project's budget has not been calculated"				
					End If	
					Exit Sub
				End If
				
				' update the commited amount on the project based on the specified category
				category = doc.FinCategory(0)   ' get the value of the financial category field
				Select Case category
				Case "Operating"
					'Note that positive and negative values are handled
					projdoc.budgetOp_com=projdoc.budgetOp_com(0) + costDifference
					projdoc.TotCommitted = projdoc.TotCommitted(0) + costDifference
				Case "Travel"
					projdoc.budgetTrav_com=projdoc.budgetTrav_com(0) + costDifference
					projdoc.TotCommitted = projdoc.TotCommitted(0) + costDifference
				Case "Contract"
					projdoc.budgetContr_com=projdoc.budgetContr_com(0) + costDifference
					projdoc.TotCommitted = projdoc.TotCommitted(0) + costDifference
				Case "Capital"
					projdoc.budgetCap_com=projdoc.budgetCap_com(0) + costDifference
					projdoc.TotCommitted = projdoc.TotCommitted(0) + costDifference
				End Select
				
				' The Free Balance is updated on the project
				projdoc.FreeBalance=projdoc.totBudget(0)-projdoc.totCommitted(0)
				
				' It the purchase type is Visa or MasterCard then Lower the Remaining Credit on the Credit Card using the TotCostTaxed amount
				purchasetype = doc.PurchaseType(0)				
				If Not (purchasetype="Purchase Order") Then
					Dim carddv As notesview
					Dim Carddoc As notesdocument
					Dim namekey(1 To 2) As String
					
					Set carddv = db.GetView("CHL")   ' getting the card holder lookup view             
					cardholdername = doc.CardHolder(0)   ' get the value of the card holder field from the order document
					
					namekey(1) = purchasetype
					namekey(2) = cardholdername
					Set Carddoc = carddv.GetDocumentByKey(namekey)    ' according to the value of purchase type and card holder name, get the correct cardholder document from the card holder view
					If Not (Carddoc Is Nothing) Then
						Select Case purchasetype
						'Note that positive and negative values are handled
						Case "MasterCard"
							Carddoc.RemCreditM = Carddoc.RemCreditM(0) - costDifference   ' update the order amount from the remaining credit
						Case "VISA"
							Carddoc.RemCreditV = Carddoc.RemCreditV(0) - costDifference   ' update the order amount from the remaining credit
						End Select
					End If
				End If
				
				'Reset the Cost Tracking field to prevent the Save button to detect changes if the document is used several times.
				Call doc.ReplaceItemValue("trackOriginalCost", doc.GetItemValue("TotCostTaxed")) 		
				
				projdoc.Save True, True
				If Not (Carddoc Is Nothing) Then
					Carddoc.Save True, True
				End If
				
			Case Else  ' Answer is No or Cancel.  The user do not want to continue the save and update the budget
				
				answer% = Messagebox("The changes were not saved / Les changements n'ont pas été sauvegardés.", 0, "Operation Cancelled / Opération annulée")
				continue = False
				Exit Sub
			End Select
		End If		
	End If	
	
	'/**** Change the Status is we detect changes in the Partial and Received orders.
	status = source.FieldGetText("status")
	itemReceivedStatus = source.FieldGetText("itemsReceived")
	Select Case status
	Case "New"  'do nothing, not applicable at this status
	Case "Submitted"  'do nothing, not applicable at this status
	Case "On Order"
		' Make sure the Status is good.  The order may be Partially received or Received
		If itemReceivedStatus = "Partially Received" Then
			Call source.FieldSetText("Status", "Partially Received")
		Elseif  itemReceivedStatus = "Received" Then
			Call source.FieldSetText("Status", "Received")
		End If		
	Case "Partially Received"
		' Make sure the Status is good.  The order may be returned to On Order or Received
		If itemReceivedStatus = "None Received" Then
			Call source.FieldSetText("Status", "On Order")
		Elseif  itemReceivedStatus = "Received" Then
			Call source.FieldSetText("Status", "Received")
		End If	
	Case "Received"
		' Make sure the Status is good.  The order may be returned to On Order or Partially Received
		If itemReceivedStatus = "None Received" Then
			Call source.FieldSetText("Status", "On Order")
		Elseif  itemReceivedStatus = "Partially Received" Then
			Call source.FieldSetText("Status", "Partially Received")
		End If	
	Case "Cancelled"  'do nothing, document should not be editable
	End Select
	
End Sub
'++LotusScript Development Environment:2:2:Querymodechange:1:12
Sub Querymodechange(Source As Notesuidocument, Continue As Variant)
' This is in order to prevent the author of an order to go back and edit an order that was already sent to the Admin.
	Dim sent As String
	Dim statusStr As String
	Dim role As Variant
	
	role = Evaluate("@IsMember('[Admin]';@UserRoles)")
	If Not ( source.EditMode ) Then        ' If we're not in edit mode then
		
		' 2009-06-29: ADR 3550: JML: Prevent the document to be edited if the status is cancelled
		statusStr = source.FieldGetText( "Status" )
		If statusStr = "Cancelled" Then
			Messagebox ( "Sorry! This order is cancelled and cannot be edited. Please use the button 'Copy Existing Order' on the views if you want to create a similar order." &amp; Chr(10) &amp; Chr(10) &amp; "Cette commande est annulée et ne peut être modifiée.  Veuillez utiliser le bouton 'Copier une commande' dans les vues si vous désirez créer une commande similaire." )
			continue = False
			Exit Sub			
		End If		
		
		sent = source.FieldGetText( "Sent" )
		If ( sent = "Yes" ) And ( role(0) = 0 ) Then     ' If the user does not have the [Admin] role and the order has already been sent to the admin
			Messagebox ( "Sorry! This document is available for browsing only." &amp; Chr(10) &amp; Chr(10) &amp; "Aucun modification est possible." )
			continue = False	
		End If
	End If     
	
End Sub
'++LotusScript Development Environment:2:2:Postopen:1:12
Sub Postopen(Source As Notesuidocument)
	
	Dim ws As New notesuiworkspace
	Dim uidoc As notesuidocument     
	Dim s As New notessession
	Dim db As notesdatabase
	Dim dv As notesview
	Dim projdoc As notesdocument
	Dim projitem As notesitem
	Dim inproj As Integer
	
	' 2009-06-15: JML: ADR 3550: this is to prevent the Author of the Order to edit the document upon ailing it to the admin.
	' The Querymodechange was taking care of that, but was not handling the users who were opening the document using CTRL-O
	Dim sent As String	
	Dim role As Variant	
	role = Evaluate("@IsMember('[Admin]';@UserRoles)")
	If source.EditMode=True Then		
		sent = source.FieldGetText( "Sent" )
		If ( sent = "Yes" ) And ( role(0) = 0 ) Then     ' If the user does not have the [Admin] role and the order has already been sent to the admin
			Messagebox ( "Sorry! This document is available for browsing only." &amp; Chr(10) &amp; Chr(10) &amp; "Aucun modification est possible." )
			source.EditMode = False ' go back to Read Mode
		End If		
	End If	
	
	
	' 2009-07-06: START: New method to populate the ProjectSelection1 field.
	' A new view called "" was created.  The first column is categorized based on the list of PI, Manager and Emploeyes of each project.
	' The second column contains the project names.
	
	Set db=s.currentdatabase
	Set dv=db.getview("PLV2")
	Set uidoc=ws.currentdocument
	Dim docColl As NotesDocumentCollection
	Dim key As String
	key = s.Commonusername
	'Messagebox "Key: " &amp; Key 
	Set docColl = dv.GetAllDocumentsByKey(key, True)
	
	Set projdoc=docColl.GetFirstDocument
	While Not projdoc Is Nothing
		If uidoc.EditMode = True Then Call uidoc.fieldsettext("ProjectSelection1", uidoc.fieldgettext("ProjectSelection1") + "," + projdoc.Project(0))
		Set projdoc=docColl.GetNextDocument(projdoc)
	Wend
	' 2009-07-06: END: 
	
	' 2009-07-06: Old method to check which projects the user can create order for.
	'inproj = 0
	'Set uidoc=ws.currentdocument
	'Set db=s.currentdatabase
	'Set dv=db.getview("PLV")
	'Set projdoc=dv.getfirstdocument
	'While Not (projdoc Is Nothing)
	'	Set projitem=projdoc.getfirstitem("PI")
	'	Forall x In projitem.values
	'		If x=s.Commonusername Then
	'			inproj=1
	'		End If
	'	End Forall
	'	If Not (inproj=1) Then
	'		Set projitem=projdoc.getfirstitem("Manager")
	'		Forall y In projitem.values
	'			If y=s.Commonusername Then
	'				inproj=1
	'			End If
	'		End Forall
	'	End If
	'	If Not (inproj=1) Then
	'		Set projitem=projdoc.getfirstitem("Employees")
	'		Forall z In projitem.values
	'			If z=s.commonusername Then
	'				inproj=1
	'			End If
	'		End Forall
	'	End If
	'	If inproj = 1 And uidoc.EditMode = True Then Call uidoc.fieldsettext("ProjectSelection1", uidoc.fieldgettext("ProjectSelection1") + "," + projdoc.Project(0))
	'	inproj = 0
	'	Set projdoc=dv.GetNextDocument(projdoc)
	'Wend
	
	' Populate the Addresses if the order is new.
	If uidoc.IsNewDoc Then 
		Call InvoiceAddress
		Call ShippingAddress
	End If
	
	' Set the TrackOriginalCost field to track the changes to the Order's cost.
	' This code will work if the document is opened in Edit mode
	Dim tmpStr As String
	If uidoc.EditMode = True Then
		tmpStr = uidoc.FieldGetText("TotCostTaxed")
		Call uidoc.FieldSetText("TrackOriginalCost", tmpStr)
	End If	
	
	If uidoc.EditMode=True Then uidoc.Refresh
	
End Sub
'++LotusScript Development Environment:2:2:Postmodechange:1:12
Sub Postmodechange(Source As Notesuidocument)
	If source.EditMode = True Then
		Call source.FieldSetText("LastProjectSelected", source.FieldGetText("ProjectSelection"))
		
		' To handle Order's opened in Read mode, we are setting the TrackOriginalCost field _
		'  to track the changes to the Order's cost.	
		Dim tmpStr As String
		tmpStr = Source.FieldGetText("TotCostTaxed")
		Call Source.FieldSetText("TrackOriginalCost", tmpStr)
	End If
End Sub<break/><break/></text></item>
<item name='$Script' summary='false' sign='true'><text>'++LotusScript Development Environment:2:5:(Options):0:74
