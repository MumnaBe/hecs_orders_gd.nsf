<item name='$$ProjectSelection' summary='false' sign='true'><text>'++LotusScript Development Environment:2:5:(Options):0:66

'++LotusScript Development Environment:2:5:(Forward):0:1
Declare Sub Exiting(Source As Field)

'++LotusScript Development Environment:2:5:(Declarations):0:2

'++LotusScript Development Environment:2:2:BindEvents:1:129
Private Sub BindEvents(Byval Objectname_ As String)
     Static Source As FIELD
     Set Source = Bind(Objectname_)
     On Event Exiting From Source Call Exiting
End Sub

'++LotusScript Development Environment:2:2:Exiting:1:12
Sub Exiting(Source As Field)
     Dim ws As New notesuiworkspace
     Dim s As New notessession     
     Dim uidoc As notesuidocument
     
     Dim db As notesdatabase
     Dim dv As notesview
     Dim doc As notesdocument
     
     Dim CategoryFlag As Integer     
     Dim IsOperating As Variant
     Dim IsTravel As Variant
     Dim IsContract As Variant
     Dim IsCapital As Variant
     
     Set db=s.currentdatabase
     Set dv=db.GetView("CCV")
     Set uidoc=ws.currentdocument
     
     IsOperating=False
     IsTravel=False
     IsContract=False
     IsCapital=False
     
     CategoryFlag=Cint(uidoc.FieldGetText("CategoriesAllowed"))
     If CategoryFlag &gt;= 8 Then
          IsOperating=True
          CategoryFlag = CategoryFlag -8            ' Check for "Operating" flag
     End If
     If CategoryFlag  &gt;= 4 Then
          IsTravel=True
          CategoryFlag = CategoryFlag - 4           ' Check for "Travel" flag
     End If
     If CategoryFlag &gt;= 2 Then
          IsContract=True
          CategoryFlag = CategoryFlag -2             ' Check for "Contract" flag
     End If
     If CategoryFlag &gt;= 1 Then
          IsCapital=True
          CategoryFlag = CategoryFlag -1             ' Check for "Capital" flag
     End If
     If CategoryFlag &gt; 0 Then Messagebox("Category Error!")
     
     Dim CCText As String
     Dim GLText As String
     Dim PNText As String
     Dim PAText As String
     
     Set doc=dv.GetFirstDocument()
     While Not (doc Is Nothing) 
          If ((doc.Category(0)="Operating" And IsOperating = True) Or (doc.Category(0) = "Travel" And IsTravel=True) Or (doc.Category(0) = "Contract" And IsContract = True) Or (doc.Category(0)="Capital" And IsCapital=True) Or (doc.Category(0)="")) Then
               If doc.Type(0)="Cost Centre" Then
                    CCText = CCText + doc.Name(0) + "|" + doc.CodeNumber(0) +";"     
               Elseif doc.Type(0)="G/L Account" Then
                    GLText = GLText + doc.Name(0) + "|" + doc.CodeNumber(0) +";"
               Elseif doc.Type(0)="Program Activity" Then
                    PAText = PaText + doc.Name(0) + "|" + doc.CodeNumber(0) +";"
               Elseif doc.Type(0)="Project #" Then
                    PNText = PNText + doc.Name(0) + "|" + doc.CodeNumber(0) +";"
               End If
          End If 
          Set doc=dv.GetNextDocument(doc)
     Wend
     Call uidoc.FieldSetText("CostCentreList", CCText)
     Call uidoc.FieldSetText("GLAcctList", GLText)
     Call uidoc.FieldSetText("PrjNumList", PNText)
     Call uidoc.FieldSetText("ProgActList", PAText)
     Call uidoc.Refresh
End Sub<break/></text></item>
<item name='$$ProjectSelection_1' summary='false' sign='true'><text>'++LotusScript Development Environment:2:5:(Options):0:66

'++LotusScript Development Environment:2:5:(Forward):0:1
Declare Sub Exiting(Source As Field)

'++LotusScript Development Environment:2:5:(Declarations):0:2

'++LotusScript Development Environment:2:2:BindEvents:1:129
Private Sub BindEvents(Byval Objectname_ As String)
     Static Source As FIELD
     Set Source = Bind(Objectname_)
     On Event Exiting From Source Call Exiting
End Sub

'++LotusScript Development Environment:2:2:Exiting:1:12
Sub Exiting(Source As Field)
     Dim ws As New notesuiworkspace
     Dim s As New notessession     
     Dim uidoc As notesuidocument
     
     Dim db As notesdatabase
     Dim dv As notesview
     Dim doc As notesdocument
     
     Dim CategoryFlag As Integer     
     Dim IsOperating As Variant
     Dim IsTravel As Variant
     Dim IsContract As Variant
     Dim IsCapital As Variant
     
     Set db=s.currentdatabase
     Set dv=db.GetView("CCV")
     Set uidoc=ws.currentdocument
     
     IsOperating=False
     IsTravel=False
     IsContract=False
     IsCapital=False
     
     CategoryFlag=Cint(uidoc.FieldGetText("CategoriesAllowed"))
     If CategoryFlag &gt;= 8 Then
          IsOperating=True
          CategoryFlag = CategoryFlag -8            ' Check for "Operating" flag
     End If
     If CategoryFlag  &gt;= 4 Then
          IsTravel=True
          CategoryFlag = CategoryFlag - 4           ' Check for "Travel" flag
     End If
     If CategoryFlag &gt;= 2 Then
          IsContract=True
          CategoryFlag = CategoryFlag -2             ' Check for "Contract" flag
     End If
     If CategoryFlag &gt;= 1 Then
          IsCapital=True
          CategoryFlag = CategoryFlag -1             ' Check for "Capital" flag
     End If
     If CategoryFlag &gt; 0 Then Messagebox("Category Error!")
     
     Dim CCText As String
     Dim GLText As String
     Dim PNText As String
     Dim PAText As String
     
     Set doc=dv.GetFirstDocument()
     While Not (doc Is Nothing) 
          If ((doc.Category(0)="Operating" And IsOperating = True) Or (doc.Category(0) = "Travel" And IsTravel=True) Or (doc.Category(0) = "Contract" And IsContract = True) Or (doc.Category(0)="Capital" And IsCapital=True) Or (doc.Category(0)="")) Then
               If doc.Type(0)="Cost Centre" Then
                    CCText = CCText + doc.Name(0) + "|" + doc.CodeNumber(0) +";"     
               Elseif doc.Type(0)="G/L Account" Then
                    GLText = GLText + doc.Name(0) + "|" + doc.CodeNumber(0) +";"
               Elseif doc.Type(0)="Program Activity" Then
                    PAText = PaText + doc.Name(0) + "|" + doc.CodeNumber(0) +";"
               Elseif doc.Type(0)="Project #" Then
                    PNText = PNText + doc.Name(0) + "|" + doc.CodeNumber(0) +";"
               End If
          End If 
          Set doc=dv.GetNextDocument(doc)
     Wend
     Call uidoc.FieldSetText("CostCentreList", CCText)
     Call uidoc.FieldSetText("GLAcctList", GLText)
     Call uidoc.FieldSetText("PrjNumList", PNText)
     Call uidoc.FieldSetText("ProgActList", PAText)
     Call uidoc.Refresh
End Sub<break/></text></item>
