<trigger type='actionsmenu'/>
<documentset type='selected'/><code event='action'>
<simpleaction action='runformula'><formula>REM{2009-06-29: ADR 3550: JML: This agent was created in July 2009 to flag the Orders with the status OnOrder, Reconciled, and Received as Budget Calculated.  When this operation is completed, the plan is to recalculate the budget for the current FY projects tu update the Commited amounts.};

@If(form = "NewOrderForm"; @SetField("BudgetCalculated"; "Yes"); "");
SELECT @All</formula></simpleaction></code>
