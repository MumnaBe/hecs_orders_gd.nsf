<trigger type='agentlist'/>
<documentset type='selected'/><code event='action'>
<simpleaction action='runformula'><formula>FIELD form := form;

REM{July 2009, ADR 3550: JML.  This agent is called from the restore button in the Soft Delete view. It restore the deleted documents.};

REM{Remove the SoftDelete prefix from the form name};
@SetField("Form"; @ReplaceSubstring(form; "SoftDelete"; ""));

REM{Remvoe the SoftDelete flags};
FIELD SoftDelete := @DeleteField;
FIELD SoftDeleteDate := @DeleteField;
FIELD SoftDeleteBy := @DeleteField;
SELECT @All</formula></simpleaction></code>
