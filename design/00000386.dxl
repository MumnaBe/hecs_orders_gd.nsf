<tablerow>
<tablecell borderwidth='0px 1px 1px'>
<pardef id='174' align='center' leftmargin='1%' rightmargin='99%' keeptogether='true'><code
 event='hidewhen'><formula>(i11PriceTot + i12PriceTot + i13PriceTot + i14PriceTot + i15PriceTot + i16PriceTot + i17PriceTot + i18PriceTot + i19PriceTot + i20PriceTot) = 0</formula></code></pardef>
<par def='174'>Order Reference Number/Numéro de référence:</par>
<par def='174'/>
<par def='174'><run><font style='bold'/><field type='text' kind='computed'
 name='dRefNumber2_1'><code event='defaultvalue'><formula>d_RefNumber</formula></code></field></run></par>
<par def='174'><run><font style='bold'/></run></par>
<par def='174'><run><font size='12pt' style='bold'/>INCLUDE THIS NUMBER ON INVOICE</run></par>
<par def='171'><run><font style='bold'/></run></par>
<par def='93'><run><font size='8pt' style='italic'/></run></par></tablecell>
<tablecell borderwidth='0px 1px 1px'>
<pardef id='175' leftmargin='1%' rightmargin='99%' keepwithnext='true' keeptogether='true'><code
 event='hidewhen'><formula>(i11PriceTot + i12PriceTot + i13PriceTot + i14PriceTot + i15PriceTot + i16PriceTot + i17PriceTot + i18PriceTot + i19PriceTot + i20PriceTot) = 0</formula></code></pardef>
<par def='175'><run><font style='bold'/>Signature and Name of </run><run><font
 style='bold'/><computedtext><code event='value'><formula>@If(PurchaseType="MasterCard" | PurchaseType="VISA";"Card Holder";"Signing Authority")</formula></code></computedtext></run><run
><font style='bold'/>:</run></par>
<par def='172'><run><font style='bold'/>Signature et nom du détenteur de la carte:</run></par>
<par def='172'><run><font style='bold'/></run></par>
<par def='172'><run><font style='bold'/></run></par>
<par def='172'><run><font style='bold underline'/></run></par>
<par def='172'><run><font style='bold underline'/>                                                      </run></par>
<par def='172'><field type='text' allowmultivalues='true' kind='computed'
 name='CardHolder_1' listinputseparators='comma semicolon' listdisplayseparator='semicolon'><code
 event='defaultvalue'><formula>@If(PurchaseType = "Purchase Order"; SignAuth; CardHolder)</formula></code></field> </par>
<par def='172'/>
<par def='172'>Date:<run><font style='underline'/>                                                              </run></par>
<par def='172'><run><font style='underline'/></run></par>
<par def='172'><run><font style='underline'/></run></par>
<par def='172'/></tablecell></tablerow></table>
