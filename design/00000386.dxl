<tablecell borderwidth='0px 1px'>
<pardef id='121' align='center' leftmargin='0.0104in' tabs='L5.8750in L7.8125in'
 keepwithnext='true' keeptogether='true'><code event='hidewhen'><formula>(i12Desc="" &amp; i12Quant=0&amp;i12PricePer=0) &amp; (i13Desc=""&amp;i14Desc=""&amp;i15Desc=""&amp;i16Desc=""&amp;i17Desc=""&amp;i18Desc=""&amp;i19Desc=""&amp;i20Desc="")</formula></code></pardef>
<par def='121'><run><font style='bold'/></run><run><font style='bold'/><field
 type='number' kind='computed' name='i12PricePer'><numberformat format='currency'
 digits='2' punctuated='false' parens='false' percent='false' bytes='false'/><code
 event='defaultvalue'><formula>i12PricePer</formula></code><code event='exiting'><lotusscript
>Sub Exiting(Source As Field)
     Dim ws As New notesuiworkspace
     Dim uidoc As notesuidocument
     Dim doc As notesdocument
     Dim Quantity As Integer
     Dim UnitPrice As Currency
     Dim HideCounter As Integer
     Dim TempPrice As String
     Dim Length As Integer     
     Dim H12 As Integer
     
     Set uidoc=ws.currentdocument
     
     Quantity=Val(uidoc.FieldGetText("i12Quant"))
     TempPrice=Ltrim$(uidoc.FieldGetText("i12PricePer"))
     If (Instr(TempPrice, "$")) Then
          Length = Len(TempPrice) -1    ' To remove the $ sign
     Else
          Length = Len(TempPrice)
     End If     
     
     TempPrice = Right$(TempPrice, Length) 
     UnitPrice=Val(TempPrice)
     HideCounter=Val(uidoc.FieldGetText("HideCount"))
     
     
     If ((Quantity=0) And (UnitPrice=0)) Then
          H12 = 1
          Call uidoc.FieldSetText("i12Desc", "")          
          Call uidoc.FieldSetText("H12", Cstr(H12))
     End If
     
     If ((Quantity &gt; 0 Or UnitPrice&gt;0) And HideCounter &lt; 13) Then
          HideCounter = 13
          Call uidoc.FieldSetText("HideCount", Cstr(HideCounter))
     End If
     
     
     uidoc.Refresh
     uidoc.RefreshHideFormulas    
End Sub</lotusscript></code></field></run><run><font style='bold'/></run></par></tablecell>
