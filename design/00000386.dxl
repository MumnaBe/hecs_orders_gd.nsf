 event='hidewhen'><formula>(i11Desc="" &amp; i11Quant=0&amp;i11PricePer=0) &amp; (i12Desc=""&amp;i13Desc=""&amp;i14Desc=""&amp;i15Desc=""&amp;i16Desc=""&amp;i17Desc=""&amp;i18Desc=""&amp;i19Desc=""&amp;i20Desc="")</formula></code></pardef>
<par def='114'><run><font style='bold'/></run><run><font style='bold'/><field
 type='text' kind='computed' name='i11Desc'><code event='defaultvalue'><formula
>i11Desc</formula></code><code event='exiting'><lotusscript>Sub Exiting(Source As Field)
     
End Sub</lotusscript></code></field></run><run><font style='bold'/></run></par></tablecell>
<tablecell borderwidth='1px 1px 0px'>
<pardef id='115' align='center' leftmargin='3%' rightmargin='97%' keepwithnext='true'
 keeptogether='true'><code event='hidewhen'><formula>(i11Desc="" &amp; i11Quant=0&amp;i11PricePer=0) &amp; (i12Desc=""&amp;i13Desc=""&amp;i14Desc=""&amp;i15Desc=""&amp;i16Desc=""&amp;i17Desc=""&amp;i18Desc=""&amp;i19Desc=""&amp;i20Desc="")</formula></code></pardef>
<par def='115'><run><font style='bold'/></run><run><font style='bold'/><field
 type='number' kind='computed' name='i11Quant'><numberformat format='fixed'
 punctuated='false' parens='false' percent='false' bytes='false'/><code event='defaultvalue'><formula
>i11Quant</formula></code></field></run><run><font style='bold'/></run></par></tablecell>
<tablecell borderwidth='1px 1px 0px'>
<pardef id='116' align='center' leftmargin='0.0104in' tabs='L5.8750in L7.8125in'
 keepwithnext='true' keeptogether='true'><code event='hidewhen'><formula>(i11Desc="" &amp; i11Quant=0&amp;i11PricePer=0) &amp; (i12Desc=""&amp;i13Desc=""&amp;i14Desc=""&amp;i15Desc=""&amp;i16Desc=""&amp;i17Desc=""&amp;i18Desc=""&amp;i19Desc=""&amp;i20Desc="")</formula></code></pardef>
<par def='116'><run><font style='bold'/></run><run><font style='bold'/><field
 type='number' kind='computed' name='i11PricePer'><numberformat format='currency'
 digits='2' punctuated='false' parens='false' percent='false' bytes='false'/><code
 event='defaultvalue'><formula>i11PricePer</formula></code><code event='exiting'><lotusscript
>Sub Exiting(Source As Field)
     Dim ws As New notesuiworkspace
     Dim uidoc As notesuidocument
     Dim doc As notesdocument
     Dim Quantity As Integer
     Dim UnitPrice As Currency
     Dim HideCounter As Integer
     Dim TempPrice As String
     Dim Length As Integer     
     Dim H11 As Integer
     
     Set uidoc=ws.currentdocument
     
     Quantity=Val(uidoc.FieldGetText("i11Quant"))
     TempPrice=Ltrim$(uidoc.FieldGetText("i11PricePer"))
     If (Instr(TempPrice, "$")) Then
          Length = Len(TempPrice) -1    ' To remove the $ sign
     Else
          Length = Len(TempPrice)
     End If     
     
     TempPrice = Right$(TempPrice, Length) 
     UnitPrice=Val(TempPrice)
     HideCounter=Val(uidoc.FieldGetText("HideCount"))
     
     
     If ((Quantity=0) And (UnitPrice=0)) Then
          H11 = 1
          Call uidoc.FieldSetText("i11Desc", "")          
          Call uidoc.FieldSetText("H11", Cstr(H11))
     End If
     
     If ((Quantity &gt; 0 Or UnitPrice&gt;0) And HideCounter &lt; 12) Then
          HideCounter = 12
          Call uidoc.FieldSetText("HideCount", Cstr(HideCounter))
     End If
     
     
     uidoc.Refresh
     uidoc.RefreshHideFormulas     
End Sub</lotusscript></code></field></run><run><font style='bold'/></run></par></tablecell>
<tablecell borderwidth='1px 1px 0px'>
<pardef id='117' align='center' leftmargin='2%' rightmargin='98%' keepwithnext='true'
 keeptogether='true'><code event='hidewhen'><formula>(i11Desc="" &amp; i11Quant=0&amp;i11PricePer=0) &amp; (i12Desc=""&amp;i13Desc=""&amp;i14Desc=""&amp;i15Desc=""&amp;i16Desc=""&amp;i17Desc=""&amp;i18Desc=""&amp;i19Desc=""&amp;i20Desc="")</formula></code></pardef>
<par def='117'><run><font style='bold'/></run><run><font style='bold'/><field
 type='number' kind='computed' name='i11PriceTot'><numberformat format='currency'
 digits='2' punctuated='false' parens='false' percent='false' bytes='false'/><code
 event='defaultvalue'><formula>i11Quant * i11PricePer</formula></code></field></run><run
><font style='bold'/></run></par></tablecell></tablerow>
<tablerow>
