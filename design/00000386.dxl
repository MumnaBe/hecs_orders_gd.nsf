<tablecell borderwidth='1px 1px 0px 0px'>
<pardef id='30' leftmargin='1%' rightmargin='99%' keepwithnext='true' keeptogether='true'><code
 event='hidewhen'><formula>(i1Desc="" &amp; i1Quant=0&amp;i1PricePer=0)</formula></code></pardef>
<par def='30'><run><font style='bold'/></run><run><font style='bold'/><field
