<trigger type='agentlist'/>
<documentset type='all'><search type='byformnames'><formchoice name='Company'/></search></documentset><code
 event='options'><lotusscript>Option Public

</lotusscript></code><code event='initialize'><lotusscript>Sub Initialize
	Dim s As New notessession
	Dim db As notesdatabase
	Dim dc As notesdocumentcollection
	Dim doc As notesdocument
	
	Set db = s.currentdatabase
	Set dc=db.UnprocessedDocuments
	Set doc=dc.GetFirstDocument
	
	While Not (doc Is Nothing)
		If Ucase(doc.CompCountry(0))="CANADA" Then
			doc.CompCurrency="CAD"
		Elseif Ucase(doc.CompCountry(0))="USA" Or Ucase(doc.CompCountry(0))="U.S.A." Or Ucase(doc.CompCountry(0))="UNITED STATES" Or Ucase(doc.CompCountry(0))="US" Or Ucase(doc.CompCountry(0))="U.S." Then
			doc.CompCurrency="USD"
		Else
			doc.CompCurrency=Inputbox("Enter the currency indicator for " &amp; doc.CompCountry(0))
		End If
		doc.Save True, True
		Set doc=dc.GetNextDocument(doc)
	Wend
	Messagebox "Currency Update complete."
End Sub</lotusscript></code>
