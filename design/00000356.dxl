<action title='Copy Existing Order' icon='28'><code event='click'><lotusscript
>Sub Click(Source As Button)
	
	On Error Goto handler
	
	Dim ws As New notesuiworkspace
	Dim s As New notessession
	Dim db As notesdatabase
	Dim dc As notesdocumentcollection
	Dim doc As notesdocument
	Dim newdoc As notesdocument
	Dim uidoc As notesuidocument
	Dim descitem As notesitem
	
	Set db=s.currentdatabase
	Set dc=db.UnprocessedDocuments
	Set doc=dc.GetFirstDocument
	If doc Is Nothing Or dc.Count &gt; 1 Then
		Messagebox "Please ensure that you have one (and only one) document selected."
		Set doc = Nothing
		Goto handler
	End If
	
	Set uidoc=ws.ComposeDocument(db.Server, db.FilePath, "New Order Form")
	Set newdoc=uidoc.Document
	
	'Call uidoc.FieldSetText("CompleteFinancialCode", doc.CompleteFinancialCode(0))
	newdoc.CompleteFinancialCode= doc.CompleteFinancialCode
	'Call uidoc.FieldSetText("Category", doc.Category(0))
	newdoc.Category= doc.Category
	'Call uidoc.FieldSetText("HideCount", Cstr(doc.HideCount(0)))
	newdoc.HideCount= doc.HideCount
	'Call uidoc.FieldSetText("ProjectSelection", Cstr(doc.ProjectSelection(0)))
	newdoc.ProjectSelection= doc.ProjectSelection
	'Call uidoc.FieldSetText("FinCategory", Cstr(doc.FinCategory(0)))
	newdoc.FinCategory= doc.FinCategory
	'Call uidoc.FieldSetText("FinCode", Cstr(doc.FinCode(0)))
	'not reassigning the same Financial Code - user must generate new one
	'Call uidoc.FieldSetText("PurchaseType", Cstr(doc.PurchaseType(0)))
	newdoc.PurchaseType= doc.PurchaseType
	'Call uidoc.FieldSetText("CardHolder", Cstr(doc.CardHolder(0)))
	newdoc.CardHolder= doc.CardHolder
	'Call uidoc.FieldSetText("SignAuth", Cstr(doc.SignAuth(0)))
	newdoc.SignAuth= doc.SignAuth
	
	'EMPLOYEE INFORMATION
	'Call uidoc.FieldSetText("ShipTo", Cstr(doc.ShipTo(0)))
	newdoc.ShipTo= doc.ShipTo
	'Call uidoc.FieldSetText("Locator", Cstr(doc.Locator(0)))
	newdoc.Locator= doc.Locator
	'Call uidoc.FieldSetText("Building", Cstr(doc.Building(0)))
	newdoc.Building= doc.Building
	newdoc.Building2= doc.Building2
	'Call uidoc.FieldSetText("City", Cstr(doc.City(0)))
	newdoc.City= doc.City
	'Call uidoc.FieldSetText("Province", Cstr(doc.Province(0)))
	newdoc.Province= doc.Province
	'Call uidoc.FieldSetText("PostCode", Cstr(doc.PostCode(0)))
	newdoc.PostCode= doc.PostCode
	'Call uidoc.FieldSetText("PhoneNumber", Cstr(doc.PhoneNumber(0)))
	newdoc.PhoneNumber= doc.PhoneNumber
	'Call uidoc.FieldSetText("FaxNumber", Cstr(doc.FaxNumber(0)))
	newdoc.FaxNumber= doc.FaxNumber
	'Call uidoc.FieldSetText("InvName", Cstr(doc.InvName(0)))
	newdoc.InvName= doc.InvName
	'Call uidoc.FieldSetText("InvPL", Cstr(doc.InvPL(0)))
	newdoc.InvPL= doc.InvPL
	'Call uidoc.FieldSetText("InvBuilding", Cstr(doc.InvBuilding(0)))
	newdoc.InvBuilding= doc.InvBuilding
	'Call uidoc.FieldSetText("InvCity", Cstr(doc.InvCity(0)))
	newdoc.InvCity= doc.InvCity
	'Call uidoc.FieldSetText("InvProvince", Cstr(doc.InvProvince(0))) 
	newdoc.InvProvince= doc.InvProvince
	'Call uidoc.FieldSetText("InvPostCode", Cstr(doc.InvPostCode(0)))
	newdoc.InvPostCode= doc.InvPostCode
	'Call uidoc.FieldSetText("InvTel", Cstr(doc.InvTel(0)))
	newdoc.InvTel= doc.InvTel
	'Call uidoc.FieldSetText("InvFax", Cstr(doc.InvFax(0)))
	newdoc.InvFax= doc.InvFax
	
	'COMPANY INFORMATION
	'Call uidoc.FieldSetText("CompanyName", Cstr(doc.CompanyName(0)))
	newdoc.CompanyName= doc.CompanyName
	'Call uidoc.FieldSetText("AcctNumber", Cstr(doc.AcctNumber(0)))
	newdoc.AcctNumber= doc.AcctNumber
	'Call uidoc.FieldSetText("CompPhone", Cstr(doc.CompPhone(0)))
	newdoc.CompPhone= doc.CompPhone
	'Call uidoc.FieldSetText("CompFax", Cstr(doc.CompFax(0)))
	newdoc.CompFax= doc.CompFax
	
	' table fields added by Levi
	' Call uidoc.FieldSetText("ItemNoL", doc.ItemNoL(0))
	newdoc.ItemNoL= doc.ItemNoL
	' Call uidoc.FieldSetText("DescriptionL", doc.DescriptionL(0))
	newdoc.DescriptionL= doc.DescriptionL
	' Call uidoc.FieldSetText("QuantityL", Cstr(doc.QuantityL(0)))
	newdoc.QuantityL= doc.QuantityL
	' Call uidoc.FieldSetText("PriceL", Cstr(doc.PriceL(0)))
	newdoc.PriceL= doc.PriceL
	' Call uidoc.FieldSetText("TotalPriceL", Cstr(doc.TotalPriceL(0)))
	newdoc.TotalPriceL= doc.TotalPriceL
	' Call uidoc.FieldSetText("aReceivedL", Cstr(doc.aReceivedL(0)))
	newdoc.aReceivedL= doc.aReceivedL
	' Call uidoc.FieldSetText("ReceivedL", doc.ReceivedL(0))
	newdoc.ReceivedL= doc.ReceivedL
	Call uidoc.Refresh
	' end of Levi
	
%REM
     ' Loop through the fields H1 to H20 and set the values
	For x = 1 To 20
		Set descitem = doc.GetFirstItem("H" + Cstr(x))
		Call uidoc.FieldSetText("H" + Cstr(x),Cstr(descitem.Values(0)))     
	Next
	
     ' Loop through the fields I1Desc to I20Desc and set the values
	For x = 1 To 20
		Set descitem = doc.GetFirstItem("i" + Cstr(x) + "desc")
		Call uidoc.FieldSetText("i" + Cstr(x) +"desc",Cstr(descitem.Values(0)))    
	Next
	
	For x = 1 To 20
		Set descitem = doc.GetFirstItem("i" + Cstr(x) + "Quant")
		Call uidoc.FieldSetText("i" + Cstr(x) +"Quant",Cstr(descitem.Values(0)))    
	Next
	
	For x = 1 To 20
		Set descitem = doc.GetFirstItem("i" + Cstr(x) + "PricePer")
		Call uidoc.FieldSetText("i" + Cstr(x) +"PricePer",Cstr(descitem.Values(0)))    
	Next     
%END REM	
	
handler:
	
End Sub</lotusscript></code></action></actionbar>
