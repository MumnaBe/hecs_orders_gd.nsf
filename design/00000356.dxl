<wassignedby><name>CN=HC-R_AGENT-SC/OU=HC-SC/O=GC/C=CA</name></wassignedby><code
 event='selection'><formula>a := @Year(IssueDate);
b := @Text(@Month(IssueDate));
FYStart := @Text(@If(b="1"|b="2"|b="3";a - 1;a));
x := @Year(@Today);
y := @Text(@Month(@Today));
CurrFYStart :=@Text(@If(y="1"|y="2"|y="3";x - 1;x));
SELECT ((Form = "Order Form") | (Form = "OrderForm") | (Form = "New Order Form") | (Form = "NewOrderForm")) &amp; CurrFYStart=FYStart</formula></code>
