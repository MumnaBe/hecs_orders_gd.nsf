<!DOCTYPE agent>
<agent name='(CalculateBudgetForOrder)' xmlns='http://www.lotus.com/dxl' version='12.0'
 maintenanceversion='2.0' replicaid='85258E750045D0DA' hide='v3' publicaccess='false'
