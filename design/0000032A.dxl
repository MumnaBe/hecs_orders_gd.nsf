 type='keyword' kind='editable' name='VISA_EN'><keywords columns='1' ui='dialoglist'><textlist
><text>Yes</text><text>No</text><text>N/A</text></textlist></keywords><code
 event='defaultvalue'><formula>@If(VISA_EN = ""; VISA; VISA_EN)</formula></code><code
 event='inputtranslation'><formula>REM{2009-07-02: ADR 3550: JML: this code was added to allow users to select the values either in English or French.  A Dialog List was not used because we do not want values to be typed manually.  A radio button was not used because it does not handle the alias for the values: i.e. Oui|Yes.  Right now the system handle both English and French values as well as using only English values for the MasterCard and VISA fields.};

@If(
  @Environment("HECS_Language")="F";
  @If(
    VISA_FR = "Oui"; @Do(@SetField("VISA_EN"; "Yes"); @SetField("VISA"; "Yes"));
    VISA_FR = "Non"; @Do(@SetField("VISA_EN"; "No"); @SetField("VISA"; "No"));
    VISA_FR = "N/D"; @Do(@SetField("VISA_EN"; "N/A"); @SetField("VISA"; "N/A")); "");
  @If(
    VISA_EN = "Yes"; @Do(@SetField("VISA_FR"; "Oui"); @SetField("VISA"; "Yes"));
    VISA_EN = "No"; @Do(@SetField("VISA_FR"; "Non"); @SetField("VISA"; "No"));
    VISA_EN = "N/A"; @Do(@SetField("VISA_FR"; "N/D"); @SetField("VISA"; "N/A")); ""));

VISA_EN</formula></code></field></par>
<par def='10'><field lookupeachchar='false' lookupaddressonrefresh='false'
 type='keyword' kind='editable' name='VISA_FR'><keywords columns='1' ui='dialoglist'><textlist
><text>Oui</text><text>Non</text><text>N/D</text></textlist></keywords><code
 event='defaultvalue'><formula>@If(VISA_FR = ""; VISA; VISA_FR)</formula></code></field></par>
