<tablecell borderwidth='0px'>
<pardef id='9' leftmargin='1%' rightmargin='99%' keepwithnext='true' keeptogether='true'><code
 event='hidewhen'><formula>@Environment("HECS_Language")="F"</formula></code></pardef>
<par def='9'><field lookupeachchar='false' lookupaddressonrefresh='false'
 type='keyword' kind='editable' name='MasterCard_EN'><keywords columns='1'
 ui='dialoglist'><textlist><text>Yes</text><text>No</text><text>N/A</text></textlist></keywords><code
 event='defaultvalue'><formula>@If(MasterCard_EN = ""; MasterCard; MasterCard_EN)</formula></code><code
 event='inputtranslation'><formula>REM{2009-07-02: ADR 3550: JML: this code was added to allow users to select the values either in English or French.  A Dialog List was not used because we do not want values to be typed manually.  A radio button was not used because it does not handle the alias for the values: i.e. Oui|Yes.  Right now the system handle both English and French values as well as using only English values for the MasterCard and VISA fields.};

@If(
  @Environment("HECS_Language")="F";
  @If(
    MasterCard_FR = "Oui"; @Do(@SetField("MasterCard_EN"; "Yes"); @SetField("MasterCard"; "Yes"));
    MasterCard_FR = "Non"; @Do(@SetField("MasterCard_EN"; "No"); @SetField("MasterCard"; "No"));
    MasterCard_FR = "N/D"; @Do(@SetField("MasterCard_EN"; "N/A"); @SetField("MasterCard"; "N/A")); "");
  @If(
    MasterCard_EN = "Yes"; @Do(@SetField("MasterCard_FR"; "Oui"); @SetField("MasterCard"; "Yes"));
    MasterCard_EN = "No"; @Do(@SetField("MasterCard_FR"; "Non"); @SetField("MasterCard"; "No"));
    MasterCard_EN = "N/A"; @Do(@SetField("MasterCard_FR"; "N/D"); @SetField("MasterCard"; "N/A")); ""));

MasterCard_EN</formula></code></field></par>
<pardef id='10' leftmargin='1%' rightmargin='99%' keepwithnext='true' keeptogether='true'><code
 event='hidewhen'><formula>@Environment("HECS_Language")="E"</formula></code></pardef>
<par def='10'><field lookupeachchar='false' lookupaddressonrefresh='false'
 type='keyword' kind='editable' name='MasterCard_FR'><keywords columns='1'
 ui='dialoglist'><textlist><text>Oui</text><text>Non</text><text>N/D</text></textlist></keywords><code
 event='defaultvalue'><formula>@If(MasterCard_FR = ""; MasterCard; MasterCard_FR)</formula></code></field></par>
<pardef id='11' leftmargin='1%' rightmargin='99%' keepwithnext='true' keeptogether='true'><code
 event='hidewhen'><formula>1</formula></code></pardef>
<par def='11'><field type='text' kind='computed' name='MasterCard'><code event='defaultvalue'><formula
>MasterCard</formula></code></field></par></tablecell></tablerow>
<tablerow>
