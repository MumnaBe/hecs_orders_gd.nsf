<tablecell borderwidth='0px'>
<pardef id='13' keepwithnext='true' keeptogether='true'><code event='hidewhen'><formula
>REM{2009-07-02: JML:ADR 3550: this field was replaced by another field that uses keywords to generate the choices.  Thsi wil prevent date quality issues experienced in the past with different keywords meaning the same thing.}; 1</formula></code></pardef>
<par def='13'><field type='text' kind='editable' name='CompCurrency_old'><code
 event='inputvalidation'><formula>REM{2009-07-02: ADR 3550: JML: this validation no longer apply};
REM{@If(@Length(CompCurrency)!=3;@Failure("The Currency must be a 3 letter code.");@Success)};
@Success</formula></code></field></par>
<pardef id='14' keepwithnext='true' keeptogether='true'><code event='hidewhen'
 enabled='false'><formula>(H1 = 1)</formula></code></pardef>
<par def='14'><field lookupeachchar='false' lookupaddressonrefresh='false'
 type='keyword' kind='editable' name='CompCurrency'><keywords columns='1'
 ui='dialoglist'><formula>REM{This field was created in 2009-07-02, ADR 3550 by JML to resolve problem of inconsistent crrency values used in the application.  Now choices are based on keywords};

kwEng := @DbLookup("":"NoCache"; "":""; "KeywordLookup"; "Currency"; 2);
kwFre := @DbLookup("":"NoCache"; "":""; "KeywordLookup"; "Currency"; 3);

@If(@IsError(kwEng) | @IsError(kwFre); "Error, please contact the administrator / Erreur, veuillez contacter l'administrateur"; kwEng)</formula></keywords></field></par></tablecell>
