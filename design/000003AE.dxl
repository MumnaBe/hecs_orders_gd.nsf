<trigger type='actionsmenu'/>
<documentset type='selected'/><code event='action'>
<simpleaction action='runformula'><formula>REM{2009-06-29: ADR 3550: JML: This agent was created in July 2009 to set the values of the fields: MasterCard, MasterCard_EN and MasterCard_FR on the Company documents.  In July 2009, the values for the field MasterCard were entered manually and are inconsistent.  This cause the application to not work properly when the users import company information on an order.};

@If(
  form = "Company";
    @Do(
      @SetField("MasterCard"; "N/A");
      @SetField("MasterCard_EN"; "N/A");
      @SetField("MasterCard_FR"; "N/D"));
  "");

SELECT @All</formula></simpleaction></code>
