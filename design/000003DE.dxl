<!DOCTYPE agent>
<agent name='Tool\Old Order\ConvertToNewOrderForm' xmlns='http://www.lotus.com/dxl'
 version='12.0' maintenanceversion='2.0' replicaid='85258E750045D0DA' hide='v3'
 publicaccess='false' designerversion='6.5' comment='July 2009 - ADR 3550'>
