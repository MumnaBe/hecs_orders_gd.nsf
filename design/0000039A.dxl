<par def='30'><run><font size='8pt' style='bold underline' name='Arial' pitch='variable'
 truetype='true' familyid='20' color='navy'/></run><run><font size='8pt' color='navy'
 name='Arial' pitch='variable' truetype='true' familyid='20'/><field type='text'
 allowmultivalues='true' kind='computed' name='edit_history' listinputseparators='comma semicolon newline'
 listdisplayseparator='newline'><code event='defaultvalue'><formula>Name := @Left(Names;";");

@If(
  !@IsNewDoc &amp; @IsDocBeingSaved &amp; Name != @Name([CN]; @UserName)|Name=@Name([CN];@UserName) &amp; @IsDocBeingSaved &amp; !@IsNewDoc;
  @Subset(@Trim(((@Name([CN]; @UserName)): edit_history)); 10);
  @IsNewDoc; "";
  edit_history)</formula></code></field></run><run><font size='8pt' style='underline'
 name='Arial' pitch='variable' truetype='true' familyid='20' color='navy'/></run></par></tablecell>
<tablecell borderwidth='1px 1px 1px 0px'>
<par def='19'><run><font size='8pt' style='bold underline' name='Arial' pitch='variable'
 truetype='true' familyid='20' color='navy'/></run><run><font size='8pt' color='navy'
 name='Arial' pitch='variable' truetype='true' familyid='20'/><field type='text'
 allowmultivalues='true' kind='computed' name='edit_history_1' listinputseparators='comma semicolon newline'
 listdisplayseparator='newline'><code event='defaultvalue'><formula>Name := @Left(Names;";");
@If(!@IsNewDoc &amp; @IsDocBeingSaved &amp; Name != @Name([CN]; @UserName)|Name=@Name([CN];@UserName) &amp; @IsDocBeingSaved &amp; !@IsNewDoc; @Subset(@Trim((@Text(@Now) : edit_history_1));10); @IsNewDoc; ""; edit_history_1)</formula></code></field></run><run
><font size='8pt' style='underline' name='Arial' pitch='variable' truetype='true'
 familyid='20' color='navy'/></run></par></tablecell>
<tablecell borderwidth='1px 1px 1px 0px'>
<par def='14'><run><font size='8pt' color='navy' name='Arial' pitch='variable'
 truetype='true' familyid='20'/><field type='number' allowmultivalues='true'
 kind='computed' name='Cost_history' listinputseparators='comma semicolon newline'
 listdisplayseparator='newline'><numberformat format='currency' digits='2'
 punctuated='false' parens='false' percent='false' bytes='false'/><code event='defaultvalue'><formula
>Name := @Left(Names;";");
@If(!@IsNewDoc &amp; @IsDocBeingSaved &amp; Name != @Name([CN]; @UserName)|Name=@Name([CN];@UserName) &amp; @IsDocBeingSaved &amp; !@IsNewDoc; @Subset(@Trim(@Text(TotCostTaxed) : Cost_history);10); @IsNewDoc; ""; Cost_history)</formula></code></field></run></par></tablecell>
<tablecell borderwidth='1px 1px 1px 0px'>
<par def='15'><run><font size='8pt' color='navy' name='Arial' pitch='variable'
 truetype='true' familyid='20'/><field type='text' allowmultivalues='true'
 kind='computed' name='Status_history' listinputseparators='comma semicolon newline'
 listdisplayseparator='newline'><code event='defaultvalue'><formula>Name := @Left(Names;";");
@If(!@IsNewDoc &amp; @IsDocBeingSaved &amp; Name != @Name([CN]; @UserName)|Name=@Name([CN];@UserName) &amp; @IsDocBeingSaved &amp; !@IsNewDoc; @Subset(@Trim(Status : Status_history);10); @IsNewDoc; ""; Status_history)</formula></code></field></run><run
><font style='bold' color='navy'/></run></par></tablecell></tablerow></table>
