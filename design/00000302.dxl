<action title='Generate Financial Code' icon='109' hide='preview read'><code
 event='click'><lotusscript>Sub Click(Source As Button)
	Dim ws As New notesuiworkspace
	Dim uidoc As notesuidocument
	Dim doc As notesdocument
	Dim boolResult As Variant
	Dim testnum As Integer
	
	Set uidoc=ws.CurrentDocument
	Set doc=uidoc.Document
	testnum=0
	boolResult=ws.DialogBox("CCForm", True, True, False, False, False, False, "Financial Codes")
	While testnum = 0
'		If boolResult = True And (uidoc.FieldGetText("PAC")="0000" Or uidoc.FieldGetText("PC")="0000" Or uidoc.FieldGetText("GLAC")="0000" Or uidoc.FieldGetText("FSC")="0000") Then
		If boolResult = True And (doc.PAC(0)="0000" Or doc.PC(0)="0000" Or doc.GLAC(0)="0000" Or doc.FSC(0)="0000") Then		
			Messagebox "Incorrect Financial Code"
			boolResult=ws.DialogBox("CCForm", True, True, False, False, False, False, "Financial Codes")
		Elseif boolResult = False Then		
			testnum=1
		Else
			testnum=2
		End If
	Wend
	If testnum=2 Then 
		Call uidoc.FieldSetText("FinCode", uidoc.FieldGetText("CompleteFinancialCode"))
		Call uidoc.FieldSetText("FinCategory", uidoc.FieldGetText("Category"))
		If Not ( uidoc.FieldGetText("ProjectSelection") = uidoc.FieldGetText("LastProjectSelected")) Then
			Call uidoc.FieldSetText("LastProjectSelected", uidoc.FieldGetText("ProjectSelection"))
		End If
	End If
	
End Sub</lotusscript></code><code event='hidewhen'><formula>@Environment("HECS_Language") = "F"|ProjectSelection="--Please select a project--"</formula></code></action>
<action title='Générer Code Financier' icon='109' hide='preview read'><code
 event='click'><lotusscript>Sub Click(Source As Button)
