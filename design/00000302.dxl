<action title='Print' icon='98' showinmenu='false'><code event='click'><lotusscript
>Sub Click(Source As Button)
	
	Dim ws As New notesuiworkspace
	Dim uidoc As notesuidocument
	Dim uidoc2 As notesuidocument
	Dim doc As notesdocument
	Dim number As String
	Dim number2 As String
	Dim expdate As String
	Dim role As Variant
	Dim purchasetype As String
	
	Set uidoc=ws.currentdocument
	Set doc = uidoc.document
	
	If uidoc.isNewDoc Then
		uidoc.Save
	End If
	
	role = Evaluate("@IsMember('[Admin]';@UserRoles)")
	If role(0) = 1 Then   ' this user has the [Admin] role
		purchasetype = doc.PurchaseType(0)
		
		If Not (purchasetype = "Purchase Order") Then
			number = Inputbox$("Please enter the full " &amp; purchasetype &amp; " number (16 numbers, no spaces): ")
			While Not (number Like "################" Or number = "")
				number = Inputbox$("Please enter the full " &amp; purchasetype &amp; " number (16 numbers, no spaces): ")
			Wend
			If Not (number = "") Then
				number2 = Left(number,4) +" " + Left(Right(number,12),4) +" " + Left(Right(number, 8),4) + " " + Right(number,4)
				expdate = Inputbox$ ("Please enter the expiry date of the card (mm/yyyy): ")
			End If
			While Not (expdate Like "##/####" Or expdate = "")
				expdate = Inputbox$ ("Please enter the expiry date in the format mm/yyyy: ")
			Wend
			
			doc.ExpiryDate = expdate
			
		Else
			
			number2 = Inputbox$ ("Please enter the " &amp; purchasetype &amp; " number: ")
			
		End If          
		doc.CardNumber = number2   
		Call doc.Save( True, False )
	End If     
	
	Set uidoc2 = ws.ComposeDocument ( "", "", "Print Order Form" )
	Call uidoc2.Print
	
	If role(0) = 1 Then
		doc.Printed = "Yes"
	End If
	
	If Not (purchasetype = "Purchase Order") Then
		doc.CardNumber = ""
	End If
	doc.ExpiryDate = ""
	Call doc.Save( True, False )          
	
End Sub</lotusscript></code><code event='hidewhen'><formula>@Environment("HECS_Language") = "F" | RefNumber=""</formula></code></action>
<action title='Imprimer' icon='98' showinmenu='false'><code event='click'><lotusscript
>Sub Click(Source As Button)
	Dim ws As New notesuiworkspace
	Dim uidoc As notesuidocument
	Dim uidoc2 As notesuidocument
	Dim doc As notesdocument
	Dim number As String
	Dim number2 As String
	Dim expdate As String
	Dim role As Variant
	Dim purchasetype As String
	
	Set uidoc=ws.currentdocument
	Set doc = uidoc.document
	
	If uidoc.isNewDoc Then
		uidoc.Save
	End If
	
	role = Evaluate("@IsMember('[Admin]';@UserRoles)")
	If role(0) = 1 Then   ' this user has the [Admin] role
		purchasetype = doc.PurchaseType(0)
		
		If Not (purchasetype = "Purchase Order") Then
			number = Inputbox$("S.V.P  entrez le numéro de la carte au complet (16 numéros, sans espaces): ")
			While Not (number Like "################" Or number = "")
				number = Inputbox$("S.V.P  entrez le numéro de la carte au complet (16 numéros, sans espaces): ")
			Wend
			If Not (number = "") Then
				number2 = Left(number,4) + " " +  Left(Right(number,12),4) +" " + Left(Right(number, 8),4) +" " + Right(number,4)
				expdate = Inputbox$ ("Date d'expiration de la carte d'aquisition (mm/aaaa): ")
			End If
			While Not (expdate Like "##/####" Or expdate = "")
				expdate = Inputbox$ ("Date d'expiration de la carte d'aquisition (mm/aaaa): ")
			Wend
			doc.ExpiryDate = expdate
		Else
			number = Inputbox$ ("S.V.P. entez le numéro du bon de commande: ")
		End If          
		
		doc.CardNumber = number2          
		Call doc.Save( True, False )
	End If     
	
	Set uidoc2 = ws.ComposeDocument ( "", "", "Print Order Form" )
	Call uidoc2.Print
	
	If role(0) = 1 Then
		doc.Printed = "Yes"
	End If
	
	If Not (purchasetype = "Purchase Order") Then
		doc.CardNumber = ""
	End If
	doc.ExpiryDate = ""
	Call doc.Save( True, False )          
	
End Sub</lotusscript></code><code event='hidewhen'><formula>@Environment("HECS_Language") = "E"|RefNumber=""</formula></code></action>
<action title='Reconciled' icon='127' showinmenu='false'><code event='click'><formula
>@Command( [EditDocument]; "1" );
FIELD SaveOptions := SaveOptions;
FIELD Status := Status;
@SetField("SaveOptions"; "1");
@SetField("Status"; "Reconciled");
@PostedCommand([FileSave]);
@Prompt([Ok];"Confirmation";"The Status of the order has been changed to Reconciled")</formula></code><code
 event='hidewhen'><formula>@Environment("HECS_Language") = "F" |
(!@Contains(@UserRoles;"[Admin]"))| @IsNewDoc</formula></code></action>
<action title='Réconcilié' icon='127' showinmenu='false'><code event='click'><formula
>@Command( [EditDocument]; "1" );
FIELD SaveOptions := SaveOptions;
FIELD Status := Status;
@SetField("SaveOptions"; "1");
@SetField("Status"; "Reconciled");
@PostedCommand([FileSave]);
@Prompt([Ok];"Confirmation";"Le cheminement de la commande est changé à Réconcilié")</formula></code><code
 event='hidewhen'><formula>@Environment("HECS_Language") = "E" |
(!@Contains(@UserRoles;"[Admin]"))| @IsNewDoc</formula></code></action>
