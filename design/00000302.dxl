<pardef id='6' leftmargin='1%' rightmargin='99%' keepwithnext='true' keeptogether='true'/>
<par def='6'><field lookupeachchar='false' lookupaddressonrefresh='false'
 type='keyword' kind='editable' name='ProjectSelection'><keywords recalconchange='true'
 recalcchoices='true' columns='1' ui='dialoglist'><formula>ProjectSelection1</formula></keywords><code
 event='defaultvalue'><formula>"--Please select a project--"</formula></code><code
 event='entering'><lotusscript>Sub Entering(Source As Field)
     
End Sub
</lotusscript></code><code event='exiting'><lotusscript>Sub Exiting(Source As Field)
     Dim ws As New notesuiworkspace
     Dim uidoc As notesuidocument
     Set uidoc=ws.currentdocument
     Dim s As New notessession
     Dim db As notesdatabase
     Dim dv As notesview
     Dim projdoc As notesdocument
     Dim mykeys As String
     If Not(uidoc.FieldGetText("ProjectSelection") = "--Please select a project--") Then
          mykeys=uidoc.FieldGetText("ProjectSelection")
          
          Set db=s.CurrentDatabase
          Set dv=db.GetView("PLV")
          Set projdoc=dv.GetDocumentByKey(mykeys)
          Call uidoc.FieldSetText("PI", projdoc.PI(0))
          Call uidoc.FieldSetText("SectionHead", projdoc.Manager(0))    
     End If
     
End Sub
</lotusscript></code><code event='initialize'><lotusscript>Sub Initialize
     
End Sub</lotusscript></code></field><run><font style='bold'/></run></par></tablecell>
