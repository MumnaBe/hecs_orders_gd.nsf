<action title='Send &amp; Close' icon='1' hide='preview read'><code event='click'><lotusscript
>Sub Click(Source As Button)
	
	Dim ws As New notesuiworkspace
	Dim s As New notessession
	Dim db As notesdatabase
	Dim uidoc As notesuidocument
	Dim doc As notesdocument
	Dim docMemo As notesdocument
	
	
	Set uidoc=ws.CurrentDocument
	Set doc=uidoc.document
	Call uidoc.Save
	Set db=s.currentdatabase
	Set docMemo=db.CreateDocument
	Dim bodytxt As New notesrichtextitem (docMemo, "Body")
	
	docMemo.SendTo=uidoc.FieldGetText("SendTo")
	docMemo.Subject="HECS Orders feedback"
	bodytxt.AppendText("New feedback has been received.  Please follow the document link below to view the feedback.")
	bodytxt.AddNewLine 2
	bodytxt.AppendText("--&gt;")
	bodytxt.AppendDocLink doc, "HECS Orders feedback"
	docMemo.Send False
	uidoc.Close
	
End Sub</lotusscript></code><code event='hidewhen'><formula>@Environment("HECS_Language") = "F"</formula></code></action>
<action title='Envoyer et fermer' icon='1' hide='preview read'><code event='click'><lotusscript
>Sub Click(Source As Button)
	
	Dim ws As New notesuiworkspace
	Dim s As New notessession
	Dim db As notesdatabase
	Dim uidoc As notesuidocument
	Dim doc As notesdocument
	Dim docMemo As notesdocument
	
	
	Set uidoc=ws.CurrentDocument
	Set doc=uidoc.document
	Call uidoc.Save
	Set db=s.currentdatabase
	Set docMemo=db.CreateDocument
	Dim bodytxt As New notesrichtextitem (docMemo, "Body")
	
	docMemo.SendTo=uidoc.FieldGetText("SendTo")
	docMemo.Subject="HECS Orders feedback"
	bodytxt.AppendText("New feedback has been received.  Please follow the document link below to view the feedback.")
	bodytxt.AddNewLine 2
	bodytxt.AppendText("--&gt;")
	bodytxt.AppendDocLink doc, "HECS Orders feedback"
	docMemo.Send False
	uidoc.Close
	
End Sub</lotusscript></code><code event='hidewhen'><formula>@Environment("HECS_Language") != "F"</formula></code></action>
