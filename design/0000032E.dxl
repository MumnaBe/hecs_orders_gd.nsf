<action title='Print' icon='98' showinmenu='false'><code event='click'><formula
>FIELD CardNumber := CardNumber;
FIELD ExpiryDate := ExpiryDate;
FIELD Printed := Printed;
number := @Prompt([OkCancelEdit]; "Card Number"; "Please enter the card number:"; "");
date := @Prompt([OkCancelEdit]; "Expiry Date"; "Please enter the expiry date:"; "");
@SetField("CardNumber";number);
@SetField("ExpiryDate";date);
@Command([FilePrint]);
@SetField("CardNumber";"");
@SetField("ExpiryDate";"");
@SetField("Printed";"Yes")</formula></code><code event='hidewhen'><formula
>(!@Contains(@UserRoles;"[Admin]")) |
(@Environment("HECS_Language") = "F")</formula></code></action>
<action title='Imprimer' icon='98' showinmenu='false'><code event='click'><formula
>FIELD CardNumber := CardNumber;
FIELD ExpiryDate := ExpiryDate;
FIELD Printed := Printed;
number := @Prompt([OkCancelEdit]; "Card Number"; "Please enter the card number:"; "");
date := @Prompt([OkCancelEdit]; "Expiry Date"; "Please enter the expiry date:"; "");
@SetField("CardNumber";number);
@SetField("ExpiryDate";date);
@Command([FilePrint]);
@SetField("CardNumber";"");
@SetField("ExpiryDate";"");
@SetField("Printed";"Yes")</formula></code><code event='hidewhen'><formula
>(!@Contains(@UserRoles;"[Admin]")) |
(@Environment("HECS_Language") = "E")</formula></code></action>
