<action title='Restore Item' icon='123' showinmenu='false' hide='preview read'><code
 event='click'><lotusscript>Sub Click(Source As Button)
     Dim ws As New notesuiworkspace
     Dim uidoc As notesuidocument
     Dim choice As Integer
     
     Set uidoc=ws.currentdocument
     
     choice% = Cint(Inputbox$("Which item number would you like to restore?"))
     
     Select Case choice
     Case 1
          H1 = 0
          Call uidoc.FieldSetText("H1", Cstr(H1))
     Case 2
          H2 = 0
          Call uidoc.FieldSetText("H2", Cstr(H2))
     Case 3
          H3 = 0
          Call uidoc.FieldSetText("H3", Cstr(H3))
     Case 4
          H4 = 0
          Call uidoc.FieldSetText("H4", Cstr(H4))
     Case 5
          H5 = 0
          Call uidoc.FieldSetText("H5", Cstr(H5))
     Case 6
          H6 = 0
          Call uidoc.FieldSetText("H6", Cstr(H6))
     Case 7 
          H7 = 0
          Call uidoc.FieldSetText("H7", Cstr(H7))
     Case 8
          H8 = 0
          Call uidoc.FieldSetText("H8", Cstr(H8))
     Case 9
          H9 = 0
          Call uidoc.FieldSetText("H9", Cstr(H9))
     Case 10
          H10 = 0
          Call uidoc.FieldSetText("H10", Cstr(H10))
     Case 11
          H11 = 0
          Call uidoc.FieldSetText("H11", Cstr(H11))
     Case 12
          H12 = 0
          Call uidoc.FieldSetText("H12", Cstr(H12))
     Case 13 
          H13 = 0
          Call uidoc.FieldSetText("H13", Cstr(H13))
     Case 14
          H14 = 0
          Call uidoc.FieldSetText("H14", Cstr(H14))
     Case 15
          H15 = 0
          Call uidoc.FieldSetText("H15", Cstr(H15))
     Case 16
          H16 = 0
          Call uidoc.FieldSetText("H16", Cstr(H16))
     Case 17
          H17 = 0
          Call uidoc.FieldSetText("H17", Cstr(H17))
     Case 18
          H18 = 0
          Call uidoc.FieldSetText("H18", Cstr(H18))
     Case 19
          H19 = 0
          Call uidoc.FieldSetText("H19", Cstr(H19))
     Case 20
          H20 = 0
          Call uidoc.FieldSetText("H20", Cstr(H20))
          
     End Select
     
     uidoc.Refresh     
     uidoc.RefreshHideFormulas
     
End Sub</lotusscript></code><code event='hidewhen'><formula>@Environment("HECS_Language") = "F"</formula></code></action>
