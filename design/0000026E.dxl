<action title='Update Order Forms' icon='10'><code event='click'><lotusscript
>Sub Click(Source As Button)
	Dim s As New notessession
	Dim db As notesdatabase
	Dim dv As notesview
	Dim dv2 As notesview
	Dim doc As notesdocument
	Dim orddoc As notesdocument
	Dim keys As String
	Dim aufield As notesitem
	Dim rdfield As notesitem
	
	Set db=s.CurrentDatabase
	Set dv=db.GetView("...Admin\Keywords")
	keys = "SendToAdmin"
	Set doc=dv.GetDocumentByKey(keys)
	Set dv2=db.GetView("All Orders")
	Set orddoc=dv2.GetFirstDocument
	
	While Not(orddoc Is Nothing)
		Set rdfield=orddoc.GetFirstItem("Readers")
		Set aufield=orddoc.GetFirstItem("Authors")
		Call rdfield.AppendToTextList(doc.EKeyword(0))
		Call aufield.AppendToTextList(doc.EKeyword(0))
		orddoc.Save True, True
		Set orddoc=dv2.GetNextDocument(orddoc)
	Wend
	Messagebox "The new Admin person's name has been added to the Authors field of the order access list."
	
End Sub</lotusscript></code></action>
