<tablecell borderwidth='0px'>
<par def='5'><run><font style='bold' name='Arial Black' pitch='variable' truetype='true'
 familyid='20' color='navy'/>2.</run><run><font style='bold'/> </run><run
><font style='bold'/><computedtext><code event='value'><formula>@If(@Environment("HECS_Language")="F";"Compte G/L:";"G/L Account #: ")</formula></code></computedtext></run><run
><font style='bold'/>	</run></par></tablecell>
<tablecell borderwidth='0px'>
<par def='6'><run><font style='bold'/></run><run><font style='bold'/><field
 lookupeachchar='false' lookupaddressonrefresh='false' type='keyword' kind='editable'
 name='GLAccount' taborder='3'><keywords recalconchange='true' recalcchoices='true'
 columns='1' ui='dialoglist'><formula>GLAcctList</formula></keywords><code
 event='entering'><lotusscript>Sub Entering(Source As Field)
	Dim ws As New notesuiworkspace
	Dim s As New notessession	
	Dim uidoc As notesuidocument
	Dim doc As notesdocument
	Dim fldTheFirstItem As notesitem	
	
	Set uidoc=ws.CurrentDocument
	uidoc.refresh
	Set doc=uidoc.Document
	Set fldTheFirstItem = doc.GetFirstItem("GLAcctList")
	
	Call uidoc.FieldSetText("GLAccount",fldTheFirstItem.Values(0))
	Set fldTheFirstItem = doc.GetFirstItem("ProgActList")
	Call uidoc.FieldSetText("PA",fldTheFirstItem.Values(0))
	If s.GetEnvironmentString("HECS_Language") = "F" Then
		Call uidoc.FieldSetText("GLAccount", Left(uidoc.FieldGetText("GLAccount"), Instr(uidoc.FieldGetText("GLAccount"),"|")-1))
		Call uidoc.FieldSetText("PA", Left(uidoc.FieldGetText("PA"), Instr(uidoc.FieldGetText("PA"),"|")-1))
	End If
End Sub</lotusscript></code></field></run><run><font style='bold' name='Arial Black'
 pitch='variable' truetype='true' familyid='20' color='navy'/></run></par></tablecell></tablerow>
