 pitch='variable' truetype='true' familyid='20'/> </run><run><font style='bold'/><computedtext
><code event='value'><formula>@If(@Environment("HECS_Language")="F";"Source des fonds:";"Funding Source:")</formula></code></computedtext></run><run
><font style='bold'/>	</run></par></tablecell>
<tablecell borderwidth='0px'>
<pardef id='6' leftmargin='0%' rightmargin='100%' keepwithnext='true' keeptogether='true'><code
 event='hidewhen'><formula>category=""</formula></code></pardef>
<par def='6'><run><font style='bold'/></run><run><font style='bold'/><field
 borderstyle='none' lookupeachchar='false' lookupaddressonrefresh='false'
 type='keyword' kind='editable' name='FundSource' taborder='2'><keywords recalconchange='true'
 recalcchoices='true' columns='2' ui='radiobutton'><formula>@Unique(@DbLookup("":"NoCache";"":"";"C2V4";Project+Category;2))</formula></keywords><code
 event='inputvalidation'><formula>@If(FundSource = ""; @Failure("Please do not leave the Funding Source field blank." + @NewLine + @NewLine + "Veuillez sélectionner un source des fonds:" ); @Success)</formula></code><code
 event='exiting'><lotusscript>Sub Exiting(Source As Field)
	Dim ws As New notesuiworkspace
	Dim uidoc As notesuidocument
	Dim doc As notesdocument
	Dim doc2 As notesdocument
	
	Dim s As New notessession
	Dim db As notesdatabase
	Dim v As notesview
	Dim keys( 1 To 3 ) As String
	Dim category As String          ' From Variant
	Dim fundsource As String        ' From Variant
	Dim project As String           ' From Variant
	Dim spa As Variant
	Dim GAField As notesitem
	Dim PAField As notesitem
	Dim fkeys(1 To 2) As String
	Dim frenchview As notesview
	Dim keyDoc As notesdocument
	Dim fldTheFirstItem As notesitem
	
	Set uidoc=ws.currentdocument
	Set doc=uidoc.Document
	category = doc.Category(0)
	fundsource =doc.FundSource(0)
	project = uidoc.FieldGetText("Project")
	Set db = s.CurrentDatabase
	Set v = db.Getview("C2V2")    
	Set frenchview = db.GetView("C1V")
	keys( 1 ) = category
	keys( 2 ) = fundsource
	keys( 3 ) = project
	Set doc2 = v.GetDocumentByKey(keys,True)
	doc.GSTExempt = doc2.GSTExempt(0)
	If Not (doc2 Is Nothing) Then
		spa = doc2.SPA
		Select Case spa(0)
		Case "Yes"
          ' If this is a special project account, the G/L Account is limited, client picks from a list of Program Activities.
			doc.ProgActList = Null
			doc.GLAcctList = Null
			doc.PrjNumList = Null
			doc.ProgActList = doc2.ProgActiv
			doc.GLAcctList = doc2.GLAccount
			doc.PrjNumList = doc2.IntOrd
			doc.FSC = doc2.CodeNumber(0)
			
		Case "No"
          ' If this is a regular funding source, then the Program Activity is limited, client picks from a list of G/L Accounts.
			doc.ProgActList = Null
			doc.GLAcctList = Null
			doc.PrjNumList = Null
			doc.ProgActList = doc2.ProgActiv
			doc.GLAcctList = doc2.GLAccount
			doc.PrjNumList = doc2.IntOrd
			doc.FSC = doc2.CodeNumber(0)
			
		End Select
		
		doc.GLAcctListFrench=""
		doc.PAListFrench=""
		If s.GetEnvironmentString("HECS_Language")="F" Then
			Dim frItem2 As notesitem
			Set frItem2 = doc.GetFirstItem("GLAcctListFrench")
			Dim frItem As notesitem
			Set frItem=doc.GetFirstItem("GLAcctList")
			Forall x In frItem.Values
				
				fkeys(1)="G/L Account"
				fkeys(2)=x
				
				Set keyDoc=frenchview.GetDocumentByKey(fkeys)
				
				If Not (keyDoc Is Nothing) Then 
					x=keyDoc.NameF(0)+"|"+keyDoc.Name(0)
					Call frItem2.AppendToTextList(x)
				End If
			End Forall
			
			doc.GLAcctList=doc.GLAcctListFrench
			
		End If
		
		If s.GetEnvironmentString("HECS_Language")="F" Then
			Dim frItem4 As notesitem
			Set frItem4 = doc.GetFirstItem("PAListFrench")
			Dim frItem3 As notesitem
			Set frItem3=doc.GetFirstItem("ProgActList")
			Forall x In frItem3.Values
				
				fkeys(1)="Program Activity"
				fkeys(2)=x
				
				Set keyDoc=frenchview.GetDocumentByKey(fkeys)
				
				If Not (keyDoc Is Nothing) Then 
					x=keyDoc.NameF(0)+"|"+keyDoc.Name(0)
					Call frItem4.AppendToTextList(x)
				End If
			End Forall
			
			doc.ProgActList=doc.PAListFrench
			
		End If
		
	Else
		doc.ProgActList = Null
		doc.GLAcctList = Null
		doc.PrjNumList = Null
		doc.FSC = Null          
	End If
	
	Call uidoc.refresh
	
End Sub
</lotusscript></code><code event='entering'><lotusscript>Sub Entering(Source As Field)
	Dim w As New notesuiworkspace
	Dim uidoc As notesuidocument
	
	Set uidoc=w.currentdocument
	Call uidoc.FieldSetText("FundSource","")
	Call uidoc.FieldSetText("GLAccount","")    
	Call uidoc.FieldSetText("PA","")    
    ' Call uidoc.FieldSetText("Project","")             
End Sub</lotusscript></code></field></run></par></tablecell></tablerow>
