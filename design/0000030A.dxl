<par def='35'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/><field
 type='richtext' kind='editable' name='HelpFHelpText'><code event='exiting'><lotusscript
>Sub Exiting(Source As Field)
     Dim WS As New NotesUIWorkSpace
     Dim uidoc As NotesUIDocument
     
     Set uidoc = WS.CurrentDocument
     
     plainText = uidoc.FieldGetText( "HelpFHelpText" )
     
     If Len(plaintext) &gt; 0 Then
          Call uidoc.FieldSetText("HFText", "Yes")
     Else
          Call uidoc.FieldSetText("HFText", "No")
     End If
     
End Sub</lotusscript></code></field></run><run><font size='9pt' color='maroon'
 style='bold' name='Arial' pitch='variable' truetype='true' familyid='20'/></run></par>
