<!DOCTYPE agent>
<agent name='ReCalculateThisBudget' xmlns='http://www.lotus.com/dxl' version='12.0'
 maintenanceversion='2.0' replicaid='85258E750045D0DA' hide='v3 v4' publicaccess='false'
 designerversion='6.5' restrictions='unrestricted'>
