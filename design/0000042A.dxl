<action title='Create Profile' icon='124'><code event='click'><formula>@If(Form != "AppProfile";@Command([Compose];"AppProfile");"")</formula></code><code
 event='hidewhen'><formula>@Environment( "Corp_Language" ) = "F"</formula></code></action>
<action title='Créer profil' icon='124'><code event='click'><formula>@If(Form != "AppProfile";@Command([Compose];"AppProfile");"")</formula></code><code
