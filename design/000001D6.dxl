<designchange><datetime dst='true'>20100914T134339,70-04</datetime></designchange>
<trigger type='actionsmenu'/>
<documentset type='runonce'/><code event='options'><lotusscript>Option Public

</lotusscript></code><code event='initialize'><lotusscript>Sub Initialize
	Dim workspace As New NotesUIWorkspace
	Dim uidoc As NotesUIDocument
	Dim doc As notesdocument 
	Dim fieldname As String
	Dim fieldname2 As String
	Dim fieldvalue As Variant
	Dim fieldvalue2 As Variant
	Dim temp As Variant
	Dim pname As String
	Dim pfax As String
	Dim msg As String
	Dim msg2 As String
	Dim pemail As String
	
	
	
	Set uidoc = workspace.CurrentDocument 
	Set doc = uidoc.Document 
	temp = Evaluate({@Contains(FinCode; "04001")},doc)
	msg = "Send MSDS order or email/fax to: "
	pname = uidoc.FieldGetText("InvName")
	pfax = uidoc.FieldGetText("InvFax")
	pemail = uidoc.FieldGetText("InvEmail")
	
	msg2 = msg + pname +"  "+ pemail +Chr$(10)+ " fax " + pfax
	
	If uidoc.Isnewdoc Then
		If  temp(0) = 1 Then
			For count = 1 To 20
				fieldname = "i"+ Cstr(count) +"Desc"
				fieldname2 = "i"+ Cstr(count)+"Quant"
				fieldvalue = doc.GetItemValue(fieldname)
				fieldvalue2 = doc.GetItemValue(fieldname2)
				
				If fieldvalue(0) = ""  Then 
					Call uidoc.fieldsettext(fieldname,msg2)
					Call uidoc.fieldsettext(fieldname2,"1")
					Exit Sub
				End If 
				
			Next
		End If	
	End If
End Sub</lotusscript></code>
