<par def='118'><run><font style='bold'/><field type='number' kind='computed'
 name='i18Quant'><numberformat format='fixed' punctuated='false' parens='false'
 percent='false' bytes='false'/><code event='defaultvalue'><formula>i18Quant</formula></code></field></run></par></tablecell>
<tablecell borderwidth='0px 1px'>
<pardef id='119' align='right' keepwithnext='true' keeptogether='true'><code
 event='hidewhen'><formula>(i18Desc="" &amp; i18Quant=0&amp;i18PricePer=0) &amp; (i19Desc=""&amp;i20Desc="")</formula></code></pardef>
<par def='119'><run><font style='bold'/><field type='number' kind='computed'
 name='i18PricePer'><numberformat format='currency' digits='2' punctuated='false'
 parens='false' percent='false' bytes='false'/><code event='defaultvalue'><formula
>i18PricePer</formula></code><code event='exiting'><lotusscript>Sub Exiting(Source As Field)
     Dim ws As New notesuiworkspace
     Dim uidoc As notesuidocument
     Dim doc As notesdocument
     Dim Quantity As Integer
     Dim UnitPrice As Currency
     Dim HideCounter As Integer
     Dim TempPrice As String
     Dim Length As Integer     
     Dim H10 As Integer
     
     Set uidoc=ws.currentdocument
     
     Quantity=Val(uidoc.FieldGetText("i10Quant"))
     TempPrice=Ltrim$(uidoc.FieldGetText("i10PricePer"))
     If (Instr(TempPrice, "$")) Then
          Length = Len(TempPrice) -1    ' To remove the $ sign
     Else
          Length = Len(TempPrice)
     End If     
     
     TempPrice = Right$(TempPrice, Length) 
     UnitPrice=Val(TempPrice)
     HideCounter=Val(uidoc.FieldGetText("HideCount"))
     
     
     If ((Quantity=0) And (UnitPrice=0)) Then
          H10 = 1
          Call uidoc.FieldSetText("i10Desc", "")          
          Call uidoc.FieldSetText("H10", Cstr(H10))
     End If
     
     If ((Quantity &gt; 0 Or UnitPrice&gt;0) And HideCounter &lt; 11) Then
          HideCounter = 11
          Call uidoc.FieldSetText("HideCount", Cstr(HideCounter))
     End If
     
     
     uidoc.Refresh
     uidoc.RefreshHideFormulas
End Sub</lotusscript></code></field></run></par></tablecell>
