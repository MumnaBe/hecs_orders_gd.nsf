>PurchaseType="Purchase Order"</formula></code></pardef>
<par def='4'><run><font style='bold'/></run></par>
<table user4spacing='true' leftmargin='0.7479in' widthtype='fixedleft' refwidth='7.1250in'><tablecolumn
 width='4.2500in'/><tablecolumn width='2.8750in'/>
<tablerow>
<tablecell borderwidth='1px 0px 1px 1px' bgcolor='gray'>
<pardef id='6' leftmargin='1%' rightmargin='99%' keepwithnext='true' keeptogether='true'/>
<par def='6'>Financial Code/Code Financier:<run><font style='bold'/> </run><run
><font style='bold'/><field type='text' kind='computed' name='FinCode'><code
 event='defaultvalue'><formula>FinCode</formula></code></field></run><run
><font style='bold'/></run></par></tablecell>
<tablecell borderwidth='1px 1px 1px 0px'>
<pardef id='7' align='right' leftmargin='1%' rightmargin='99%' keepwithnext='true'
 keeptogether='true'/>
<par def='7'>Order/Commande:<run><font style='bold'/> </run><run><font style='bold'/><field
 type='text' kind='computed' name='d_RefNumber'><code event='defaultvalue'><formula
>a := @DbLookup(""; "";  "KeywordLookup"; "RefNumberPrefix"; 2);
@If(a="";"";a) + RefNumber</formula></code></field></run></par></tablecell></tablerow></table>
