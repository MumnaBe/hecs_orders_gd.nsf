<action title='Cancel Order' icon='11' showinmenu='false'><code event='click'><formula
>@Command( [EditDocument]; "1" );
FIELD SaveOptions := SaveOptions;
FIELD Status := Status;
FIELD BudgetCalculated := BudgetCalculated;
@SetField("SaveOptions"; "1");
@SetField("Status"; "Cancelled");

@If(BudgetCalculated="Yes";@Command([ToolsRunMacro];"RecalculateThisBudget");"");

@SetField("ShippingCost";0);
@SetField("Customs";0);
@SetField("i1Quant";0);
@SetField("i2Quant";0);
@SetField("i3Quant";0);
@SetField("i4Quant";0);
@SetField("i5Quant";0);
@SetField("i6Quant";0);
@SetField("i7Quant";0);
@SetField("i8Quant";0);
@SetField("i9Quant";0);
@SetField("i10Quant";0);
@SetField("i11Quant";0);
@SetField("i12Quant";0);
@SetField("i13Quant";0);
@SetField("i14Quant";0);
@SetField("i15Quant";0);
@SetField("i16Quant";0);
@SetField("i17Quant";0);
@SetField("i18Quant";0);
@SetField("i19Quant";0);
@SetField("i20Quant";0);

@SetField("i1PricePer";0);
@SetField("i2PricePer";0);
@SetField("i3PricePer";0);
@SetField("i4PricePer";0);
@SetField("i5PricePer";0);
@SetField("i6PricePer";0);
@SetField("i7PricePer";0);
@SetField("i8PricePer";0);
@SetField("i9PricePer";0);
@SetField("i10PricePer";0);
@SetField("i11PricePer";0);
@SetField("i12PricePer";0);
@SetField("i13PricePer";0);
@SetField("i14PricePer";0);
