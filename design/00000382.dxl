<tablecell borderwidth='0px'>
<par def='53'><run><font style='bold'/></run><run><font style='bold'/><computedtext
><code event='value'><formula>@If(@Environment("HECS_Language") = "E"; "Cost:"; "Coût :")</formula></code></computedtext></run><run
><font style='bold'/></run></par></tablecell>
<tablecell borderwidth='0px'>
<par def='54'><run><font style='bold'/></run><field type='number' kind='computedwhencomposed'
 name='TotCost'><numberformat format='currency' digits='2' punctuated='false'
 parens='false' percent='false' bytes='false'/><code event='defaultvalue'><formula
>REM {Computed fields Exchange_1, ShippingCost_1 and Custom_1 are hidden fields at the top of this form. Their purpose is for the formula below to execute and calculate based only on computer fields};

@If(Exchange_1 = "" | Exchange_1 = 0;TotPrice + ShippingCost_1 + Customs_1; (TotPrice + ShippingCost_1 + Customs_1) + Exchange_1*(TotPrice + ShippingCost_1 + Customs_1))</formula></code></field><run
><font style='bold'/></run></par></tablecell></tablerow>
<tablerow>
<tablecell borderwidth='0px'>
<par def='53'><run><font style='bold'/></run><run><font style='bold'/><computedtext
><code event='value'><formula>@If(@Environment("HECS_Language") = "E"; "Cost w/Applicable HST:"; "Coût avec TVH applicable:")</formula></code></computedtext></run><run
><font style='bold'/>	</run></par></tablecell>
<tablecell borderwidth='0px'>
<par def='54'><run><font style='bold'/></run><field type='number' kind='computed'
 name='TotCostTaxed'><numberformat format='currency' digits='2' punctuated='false'
 parens='false' percent='false' bytes='false'/><code event='defaultvalue'><formula
>@If(GSTExempt="No";@If(@IsError(TotPrice * TotGst);0;TotPrice * TotGst);TotPrice)</formula></code></field><run
><font style='bold'/></run></par></tablecell></tablerow></table>
<par def='4'><run><font style='bold'/></run><run><font style='bold'/><computedtext
><code event='value'><formula>@If(@Environment("HECS_Language") = "E"; "Exchange:"; "Taux de change:")</formula></code></computedtext></run><run
><font style='bold'/></run></par>
<par def='4'><run><font style='bold'/></run></par>
