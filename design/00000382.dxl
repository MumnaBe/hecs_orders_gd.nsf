 type='names' kind='editable' name='CompanyName'><code event='exiting'><lotusscript
>Sub Exiting(Source As Field)
     
     Dim ws As New notesuiworkspace
     Dim uidoc As notesuidocument
     Set uidoc=ws.currentdocument
     
     If Not(uidoc.FieldGetText("CompanyName")="") Then
          Call CompAddress
     End If
     
     
End Sub</lotusscript></code></field></par></tablecell></tablerow>
