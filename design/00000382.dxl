<tablecell borderwidth='0px'>
<pardef id='12' leftmargin='1%' rightmargin='99%' keepwithnext='true' keeptogether='true'><code
 event='hidewhen'><formula>1</formula></code></pardef>
<par def='12'><run><font color='red'/><field type='datetime' kind='computed'
 name='IssueDate'><datetimeformat show='date' date='yearmonthday' time='hourminutesecond'
 zone='never'/><code event='defaultvalue'><formula>@Date(@Created)</formula></code></field></run> </par>
<pardef id='13' leftmargin='1%' rightmargin='99%' keeptogether='true'/>
<par def='13'><field type='text' kind='computed' name='IssueDate_1'><code
 event='defaultvalue'><formula>monthsE := "January" : "February" : "March" : "April" : "May" : "June" : "July" : "August" : "September" : "October" : "November" : "December";
monthsF := "Janvier" : "Février" : "Mars" : "Avril" : "Mai" : "Juin" : "Juillet" : "Août" : "Septembre" : "Octobre" : "Novembre" : "Décembre";
monthE := @Subset(@Subset(monthsE; @Month(@Created)); -1);
monthF := @Subset(@Subset(monthsF; @Month(@Created)); -1);
year := @Year(@Created);
day := @Day (@Created);

@If(@Environment("HECS_Language")="E"; monthE + " " + @Text(day) + ", " + @Text(year); @Text(day) + " " + monthF + ", " + @Text(year))</formula></code></field></par></tablecell></tablerow>
<tablerow>
<tablecell borderwidth='0px'>
<par def='5'><run><font style='bold'/></run></par></tablecell>
