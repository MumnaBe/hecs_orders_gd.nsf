<trigger type='actionsmenu'/>
<documentset type='runonce'/><code event='action'>
<simpleaction action='runformula'><formula>FIELD FinCode := FinCode;
FIELD FinCategory := FinCategory;
@DialogBox( "CCForm";[AutoHorzFit]:[AutoVertFit]:[NoNewFields]; "Financial Codes" );
@SetField("FinCode";CompleteFinancialCode);
@SetField("FinCategory"; Category);SELECT @All</formula></simpleaction></code>
