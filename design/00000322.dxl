<par def='13'><run><font size='12pt' color='navy' style='bold' name='Arial'
 pitch='variable' truetype='true' familyid='20'/><field type='text' kind='computedfordisplay'
 name='HelpDBTitle'><code event='defaultvalue'><formula>TmpNameE:= @If(HelpECategories="1. User Guide"; "User Guide";
      HelpECategories="2. Database Custodian Guide"; "Database Administrator Guide";
      HelpECategories="3. Notes System Admin Guide"; "Notes Administrator Guide";
      HelpECategories="4. Trainer Guide"; "Trainer Guide";
      HelpECategories="5. Application Developer Guide"; "Application Developer Guide";
      HelpECategories
     );

TmpNameF:= @If(HelpECategories="1. User Guide"; "Guide d'utilisation";
      HelpECategories="2. Database Custodian Guide"; "Guide d'administration";
      HelpECategories="3. Notes Administrator Guide"; "Guide de l'administrateur de Notes";
      HelpECategories="4. Trainer Guide"; "Guide du formateur";
      HelpECategories="5. Application Developer Guide"; "Guide du développeur d'applications";
      HelpFCategories
     );

@If(@Environment("UserWorkingLanguage")="F"; TmpNameF; TmpNameE)</formula></code></field></run><run
><font size='9pt' name='Arial' pitch='variable' truetype='true' familyid='20'/></run></par></tablecell></tablerow>
