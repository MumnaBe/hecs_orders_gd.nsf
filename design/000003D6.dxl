<designchange><datetime dst='true'>20100914T134342,02-04</datetime></designchange>
<trigger type='actionsmenu'/>
<documentset type='selected'/><code event='action'>
<simpleaction action='runformula'><formula>REM{2009-06-29: ADR 3550: JML: This agent was created in July 2009 to set the values of the fields: VISA, VISA_EN and VISA_FR on the Company documents.  In July 2009, the values for the field VISA were entered manually and are inconsistent.  This cause the application to not work properly when the users import company information on an order.};

@If(
  form = "Company";
    @Do(
      @SetField("VISA"; "Yes");
      @SetField("VISA_EN"; "Yes");
      @SetField("VISA_FR"; "Oui"));
  "");

SELECT @All</formula></simpleaction></code>
<rundata processeddocs='0' exitcode='0'>
<agentmodified><datetime dst='true'>20090702T100634,20-04</datetime></agentmodified></rundata>
<item name='$Readers' sign='true' readers='true'><text>[LNOG Admin]</text></item>
