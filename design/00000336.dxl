<updatedby><name>CN=Jean-Marc Leblanc/OU=HC-SC/O=GC/C=CA</name><name>CN=HC-R_AGENT-SC/OU=HC-SC/O=GC/C=CA</name></updatedby>
<wassignedby><name>CN=HC-R_AGENT-SC/OU=HC-SC/O=GC/C=CA</name></wassignedby><code
 event='windowtitle'><formula>@If(@Environment("HECS_Language")="F";"Projet";"Project")</formula></code><code
 event='querysave'><lotusscript>Sub Querysave(Source As Notesuidocument, Continue As Variant)
     
     Dim ws As New notesuiworkspace
     Dim uidoc As notesuidocument
     Dim doc As notesdocument
     Dim flagnumber As Integer
     
     Set uidoc=ws.currentdocument
     Set doc = uidoc.document
     If uidoc.IsNewDoc Then
          Call uidoc.FieldSetText("budgetOp_com", "0")
          Call uidoc.FieldSetText("budgetTrav_com", "0")
          Call uidoc.FieldSetText("budgetContr_com", "0")
          Call uidoc.FieldSetText("budgetCap_com", "0")
          Call uidoc.Refresh
     End If
     ' -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
     ' This section fills the "CategoriesAllowed" field.
     ' We are using flag numbers to determine which categories of spending are allowed for this project.
     ' 8 = Operating
     ' 4 = Travel
     ' 2 = Contract
     ' 1= Capital
     ' If there is a value larger than 0 in any of the sections, then the corresponding number is added to 'flagnumber'.
     ' This will give us unique numbers for each combination of Operating, Travel, Contract and Capital
     ' IE:  A value of 15 will return all 4... 8 (Operating) + 4 (Travel) + 2 (Contract) +1 (Capital) = 15
     '       A value of 6 will return Travel and Contract ...  4 (Travel) + 2 (Contract) = 6
     ' We can then use this number to determine whether or not to list certain Cost Code items from the Cost Code dialogue
     ' ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
     flagnumber = 0
     
     If Not (uidoc.fieldGetText("budgetOp")) = "$0.00" Then
          flagnumber = flagnumber + 8
     End If
     If Not (uidoc.fieldGetText("budgetTrav")="$0.00")  Then
          flagnumber = flagnumber + 4
     End If
     If Not (uidoc.fieldgettext("budgetContr")= "$0.00") Then
          flagnumber =flagnumber + 2
     End If
     If Not (uidoc.fieldgettext("budgetCap")="$0.00") Then 
          flagnumber = flagnumber + 1
     End If
     Call uidoc.fieldsettext("CategoriesAllowed", Cstr(flagnumber))
' -------------------------------------------------------------------------------------------------------------------------------------------------------------------     
     Call uidoc.refresh
     
End Sub
</lotusscript></code><code event='querymodechange'><lotusscript>Sub Querymodechange(Source As Notesuidocument, Continue As Variant)
     Dim test As String
     Dim answer As Variant
     test="@IsMember('[Admin]';@userRoles)"
     answer=Evaluate(test)
     If Not(answer(0)=1) Then
          Continue=False
     End If
End Sub
</lotusscript></code><code event='postopen'><lotusscript>Sub Postopen(Source As Notesuidocument)
     
End Sub
</lotusscript></code><code event='queryopen'><lotusscript>Sub Queryopen(Source As Notesuidocument, Mode As Integer, Isnewdoc As Variant, Continue As Variant)
     Dim test As String
     Dim answer As Variant
     test="@IsMember('[Admin]';@userRoles)"
     answer=Evaluate(test)
     If Mode = 1 And Not(answer(0)=1) Then
          Continue=False
     End If
End Sub</lotusscript></code>
