<action title='Re-Calculate Budget (Old)' icon='101' hide='notes'><code event='declarations'><lotusscript
>Const NPB_STATUSBAR% = 1

Declare Sub NEMProgressEnd Lib "nnotesws.dll" ( Byval hwnd As Long )
Declare Function NEMProgressBegin Lib "nnotesws.dll" ( Byval wFlags As Integer ) As Long
Declare Sub NEMProgressSetBarPos Lib "nnotesws.dll" ( Byval hwnd As Long, Byval dwPos As Long)
Declare Sub NEMProgressSetBarRange Lib "nnotesws.dll" ( Byval hwnd As Long, Byval dwMax As Long )
Declare Sub NEMProgressSetText Lib "nnotesws.dll" ( Byval hwnd As Long, Byval pcszLine1 As String, Byval pcszLine2 As String )

</lotusscript></code><code event='click'><lotusscript>Sub Click(Source As Button)
	
	' This button was replaced with the new one called "Re-Calcualte Budget"
	
	'======================
	' For the status bar
	On Error Goto killbar
	Dim hwnd As Long
	Dim i As Long
	'======================
	Dim ws As New notesuiworkspace
	Dim uidoc As notesuidocument
	Dim bOpTotal As Currency
	Dim bTravTotal As Currency
	Dim bConTotal As Currency
	Dim bCapTotal As Currency
	Dim purchCat As String
	
	Dim s As New notessession
	Dim db As notesdatabase
	Dim dv As notesview
	Dim dvc As notesviewentrycollection
	Dim oDoc As notesdocument
	
	bOpTotal = 0
	bTravTotal = 0
	bConTotal = 0
	bCapTotal = 0
	
	Set uidoc=ws.currentdocument
	Set db=s.CurrentDatabase
	Set dv=db.GetView("reflookup")
	Set dvc=dv.AllEntries
	Set oDoc = dv.GetFirstDocument
	'============================
	' Start the status bar
	i = 1
	NEMProgressSetText hwnd, "Please wait...", "Recalculating budget..."
	hwnd = NEMProgressBegin(NPB_STATUSBAR)
	NEMProgressSetBarRange hwnd, dvc.Count
	NEMProgressSetText hwnd, "Calculating...", "Please wait while all orders for " &amp; uidoc.FieldGetText("FiscalYearStart") &amp; " to " &amp; uidoc.FieldGetText("FiscalYearEnd") &amp; " are totaled"
	
	'============================
	Dim item As NotesItem
	Dim dtIssueDate As NotesDateTime
	Dim dtFYStart As NotesDateTime
	Dim dtFYEnd As NotesDateTime
	Set item = uidoc.Document.GetFirstItem( "FiscalYearStart" )
	Set dtFYStart = item.DateTimeValue
	Set item = uidoc.Document.GetFirstItem( "FiscalYearEnd" )
	Set dtFYEnd = item.DateTimeValue
	
	While Not (oDoc Is Nothing)
		Set item = oDoc.GetFirstItem( "IssueDate" )
		Set dtIssueDate = item.DateTimeValue		
		
		'2009-05-21: JML: ADR#3550: the field "Created" was replaced with "IssueDate" becasue that date is not affected when copying documents from Prod to Dev
		'If oDoc.Created &gt;= uidoc.Document.FiscalYearStart(0) And oDoc.Created &lt;= uidoc.Document.FiscalYearEnd(0) Then
		
		If dtIssueDate.DateOnly &gt;= dtFYStart.DateOnly And dtIssueDate.DateOnly &lt;= dtFYEnd.DateOnly Then
			purchCat = oDoc.FinCategory(0)
			If oDoc.ProjectSelection(0)=uidoc.FieldGetText("Project") And oDoc.BudgetCalculated(0) = "Yes" Then
				Select Case purchCat
				Case "Operating"
					If oDoc.GSTExempt(0)="Yes" Then
						bOpTotal = bOpTotal + oDoc.TotCost(0)                       
					Else
						bOpTotal = bOpTotal + oDoc.TotCostTaxed(0)
					End If
				Case "Travel"
					If oDoc.GSTExempt(0)="Yes" Then
						bTravTotal = bTravTotal + oDoc.TotCost(0)                       
					Else
						bTravTotal = bTravTotal + oDoc.TotCostTaxed(0)
					End If
				Case "Contract"
					If oDoc.GSTExempt(0)="Yes" Then
						bConTotal = bConTotal + oDoc.TotCost(0)                       
					Else
						bConTotal = bConTotal + oDoc.TotCostTaxed(0)
					End If
				Case "Capital"
					If oDoc.GSTExempt(0)="Yes" Then
						bCapTotal = bCapTotal + oDoc.TotCost(0)                       
					Else
						bCapTotal = bCapTotal + oDoc.TotCostTaxed(0)
					End If
				End Select
			End If
		End If
		Set oDoc=dv.GetNextDocument(oDoc)
		NEMProgressSetText hwnd, "Calculating...", "Please wait while all orders for " &amp; uidoc.FieldGetText("FiscalYearStart") &amp; " to " &amp; uidoc.FieldGetText("FiscalYearEnd") &amp; " are processed. (" &amp; i &amp;"/" &amp;Cstr(dvc.Count)&amp;")"
		NEMProgressSetBarPos hwnd, i
		i = i + 1
		
	Wend
	Call uidoc.FieldSetText("budgetOp_com",Cstr(bOpTotal))
	Call uidoc.FieldSetText("budgetTrav_com", Cstr(bTravTotal))
	Call uidoc.FieldSetText("budgetContr_com", Cstr(bConTotal))
	Call uidoc.FieldSetText("budgetCap_com", Cstr(bCapTotal))
	
killbar:
	NEMProgressEnd hwnd
	uidoc.Refresh
	
End Sub</lotusscript></code><code event='hidewhen'><formula>!(@Contains("[Admin]";@UserRoles))|!@IsDocBeingEdited</formula></code></action>
<action title='Re-Calculate Budget' icon='101'><code event='declarations'><lotusscript
>Const NPB_STATUSBAR% = 1

Declare Sub NEMProgressEnd Lib "nnotesws.dll" ( Byval hwnd As Long )
Declare Function NEMProgressBegin Lib "nnotesws.dll" ( Byval wFlags As Integer ) As Long
Declare Sub NEMProgressSetBarPos Lib "nnotesws.dll" ( Byval hwnd As Long, Byval dwPos As Long)
Declare Sub NEMProgressSetBarRange Lib "nnotesws.dll" ( Byval hwnd As Long, Byval dwMax As Long )
Declare Sub NEMProgressSetText Lib "nnotesws.dll" ( Byval hwnd As Long, Byval pcszLine1 As String, Byval pcszLine2 As String )

</lotusscript></code><code event='click'><lotusscript>Sub Click(Source As Button)
	
	' Description: this button will recalculate the budget for the current project.  
	' Each order matching the project name, that has already been calculated will 
	' be processed if the issue date falls between the project start and end dates.
	'
	' Changes: 2009-06-29: ADR 3550, JML. the button was modified to use the view "vwAllOrdersByProject"
	'                   This change result in a much faster performance because the search is more narrow
	'                   This gain of speed will allow the project to be calculated one after the other manually instead of writing a new agent to update all project's budget. 
	'                   Note that the DB in production contains sometimes more than 8000 orders that would take lots of unnecessary time to process 
	
	
	'======================
	' For the status bar
	On Error Goto killbar
	Dim hwnd As Long
	Dim i As Long
	'======================
	Dim ws As New notesuiworkspace
	Dim uidoc As notesuidocument
	Dim bOpTotal As Currency
	Dim bTravTotal As Currency
	Dim bConTotal As Currency
	Dim bCapTotal As Currency
	Dim purchCat As String
	
	Dim s As New notessession
	Dim db As notesdatabase
	Dim dv As notesview
	Dim dvc As notesviewentrycollection
	Dim oDoc As notesdocument
	
	bOpTotal = 0
	bTravTotal = 0
	bConTotal = 0
	bCapTotal = 0
	
	Set uidoc=ws.currentdocument
	Set db=s.CurrentDatabase
	'Set dv=db.GetView("reflookup")
	'Set dvc=dv.AllEntries
	'Set oDoc = dv.GetFirstDocument	
	'============================
	
	Dim collection As NotesDocumentCollection
	Set dv=db.GetView("vwAllOrdersByProject")
	Set collection = dv.GetAllDocumentsByKey(uidoc.FieldGetText("Project"))
	Set oDoc = collection.GetFirstDocument
	
	' Start the status bar
	i = 1
	NEMProgressSetText hwnd, "Please wait...", "Recalculating budget..."
	hwnd = NEMProgressBegin(NPB_STATUSBAR)
	'NEMProgressSetBarRange hwnd, dvc.Count
	'NEMProgressSetText hwnd, "Calculating...", "Please wait while all orders for " &amp; uidoc.FieldGetText("FiscalYearStart") &amp; " to " &amp; uidoc.FieldGetText("FiscalYearEnd") &amp; " are totaled"
	NEMProgressSetBarRange hwnd, collection.Count
	NEMProgressSetText hwnd, "Calculating...", "Please wait while all orders for " &amp; uidoc.FieldGetText("FiscalYearStart") &amp; " to " &amp; uidoc.FieldGetText("FiscalYearEnd") &amp; " are totaled"
	
	'============================
	Dim item As NotesItem
	Dim dtIssueDate As NotesDateTime
	Dim dtFYStart As NotesDateTime
	Dim dtFYEnd As NotesDateTime
	Set item = uidoc.Document.GetFirstItem( "FiscalYearStart" )
	Set dtFYStart = item.DateTimeValue
	Set item = uidoc.Document.GetFirstItem( "FiscalYearEnd" )
	Set dtFYEnd = item.DateTimeValue
	
	While Not (oDoc Is Nothing)
		Set item = oDoc.GetFirstItem( "IssueDate" )
		Set dtIssueDate = item.DateTimeValue		
		
		'2009-05-21: JML: ADR#3550: the field "Created" was replaced with "IssueDate" becasue that date is not affected when copying documents from Prod to Dev
		'If oDoc.Created &gt;= uidoc.Document.FiscalYearStart(0) And oDoc.Created &lt;= uidoc.Document.FiscalYearEnd(0) Then
		
		If dtIssueDate.DateOnly &gt;= dtFYStart.DateOnly And dtIssueDate.DateOnly &lt;= dtFYEnd.DateOnly Then
			purchCat = oDoc.FinCategory(0)
			If oDoc.ProjectSelection(0)=uidoc.FieldGetText("Project") And oDoc.BudgetCalculated(0) = "Yes" Then
				Select Case purchCat
				Case "Operating"
					If oDoc.GSTExempt(0)="Yes" Then
						bOpTotal = bOpTotal + oDoc.TotCost(0)                       
					Else
						bOpTotal = bOpTotal + oDoc.TotCostTaxed(0)
					End If
				Case "Travel"
					If oDoc.GSTExempt(0)="Yes" Then
						bTravTotal = bTravTotal + oDoc.TotCost(0)                       
					Else
						bTravTotal = bTravTotal + oDoc.TotCostTaxed(0)
					End If
				Case "Contract"
					If oDoc.GSTExempt(0)="Yes" Then
						bConTotal = bConTotal + oDoc.TotCost(0)                       
					Else
						bConTotal = bConTotal + oDoc.TotCostTaxed(0)
					End If
				Case "Capital"
					If oDoc.GSTExempt(0)="Yes" Then
						bCapTotal = bCapTotal + oDoc.TotCost(0)                       
					Else
						bCapTotal = bCapTotal + oDoc.TotCostTaxed(0)
					End If
				End Select
			End If
		End If
		Set oDoc=collection.GetNextDocument(oDoc)
		NEMProgressSetText hwnd, "Calculating...", "Please wait while all orders for " &amp; uidoc.FieldGetText("FiscalYearStart") &amp; " to " &amp; uidoc.FieldGetText("FiscalYearEnd") &amp; " are processed. (" &amp; i &amp;"/" &amp;Cstr(collection.Count)&amp;")"
		'NEMProgressSetText hwnd, "Calculating...", "Please wait while all orders for " &amp; uidoc.FieldGetText("FiscalYearStart") &amp; " to " &amp; uidoc.FieldGetText("FiscalYearEnd") &amp; " are processed. (" &amp; i &amp;"/" &amp;Cstr(dvc.Count)&amp;")"
		NEMProgressSetBarPos hwnd, i
		i = i + 1
		
	Wend
	Call uidoc.FieldSetText("budgetOp_com",Cstr(bOpTotal))
	Call uidoc.FieldSetText("budgetTrav_com", Cstr(bTravTotal))
	Call uidoc.FieldSetText("budgetContr_com", Cstr(bConTotal))
	Call uidoc.FieldSetText("budgetCap_com", Cstr(bCapTotal))
	
killbar:
	NEMProgressEnd hwnd
	uidoc.Refresh
	
End Sub</lotusscript></code><code event='hidewhen'><formula>!(@Contains("[Admin]";@UserRoles))|!@IsDocBeingEdited</formula></code></action>
<action title='Show Custom Calculation' icon='101'><code event='declarations'><lotusscript
>Const NPB_STATUSBAR% = 1

Declare Sub NEMProgressEnd Lib "nnotesws.dll" ( Byval hwnd As Long )
Declare Function NEMProgressBegin Lib "nnotesws.dll" ( Byval wFlags As Integer ) As Long
Declare Sub NEMProgressSetBarPos Lib "nnotesws.dll" ( Byval hwnd As Long, Byval dwPos As Long)
Declare Sub NEMProgressSetBarRange Lib "nnotesws.dll" ( Byval hwnd As Long, Byval dwMax As Long )
Declare Sub NEMProgressSetText Lib "nnotesws.dll" ( Byval hwnd As Long, Byval pcszLine1 As String, Byval pcszLine2 As String )
</lotusscript></code><code event='click'><lotusscript>Sub Click(Source As Button)
	
	'/*******************************************************
	'/  This button will calculate the project's budget for all Orders falling in between the dates given by the user
	'/   Only the Orders for which the Budget has already been calculated wil be calculated.
	'/	The results are displayed only
	'/*******************************************************
	
	'======================
	' For the status bar
	On Error Goto killbar
	Dim hwnd As Long
	Dim i As Long
	'======================
	Dim ws As New notesuiworkspace
	Dim uidoc As notesuidocument
	Dim bOpTotal As Currency
	Dim bTravTotal As Currency
	Dim bConTotal As Currency
	Dim bCapTotal As Currency
	Dim purchCat As String
	
	Dim s As New notessession
	Dim db As notesdatabase
	Dim dv As notesview
	Dim dvc As notesviewentrycollection
	Dim oDoc As notesdocument
	
	bOpTotal = 0
	bTravTotal = 0
	bConTotal = 0
	bCapTotal = 0
	StartDate=ws.prompt(PROMPT_OKCANCELEDIT,"Start Date", "Enter a start date in the format YYYY/MM/DD")
	
	If  (Cstr(StartDate) Like "####/##/##" ) Then
		EndDate=ws.prompt(PROMPT_OKCANCELEDIT,"End Date", "Enter an end date in the format YYYY/MM/DD")
		If  (Cstr(EndDate) Like "####/##/##") Then
			Set uidoc=ws.currentdocument
			Set db=s.CurrentDatabase
			Set dv=db.GetView("reflookup")
			Set dvc=dv.AllEntries
			Set oDoc = dv.GetFirstDocument
	'============================
	' Start the status bar
			i = 1
			NEMProgressSetText hwnd, "Please wait...", "pcszLine 2 Goes Here"
			hwnd = NEMProgressBegin(NPB_STATUSBAR)
			NEMProgressSetBarRange hwnd, dvc.Count
			NEMProgressSetText hwnd, "Calculating...", "Please wait while all orders for " &amp; StartDate &amp; " to " &amp; EndDate &amp; " are totaled"
			
	'============================
			While Not (oDoc Is Nothing)
				If  oDoc.Created &gt;= Cdat(StartDate)  And oDoc.Created &lt;= Cdat(EndDate) Then
					purchCat = oDoc.FinCategory(0)
					If oDoc.ProjectSelection(0)=uidoc.FieldGetText("Project") And oDoc.BudgetCalculated(0) = "Yes" Then				
						Select Case purchCat
						Case "Operating"
							If oDoc.GSTExempt(0)="Yes" Then
								bOpTotal = bOpTotal + oDoc.TotCost(0)                       
							Else
								bOpTotal = bOpTotal + oDoc.TotCostTaxed(0)
							End If
						Case "Travel"
							If oDoc.GSTExempt(0)="Yes" Then
								bTravTotal = bTravTotal + oDoc.TotCost(0)                       
							Else
								bTravTotal = bTravTotal + oDoc.TotCostTaxed(0)
							End If
						Case "Contract"
							If oDoc.GSTExempt(0)="Yes" Then
								bConTotal = bConTotal + oDoc.TotCost(0)                       
							Else
								bConTotal = bConTotal + oDoc.TotCostTaxed(0)
							End If
						Case "Capital"
							If oDoc.GSTExempt(0)="Yes" Then
								bCapTotal = bCapTotal + oDoc.TotCost(0)                       
							Else
								bCapTotal = bCapTotal + oDoc.TotCostTaxed(0)
							End If
						End Select
						
					End If
				End If
				Set oDoc=dv.GetNextDocument(oDoc)
				NEMProgressSetText hwind, "Please wait...", Cstr(Round(i/dvc.Count, 0))
				NEMProgressSetBarPos hwnd, i
				i = i + 1
			Wend
killbar:
			NEMProgressEnd hwnd
			uidoc.EditMode=True
			Call	uidoc.FieldSetText("budgetOpTemp",Cstr(bOpTotal))
			Call	uidoc.FieldSetText("budgetTravTemp",Cstr(bTravTotal))
			Call	uidoc.FieldSetText("budgetContrTemp",Cstr(bConTotal))
			Call	uidoc.FieldSetText("budgetCapTemp",Cstr(bCapTotal))
			Call uidoc.Refresh
			Call ws.DialogBox("PopupBudget",True, True,True,True,True,True,"Custom Budget Calculation")
			uidoc.Save
			uidoc.EditMode=False
		Else 
			Messagebox "Operation Cancelled"
		End If
	Else
		Messagebox "Operation Cancelled"
	End If	
End Sub</lotusscript></code><code event='hidewhen'><formula>!(@Contains("[Admin]";@UserRoles))</formula></code></action>
<action title='Add New Employee To Orders'><code event='click'><lotusscript
>Sub Click(Source As Button)
	
	'/******************************************************
	'/  This button will add the name of the person specified 
	'/		by the user as Author ans Reader in all the Orders for the project.
	'/  This feature is useful for giving access to existing Orders.
	'/******************************************************
	
	Dim ws As New notesuiworkspace
	Dim uidoc As notesuidocument
	Dim s As New notessession
	Dim db As notesdatabase
	Dim dv As notesview
	Dim dc As notesdocumentcollection
	Dim doc As notesdocument
	Dim keys As String
	Dim thename As String
	Dim testNum As Integer
	Set db=s.CurrentDatabase
	Set uidoc=ws.CurrentDocument
	keys=uidoc.FieldGetText("Project")
	thename=Inputbox$("Please enter the name of the new employee as it appears in Lotus Notes:")
	
	Set dv=db.GetView("OrdTot2")
	Set dc=dv.GetAllDocumentsByKey(keys)
	Set doc=dc.GetFirstDocument
	testNum=0
	While Not(doc Is Nothing)
		testNum=testNum+1
		Set rdfield=doc.GetFirstItem("Readers")
		Set aufield=doc.GetFirstItem("Authors")
		Call rdfield.AppendToTextList(thename)
		Call aufield.AppendToTextList(thename)
		doc.Save True, True
		Set doc=dc.GetNextDocument(doc)
	Wend
	Messagebox "The new employee's name has been added to the order access list for this project." &amp; Cstr(testNum) &amp; " documents were modified."
	
End Sub</lotusscript></code><code event='hidewhen'><formula>@IsNewDoc</formula></code></action></actionbar>
<body><richtext>
<pardef id='1'/>
<par def='1'/>
<table widthtype='fitmargins' user4spacing='true' refwidth='5.0313in'><tablecolumn
 width='100%'/>
<tablerow>
<tablecell borderwidth='0px' bgcolor='navy'>
<pardef id='3' align='center' leftmargin='0%' rightmargin='100%' keepwithnext='true'
 keeptogether='true'/>
<par def='3'><run><font size='14pt' style='bold' color='white'/>Project Information</run></par>
<par def='3'><run><font size='14pt' style='bold' color='white'/></run><run
><font size='14pt' color='#e0f1ff' style='bold'/><field type='datetime' kind='editable'
 name='FiscalYearStart'><datetimeformat show='date' date='yearmonthday' fourdigityearfor21stcentury='true'
 zone='never' dateformat='yearmonthdayweekday' dayformat='twodigitday' monthformat='twodigitmonth'
 yearformat='fourdigityear' weekdayformat='shortname' dateseparator1='-' dateseparator2='-'
 dateseparator3=' ' timeseparator=':' preference='usersetting'/><code event='defaultvalue'><formula
>fyMonth := @Month(@Today);
fyYear := @Year(@Today);
@If(fyMonth=1|fyMonth=2|fyMonth=3;@Date(fyYear-1;4;1);@Date(fyYear;4;1))</formula></code></field></run><run
><font size='14pt' style='bold' color='white'/> - </run><run><font size='14pt'
 color='#e0f1ff' style='bold'/><field type='datetime' kind='editable' name='FiscalYearEnd'><datetimeformat
 show='date' date='yearmonthday' fourdigityearfor21stcentury='true' zone='never'
 dateformat='yearmonthdayweekday' dayformat='twodigitday' monthformat='twodigitmonth'
 yearformat='fourdigityear' weekdayformat='shortname' dateseparator1='-' dateseparator2='-'
 dateseparator3=' ' timeseparator=':' preference='usersetting'/><code event='defaultvalue'><formula
>fyMonth := @Month(@Today);
fyYear := @Year(@Today);
@If(fyMonth=1|fyMonth=2|fyMonth=3;@Date(fyYear;3;31);@Date(fyYear+1;3;31))</formula></code><code
 event='declarations'><lotusscript>Const NPB_STATUSBAR% = 1

Declare Sub NEMProgressEnd Lib "nnotesws.dll" ( Byval hwnd As Long )
Declare Function NEMProgressBegin Lib "nnotesws.dll" ( Byval wFlags As Integer ) As Long
Declare Sub NEMProgressSetBarPos Lib "nnotesws.dll" ( Byval hwnd As Long, Byval dwPos As Long)
Declare Sub NEMProgressSetBarRange Lib "nnotesws.dll" ( Byval hwnd As Long, Byval dwMax As Long )
Declare Sub NEMProgressSetText Lib "nnotesws.dll" ( Byval hwnd As Long, Byval pcszLine1 As String, Byval pcszLine2 As String )

</lotusscript></code><code event='exiting'><lotusscript>Sub Exiting(Source As Field)
	
	'======================
	' For the status bar
	On Error Goto killbar
	Dim hwnd As Long
	Dim i As Long
	'======================
	
	Dim ws As New notesuiworkspace
	Dim uidoc As notesuidocument
	Dim bOpTotal As Currency
	Dim bTravTotal As Currency
	Dim bConTotal As Currency
	Dim bCapTotal As Currency
	Dim purchCat As String
	
	Dim s As New notessession
	Dim db As notesdatabase
	Dim dv As notesview
	Dim dvc As notesviewentrycollection
	Dim oDoc As notesdocument
	
	bOpTotal = 0
	bTravTotal = 0
	bConTotal = 0
	bCapTotal = 0
	
	Set uidoc=ws.currentdocument
	Set db=s.CurrentDatabase
	Set dv=db.GetView("reflookup")
	Set dvc=dv.AllEntries
	Set oDoc = dv.GetFirstDocument
	'============================
	' Start the status bar
	i = 1
	''NEMProgressSetText hwnd, "Please wait...", "Recalculating budget..."
	''hwnd = NEMProgressBegin(NPB_STATUSBAR)
	''NEMProgressSetBarRange hwnd, dvc.Count
	''NEMProgressSetText hwnd, "Calculating...", "Please wait while all orders for " &amp; uidoc.FieldGetText("FiscalYearStart") &amp; " to " &amp; uidoc.FieldGetText("FiscalYearEnd") &amp; " are totaled"
	
	'============================
	Dim item As NotesItem
	Dim dtIssueDate As NotesDateTime
	Dim dtFYStart As NotesDateTime
	Dim dtFYEnd As NotesDateTime
	Set item = uidoc.Document.GetFirstItem( "FiscalYearStart" )
	Set dtFYStart = item.DateTimeValue
	Set item = uidoc.Document.GetFirstItem( "FiscalYearEnd" )
	Set dtFYEnd = item.DateTimeValue	
	
	While Not (oDoc Is Nothing)
		Set item = oDoc.GetFirstItem( "IssueDate" )
		Set dtIssueDate = item.DateTimeValue	
		
		'2009-05-21: JML: ADR#3550: the field "Created" was replaced with "IssueDate" becasue that date is not affected when copying documents from Prod to Dev
		'If oDoc.Created &gt;= uidoc.Document.FiscalYearStart(0) And oDoc.Created &lt;= uidoc.Document.FiscalYearEnd(0) Then
		If dtIssueDate.DateOnly &gt;= dtFYStart.DateOnly And dtIssueDate.DateOnly &lt;= dtFYEnd.DateOnly Then		
			purchCat = oDoc.FinCategory(0)
			If oDoc.ProjectSelection(0)=uidoc.FieldGetText("Project") And oDoc.BudgetCalculated(0) = "Yes" Then
				Select Case purchCat
				Case "Operating"
					If oDoc.GSTExempt(0)="Yes" Then
						bOpTotal = bOpTotal + oDoc.TotCost(0)                       
					Else
						bOpTotal = bOpTotal + oDoc.TotCostTaxed(0)
					End If
				Case "Travel"
					If oDoc.GSTExempt(0)="Yes" Then
						bTravTotal = bTravTotal + oDoc.TotCost(0)                       
					Else
						bTravTotal = bTravTotal + oDoc.TotCostTaxed(0)
					End If
				Case "Contract"
					If oDoc.GSTExempt(0)="Yes" Then
						bConTotal = bConTotal + oDoc.TotCost(0)                       
					Else
						bConTotal = bConTotal + oDoc.TotCostTaxed(0)
					End If
				Case "Capital"
					If oDoc.GSTExempt(0)="Yes" Then
						bCapTotal = bCapTotal + oDoc.TotCost(0)                       
					Else
						bCapTotal = bCapTotal + oDoc.TotCostTaxed(0)
					End If
				End Select
			End If
		End If
		Set oDoc=dv.GetNextDocument(oDoc)
		''NEMProgressSetText hwnd, "Calculating...", "Please wait while all orders for " &amp; uidoc.FieldGetText("FiscalYearStart") &amp; " to " &amp; uidoc.FieldGetText("FiscalYearEnd") &amp; " are processed. (" &amp; i &amp;"/" &amp;Cstr(dvc.Count)&amp;")"
		''NEMProgressSetBarPos hwnd, i
		i = i + 1
		
	Wend
	
	Call uidoc.FieldSetText("budgetOp_com",Cstr(bOpTotal))
	Call uidoc.FieldSetText("budgetTrav_com", Cstr(bTravTotal))
	Call uidoc.FieldSetText("budgetContr_com", Cstr(bConTotal))
	Call uidoc.FieldSetText("budgetCap_com", Cstr(bCapTotal))
killbar:
	''NEMProgressEnd hwnd
	
	' Use the Err function to return the error number and 
	' the Error$ function to return the error message.
	Messagebox "Error" &amp; Str(Err) &amp; ": " &amp; Error$
	
	uidoc.Refresh
End Sub</lotusscript></code></field></run><run><font size='14pt' style='bold'
 color='white'/></run></par></tablecell></tablerow></table>
