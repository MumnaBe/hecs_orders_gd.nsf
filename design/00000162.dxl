<trigger type='actionsmenu'/>
<documentset type='modified'/><code event='options'><lotusscript>Option Public

</lotusscript></code><code event='initialize'><lotusscript>Sub Initialize
	Dim s As New notessession
	Dim db As notesdatabase
	Dim v As notesview
	Dim doc As notesdocument
	Dim uidoc As notesuidocument
	Dim dc As notesview
	Dim projdoc As notesdocument
	Dim somevar As Variant
	Dim y, m As Integer
	Dim ref As Long
	Dim d As String
	Dim ws As New notesuiworkspace
	
	Set db = s.CurrentDatabase
	Set uidoc = ws.CurrentDocument
	Set v = db.Getview("AllLookup")
	Set doc = v.GetFirstDocument     
	Set dc = db.GetView("PV")
	
	If (doc Is Nothing) Then   ' there are no order documents in the database
		y = Year(Today())
		m = Month(Today())
		If (m = 1) Or (m = 2) Or (m = 3) Then   ' get number for last year since we are working with the fiscal year and not the calendar year
			y = y - 1
		End If               
		d = Right$(Cstr(y),2) &amp; "0001"
		Call uidoc.FieldSetText("RefNumber", d)
	Else
		somevar = doc.RefNumber
		If somevar(0) = "" Then somevar(0) = "0000"
		y = Year(Today())   ' get the current year (integer)
		m = Month(Today())
		If (m=1) Or (m=2) Or (m=3) Then
			y = y - 1
		End If
		d = Left$(Right$(somevar(0),6), 2)   ' get the year from the last order (string)
		If d = "" Then d = Right$(Cstr(y),2)
		If Cint(Right$(y,2)) = Cint(d) Then   ' if we're still in the same year
			ref = Clng(somevar(0)) + 1   ' then add one to the last order reference number
			Call uidoc.FieldSetText("RefNumber", Right$("00000"&amp;Cstr(ref),6))
		Else   ' the year has changed
			d = Right$(Cstr(y),2) &amp; "0001"   ' start a new count with for the new year
			Call uidoc.FieldSetText("RefNumber", d)
		End If
	End If       
End Sub</lotusscript></code>
