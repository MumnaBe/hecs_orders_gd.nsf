<action title='Re-Calculate Budget' icon='101'><code event='click'><lotusscript
>Sub Click(Source As Button)
	Dim ws As New notesuiworkspace
	Dim uidoc As notesuidocument
	Dim bOpTotal As Currency
	Dim bTravTotal As Currency
	Dim bConTotal As Currency
	Dim bCapTotal As Currency
	Dim purchCat As String
	
	Dim s As New notessession
	Dim db As notesdatabase
	Dim dv As notesview
	Dim oDoc As notesdocument
	
	bOpTotal = 0
	bTravTotal = 0
	bConTotal = 0
	bCapTotal = 0
	
	Set uidoc=ws.currentdocument
	Set db=s.CurrentDatabase
	Set dv=db.GetView("reflookup")
	Set oDoc = dv.GetFirstDocument
	While Not (oDoc Is Nothing)
		If oDoc.IssueDate(0) &gt;= uidoc.Document.FiscalYearStart(0) And oDoc.IssueDate(0) &lt;= uidoc.Document.FiscalYearEnd(0) Then
			purchCat = oDoc.FinCategory(0)
			If oDoc.ProjectSelection(0)=uidoc.FieldGetText("Project") And oDoc.BudgetCalculated(0) = "Yes" Then
				Select Case purchCat
				Case "Operating"
					If oDoc.GSTExempt(0)="Yes" Then
						bOpTotal = bOpTotal + oDoc.TotCost(0)                       
					Else
						bOpTotal = bOpTotal + oDoc.TotCostTaxed(0)
					End If
				Case "Travel"
					If oDoc.GSTExempt(0)="Yes" Then
						bTravTotal = bTravTotal + oDoc.TotCost(0)                       
					Else
						bTravTotal = bTravTotal + oDoc.TotCostTaxed(0)
					End If
				Case "Contract"
					If oDoc.GSTExempt(0)="Yes" Then
						bConTotal = bConTotal + oDoc.TotCost(0)                       
					Else
						bConTotal = bConTotal + oDoc.TotCostTaxed(0)
					End If
				Case "Capital"
					If oDoc.GSTExempt(0)="Yes" Then
						bCapTotal = bCapTotal + oDoc.TotCost(0)                       
					Else
						bCapTotal = bCapTotal + oDoc.TotCostTaxed(0)
					End If
				End Select
				
			End If
		End If
		Set oDoc=dv.GetNextDocument(oDoc)
		
	Wend
	Call uidoc.FieldSetText("budgetOp_com",Cstr(bOpTotal))
	Call uidoc.FieldSetText("budgetTrav_com", Cstr(bTravTotal))
	Call uidoc.FieldSetText("budgetContr_com", Cstr(bConTotal))
	Call uidoc.FieldSetText("budgetCap_com", Cstr(bCapTotal))
	uidoc.Refresh
	
End Sub</lotusscript></code><code event='hidewhen'><formula>!(@Contains("[Admin]";@UserRoles))|!@IsDocBeingEdited</formula></code></action>
<action title='Show Custom Calculation' icon='101'><code event='click'><lotusscript
>Sub Click(Source As Button)
	Dim ws As New notesuiworkspace
	Dim uidoc As notesuidocument
	Dim bOpTotal As Currency
	Dim bTravTotal As Currency
	Dim bConTotal As Currency
	Dim bCapTotal As Currency
	Dim purchCat As String
	
	Dim s As New notessession
	Dim db As notesdatabase
	Dim dv As notesview
	Dim oDoc As notesdocument
	Dim StartDate As notesdatetime
	Dim EndDate As notesdatetime
	
	bOpTotal = 0
	bTravTotal = 0
	bConTotal = 0
	bCapTotal = 0
	Set StartDate=ws.prompt(PROMPT_OKCANCELEDIT,"Start Date", "Enter a start date in the format YYYY-MM-DD")
	Set EndDate=ws.prompt(PROMPT_OKCANCELEDIT,"End Date", "Enter an end date in the format YYYY-MM-DD")
	Set uidoc=ws.currentdocument
	Set db=s.CurrentDatabase
	Set dv=db.GetView("reflookup")
	Set oDoc = dv.GetFirstDocument
	While Not (oDoc Is Nothing)
		If Cstr(oDoc.Created) &gt;= StartDate.DateOnly  And Cstr(oDoc.Created) &lt;= EndDate.DateOnly Then
			purchCat = oDoc.FinCategory(0)
			If oDoc.ProjectSelection(0)=uidoc.FieldGetText("Project") And oDoc.BudgetCalculated(0) = "Yes" Then
				Select Case purchCat
				Case "Operating"
					If oDoc.GSTExempt(0)="Yes" Then
						bOpTotal = bOpTotal + oDoc.TotCost(0)                       
					Else
						bOpTotal = bOpTotal + oDoc.TotCostTaxed(0)
					End If
				Case "Travel"
					If oDoc.GSTExempt(0)="Yes" Then
						bTravTotal = bTravTotal + oDoc.TotCost(0)                       
					Else
						bTravTotal = bTravTotal + oDoc.TotCostTaxed(0)
					End If
				Case "Contract"
					If oDoc.GSTExempt(0)="Yes" Then
						bConTotal = bConTotal + oDoc.TotCost(0)                       
					Else
						bConTotal = bConTotal + oDoc.TotCostTaxed(0)
					End If
				Case "Capital"
					If oDoc.GSTExempt(0)="Yes" Then
						bCapTotal = bCapTotal + oDoc.TotCost(0)                       
					Else
						bCapTotal = bCapTotal + oDoc.TotCostTaxed(0)
					End If
				End Select
				
			End If
		End If
		Set oDoc=dv.GetNextDocument(oDoc)
		
	Wend
	Call uidoc.FieldSetText("budgetOpTemp",Cstr(bOpTotal))
	Call uidoc.FieldSetText("budgetTravTemp", Cstr(bTravTotal))
	Call uidoc.FieldSetText("budgetContrTemp", Cstr(bConTotal))
	Call uidoc.FieldSetText("budgetCapTemp", Cstr(bCapTotal))
	Call ws.DialogBox("PopupBudget",True, True,True,True,True,True,"Custom Budget Calculation")
	
End Sub</lotusscript></code><code event='hidewhen'><formula>!(@Contains("[Admin]";@UserRoles))|!@IsDocBeingEdited</formula></code></action>
<action title='Add New Employee To Orders'><code event='click'><lotusscript
>Sub Click(Source As Button)
	
	Dim ws As New notesuiworkspace
	Dim uidoc As notesuidocument
	Dim s As New notessession
	Dim db As notesdatabase
	Dim dv As notesview
	Dim dc As notesdocumentcollection
	Dim doc As notesdocument
	Dim keys As String
	Dim thename As String
	Dim testNum As Integer
	Set db=s.CurrentDatabase
	Set uidoc=ws.CurrentDocument
	keys=uidoc.FieldGetText("Project")
	thename=Inputbox$("Please enter the name of the new employee as it appears in Lotus Notes:")
	
	Set dv=db.GetView("OrdTot2")
	Set dc=dv.GetAllDocumentsByKey(keys)
	Set doc=dc.GetFirstDocument
	testNum=0
	While Not(doc Is Nothing)
		testNum=testNum+1
		Set rdfield=doc.GetFirstItem("Readers")
		Set aufield=doc.GetFirstItem("Authors")
		Call rdfield.AppendToTextList(thename)
		Call aufield.AppendToTextList(thename)
		doc.Save True, True
		Set doc=dc.GetNextDocument(doc)
	Wend
	Messagebox "The new employee's name has been added to the order access list for this project." &amp; Cstr(testNum) &amp; " documents were modified."
	
End Sub</lotusscript></code><code event='hidewhen'><formula>@IsNewDoc</formula></code></action></actionbar>
