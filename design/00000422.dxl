<column hidedetailrows='false' itemname='$14' width='58.7500' resizable='true'
 separatemultiplevalues='false' sortnoaccent='false' sortnocase='true' showaslinks='false'><columnheader
 title='Information'><font size='9pt' style='bold'/></columnheader><code event='value'><formula
>@If(
  form = "SoftDeleteNewOrderForm";
    @If(@Length(RefNumber)=8;@Left(d_RefNumber;@Length(d_RefNumber)-8)+@Right(RefNumber;6);d_RefNumber) + ", Préparé le: " + @Text(IssueDate) + ", " + ", Commandé par: " +@Name([CN]; ShipTo) + ", Nom du projet: " + ProjectSelection + ", Code Financier: " + FinCode;
  form = "SoftDeleteProject";
    Project;
  form = "SoftDeleteCardHolders";
    @Name([CN]; CardholderName);
  form = "SoftDeleteLookup";
    LookupType + ", " + EKeyword;
  form = "SoftDeleteCost1";
    Type + ", " + Name;
  form = "SoftDeleteCost2";
    CodeNumber + ", " + GLAccount + ", " + ProgActiv + ", " + IntOrd;
  "")</formula></code></column>
