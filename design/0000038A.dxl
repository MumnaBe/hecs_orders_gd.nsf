<action title='Mail to Admin' icon='3' hide='preview read'><code event='click'><formula
>FIELD SaveOptions := SaveOptions;
FIELD Sent := Sent;
FIELD Status := Status;
FIELD OrderComments := OrderComments;

REM{2009-06-16: JML: ADR 3550: a condition was added to prevent the unsaved orders to be mailed to the admin when the validation does not pass.  This was causing Variable not set errors.};
@If(@IsNewDoc;
  @Do(
    @Prompt([Ok]; "Operation cancelled"; "Please save the Order and try again");
    @Return(""));
  "");

@SetField("SaveOptions"; "1");
@SetField("Sent"; "Yes");
@SetField("Status"; "Submitted");
@DialogBox("CommentsDialog";[AutoHorzFit]:[AutoVertFit]:[NoNewFields];"Comments");
@PostedCommand([FileSave]);
@PostedCommand([FileCloseWindow]);
@MailSend(SendTo;"";"";"HECS Orders/commandes de SESC";"";"HECS Order form....Please follow the link below." + @NewLine + @NewLine + "Comments/Commentaires: " + OrderComments + @NewLine + @NewLine + "commandes de SESC....SVP suivre ce lien ---&gt; " ;[IncludeDoclink]);
@Prompt([Ok];"Confirmation";"Your order form has been sent to the Administrator "+ SendTo)</formula></code><code
 event='hidewhen'><formula>@Environment("HECS_Language") = "F"|FinCode="" | Status = "Cancelled"
| Status = "Reconciled"</formula></code></action>
