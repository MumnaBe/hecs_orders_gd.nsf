<par def='1'><run><font size='8pt' color='red'/><field type='number' kind='computed'
 name='TrackOriginalCost'><numberformat format='currency' digits='2' punctuated='false'
 parens='false' percent='false' bytes='false'/><code event='defaultvalue'><formula
>@If(@IsNewDoc; 0; TrackOriginalCost)</formula></code></field></run><run><font
 size='8pt' color='red'/><field type='text' kind='computed' name='itemsReceived'><code
 event='defaultvalue'><formula>REM{2009-06-30: ADR 3550: JML added this field to track the partial orders.};
REM{This field will detect if the Order has been partially received};
REM{If the field's value is /Partially Received/, then it is partially received};
REM{If the field's value is /Received/, then all items are received};
REM{If the field's value is /None Received/, then no items are received};

REM{Check each item to see if they were received or not};
item1 := @If(
  i1Quant != 0 &amp; Rec1 = "Received"; "yReceived";
  i1Quant != 0 &amp; Rec1 != "Received"; "xNot Received";
  "Not Ordered");
item2 := @If(
  i2Quant != 0 &amp; Rec2 = "Received"; "yReceived";
  i2Quant != 0 &amp; Rec2 != "Received"; "xNot Received";
  "Not Ordered");
item3 := @If(
  i3Quant != 0 &amp; Rec3 = "Received"; "yReceived";
  i3Quant != 0 &amp; Rec3 != "Received"; "xNot Received";
  "Not Ordered");
item4 := @If(
  i4Quant != 0 &amp; Rec4 = "Received"; "yReceived";
  i4Quant != 0 &amp; Rec4 != "Received"; "xNot Received";
  "Not Ordered");
item5 := @If(
  i5Quant != 0 &amp; Rec5 = "Received"; "yReceived";
  i5Quant != 0 &amp; Rec5 != "Received"; "xNot Received";
  "Not Ordered");
item6 := @If(
  i6Quant != 0 &amp; Rec6 = "Received"; "yReceived";
  i6Quant != 0 &amp; Rec6 != "Received"; "xNot Received";
  "Not Ordered");
item7 := @If(
  i7Quant != 0 &amp; Rec7 = "Received"; "yReceived";
  i7Quant != 0 &amp; Rec7 != "Received"; "xNot Received";
  "Not Ordered");
item8 := @If(
  i8Quant != 0 &amp; Rec8 = "Received"; "yReceived";
  i8Quant != 0 &amp; Rec8 != "Received"; "xNot Received";
  "Not Ordered");
item9 := @If(
  i9Quant != 0 &amp; Rec9 = "Received"; "yReceived";
  i9Quant != 0 &amp; Rec9 != "Received"; "xNot Received";
  "Not Ordered");
item10 := @If(
  i10Quant != 0 &amp; Rec10 = "Received"; "yReceived";
  i10Quant != 0 &amp; Rec10 != "Received"; "xNot Received";
  "Not Ordered");
item11 := @If(
  i11Quant != 0 &amp; Rec11 = "Received"; "yReceived";
  i11Quant != 0 &amp; Rec11 != "Received"; "xNot Received";
  "Not Ordered");
item12 := @If(
  i12Quant != 0 &amp; Rec12 = "Received"; "yReceived";
  i12Quant != 0 &amp; Rec12 != "Received"; "xNot Received";
  "Not Ordered");
item13 := @If(
  i13Quant != 0 &amp; Rec13 = "Received"; "yReceived";
  i13Quant != 0 &amp; Rec13 != "Received"; "xNot Received";
  "Not Ordered");
item14 := @If(
  i14Quant != 0 &amp; Rec14 = "Received"; "yReceived";
  i14Quant != 0 &amp; Rec14 != "Received"; "xNot Received";
  "Not Ordered");
item15 := @If(
  i15Quant != 0 &amp; Rec15 = "Received"; "yReceived";
  i15Quant != 0 &amp; Rec15 != "Received"; "xNot Received";
  "Not Ordered");
item16 := @If(
  i16Quant != 0 &amp; Rec16 = "Received"; "yReceived";
  i16Quant != 0 &amp; Rec16 != "Received"; "xNot Received";
  "Not Ordered");
item17 := @If(
  i17Quant != 0 &amp; Rec17 = "Received"; "yReceived";
  i17Quant != 0 &amp; Rec17 != "Received"; "xNot Received";
  "Not Ordered");
item18 := @If(
  i18Quant != 0 &amp; Rec18 = "Received"; "yReceived";
  i18Quant != 0 &amp; Rec18 != "Received"; "xNot Received";
  "Not Ordered");
item19 := @If(
  i19Quant != 0 &amp; Rec19 = "Received"; "yReceived";
  i19Quant != 0 &amp; Rec19 != "Received"; "xNot Received";
  "Not Ordered");
item20 := @If(
  i20Quant != 0 &amp; Rec20 = "Received"; "yReceived";
  i20Quant != 0 &amp; Rec20 != "Received"; "xNot Received";
  "Not Ordered");

REM{eliminate duplicate results};
results := @Unique(item1 : item2 : item3 : item4 : item5 : item6 : item7 : item8 : item9 : item10 : item11 : item12 : item13 : item14 : item15 : item16 : item17 : item18 : item19 : item20);

REM{Check the received status};
receivedStatus := @If(
  @Contains(results; "xNot Received") &amp; !@Contains(results; "yReceived"); "None Received";
  @Contains(results; "yReceived") &amp; !@Contains(results; "xNot Received"); "Received";
  @Contains(results; "yReceived") &amp; @Contains(results; "xNot Received"); "Partially Received";
   "");

REM{Update the order's status if needed};
@If(
  Status = "On Order" &amp; receivedStatus = "Partially Received";
    @SetField("Status"; "Partially Received");
  Status = "On Order" &amp; receivedStatus = "Received";
    @SetField("Status"; "Received");
  Status = "Partially Received" &amp; receivedStatus = "None Received";
    @SetField("Status"; "On Order");
  Status = "Partially Received" &amp; receivedStatus = "Received";
    @SetField("Status"; "Received");
  Status = "Received" &amp; receivedStatus = "None Received";
    @SetField("Status"; "On Order");
  Status = "Received" &amp; receivedStatus = "Partially Received";
    @SetField("Status"; "Partially Received");
  "");

receivedStatus</formula></code></field></run></par>
