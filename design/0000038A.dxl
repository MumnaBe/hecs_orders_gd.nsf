 name='Currency'><keywords columns='1' ui='dialoglist'><formula>REM{Old hardcoded choices remved in 2009-06-30: CAD, USD, GBP, EUR};

kwEng := @DbLookup(""; ""; "KeywordLookup"; "Currency"; 2);
kwFre := @DbLookup(""; ""; "KeywordLookup"; "Currency"; 3);

@If(@IsError(kwEng) | @IsError(kwFre); "Error, please contact the administrator / Erreur, veuillez contacter l'administrateur"; kwEng)</formula></keywords></field></par>
