 name='dispStatus'><code event='defaultvalue'><formula>@If(@Environment("HECS_Language") = "E"; "Status: " + Status; "Cheminement : " + @Replace(Status;"New":"Submitted":"On Order":"Received":"Reconciled":"Cancelled": "Partially Received";"Nouveau":"Présenté":"Commandé":"Reçu":"Reconcilié":"Annulé": "Partiellement reçu"))</formula></code></field></run></par>
