<action title='Generate Financial Code' icon='109' hide='preview read'><code
 event='click'><lotusscript>Sub Click(Source As Button)
	Dim ws As New notesuiworkspace
	Dim uidoc As notesuidocument
	Dim doc As notesdocument
	Dim boolResult As Variant
	Dim testnum As Integer
	
	Set uidoc=ws.CurrentDocument
	Set doc=uidoc.Document
	testnum=0
	boolResult=ws.DialogBox("CCForm", True, True, False, False, False, False, "Financial Codes")
	While testnum = 0
'		If boolResult = True And (uidoc.FieldGetText("PAC")="0000" Or uidoc.FieldGetText("PC")="0000" Or uidoc.FieldGetText("GLAC")="0000" Or uidoc.FieldGetText("FSC")="0000") Then
		If boolResult = True And (doc.PAC(0)="0000" Or doc.PC(0)="0000" Or doc.GLAC(0)="0000" Or doc.FSC(0)="0000") Then		
			Messagebox "Incorrect Financial Code"
			boolResult=ws.DialogBox("CCForm", True, True, False, False, False, False, "Financial Codes")
		Elseif boolResult = False Then		
			testnum=1
		Else
			testnum=2
		End If
	Wend
	If testnum=2 Then 
		Call uidoc.FieldSetText("FinCode", uidoc.FieldGetText("CompleteFinancialCode"))
		Call uidoc.FieldSetText("FinCategory", uidoc.FieldGetText("Category"))
		If Not ( uidoc.FieldGetText("ProjectSelection") = uidoc.FieldGetText("LastProjectSelected")) Then
			Call uidoc.FieldSetText("LastProjectSelected", uidoc.FieldGetText("ProjectSelection"))
		End If
	End If
	
End Sub</lotusscript></code><code event='hidewhen'><formula>@Environment("HECS_Language") = "F"|ProjectSelection="--Please select a project--" | Status = "Cancelled" | Status = "Reconciled"</formula></code></action>
<action title='Générer Code Financier' icon='109' hide='preview read'><code
 event='click'><lotusscript>Sub Click(Source As Button)
	Dim ws As New notesuiworkspace
	Dim uidoc As notesuidocument
	Dim doc As notesdocument
	Dim boolResult As Variant
	Dim testnum As Integer
	
	Set uidoc=ws.CurrentDocument
	Set doc=uidoc.Document
	testnum=0
	boolResult=ws.DialogBox("CCForm", True, True, False, False, False, False, "Code financier")
	While testnum = 0
'		If boolResult = True And (uidoc.FieldGetText("PAC")="0000" Or uidoc.FieldGetText("PC")="0000" Or uidoc.FieldGetText("GLAC")="0000" Or uidoc.FieldGetText("FSC")="0000") Then
		If boolResult = True And (doc.PAC(0)="0000" Or doc.PC(0)="0000" Or doc.GLAC(0)="0000" Or doc.FSC(0)="0000") Then		
			Messagebox "Veuillez choisir un code financier complet."
			boolResult=ws.DialogBox("CCForm", True, True, False, False, False, False, "Code Financier")
		Elseif boolResult = False Then		
			testnum=1
		Else
			testnum=2
		End If
	Wend
	If testnum=2 Then 
		Call uidoc.FieldSetText("FinCode", uidoc.FieldGetText("CompleteFinancialCode"))
		Call uidoc.FieldSetText("FinCategory", uidoc.FieldGetText("Category"))
		If Not ( uidoc.FieldGetText("ProjectSelection") = uidoc.FieldGetText("LastProjectSelected")) Then
			Call uidoc.FieldSetText("LastProjectSelected", uidoc.FieldGetText("ProjectSelection"))
		End If
	End If
	
End Sub</lotusscript></code><code event='hidewhen'><formula>@Environment("HECS_Language") = "E"|ProjectSelection="--Please select a project--" | Status = "Cancelled"  | Status = "Reconciled"</formula></code></action>
<action title='Save' icon='42' showinmenu='false' hide='preview read'><code
 event='click'><formula>FIELD Status := Status;
FIELD FinCode := FinCode;
FIELD FinCategory := FinCategory;
FIELD ProjectSelection := ProjectSelection;
FIELD LastProjectSelected := LastProjectSelected;
@If(FinCode="";@DialogBox( "CCForm";[AutoHorzFit]:[AutoVertFit]:[NoNewFields]; "Financial Codes" );ProjectSelection != LastProjectSelected;@DialogBox( "CCForm";[AutoHorzFit]:[AutoVertFit]:[NoNewFields]; "Financial Codes" );"");
@If(ProjectSelection != LastProjectSelected;@SetField("LastProjectSelected";ProjectSelection);"");
@SetField("FinCode";CompleteFinancialCode);
@SetField("FinCategory"; Category);
@Command([ToolsRunMacro];"SendMessage");
@PostedCommand([FileSave])</formula></code><code event='hidewhen'><formula
>@Environment("HECS_Language") = "F" | Status = "Cancelled"</formula></code></action>
<action title='Sauvegarder' icon='42' showinmenu='false' hide='preview read'><code
 event='click'><formula>FIELD Status := Status;
FIELD FinCode := FinCode;
FIELD FinCategory := FinCategory;
FIELD ProjectSelection := ProjectSelection;
FIELD LastProjectSelected := LastProjectSelected;
@If(FinCode="";@DialogBox( "CCForm";[AutoHorzFit]:[AutoVertFit]:[NoNewFields]; "Financial Codes" );ProjectSelection != LastProjectSelected;@DialogBox( "CCForm";[AutoHorzFit]:[AutoVertFit]:[NoNewFields]; "Financial Codes" );"");
@If(ProjectSelection != LastProjectSelected;@SetField("LastProjectSelected";ProjectSelection);"");
@SetField("FinCode";CompleteFinancialCode);
@SetField("FinCategory"; Category);

REM{2009-05-19: JML: ADR #3550: the SendMessage line was added because it was in English but not in French.};
@Command([ToolsRunMacro];"SendMessage");

@PostedCommand([FileSave])</formula></code><code event='hidewhen'><formula
>@Environment("HECS_Language") = "E" | Status = "Cancelled"</formula></code></action>
