<action title='Cancel Order' icon='11' showinmenu='false'><code event='click'><formula
>@Command( [EditDocument]; "1" );
FIELD SaveOptions := SaveOptions;
FIELD Status := Status;
FIELD BudgetCalculated := BudgetCalculated;
@SetField("SaveOptions"; "1");
@SetField("Status"; "Cancelled");

REM{Start - 2009-05-15: JML: ADR#3550: the following line was modified to reset the BudgetCalculated flag and to add the message boxes};
REM{@If(BudgetCalculated="Yes";@Command([ToolsRunMacro];"ReCalculateThisBudget");"");};
@If(BudgetCalculated="Yes";
  @Do(
    @Command([ToolsRunMacro];"RecalculateThisBudget");
    @SetField("BudgetCalculated"; "No");
    @Prompt([Ok];"Cancelling Order";"The committed amount for the project have been adjusted")
