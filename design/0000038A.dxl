@PostedCommand([FileSave]);

REM{Send the confirmation and warning emails};
@PostedCommand([ToolsRunMacro];"ConfirmReceipt");
@PostedCommand([FileSave]);

@PostedCommand([FileCloseWindow])</formula></code><code event='hidewhen'><formula
