<trigger type='agentlist'/>
<documentset type='all'/><code event='options'><lotusscript>Option Public

</lotusscript></code><code event='initialize'><lotusscript>Sub Initialize
	
	'/**************************************************************************************
	'/ Agent created on 2009-06-10: by JML: for ADR 3550
 	'/ This agent is called from the "Reconciled" button on the NewOrderForm.
	'/ The goal to increase the Remaining Credit on the Visa and MasterCard
	'/
	'/**************************************************************************************
	
	On Error Goto handleError
	
	Dim ws As New notesuiworkspace
	Dim doc As notesdocument
	Dim uidoc As notesuidocument
	Dim s As New notessession
	Dim db As notesdatabase
	Dim oDoc As notesdocument
	Dim orderamount As Variant	
	Dim purchasetype As String
	
	Dim carddv As notesview
	Dim Carddoc As notesdocument
	Dim namekey(1 To 2) As String
	
	' Get a handle on the Project document
	Set uidoc=ws.currentdocument
	Set db=s.CurrentDatabase
	Set oDoc=uidoc.Document  ' Get a handle on the current Order document.
	
	' It the purchase type is Visa or MasterCard then increase the Remaining Credit on the Credit Card using the TotCostTaxed amount
	purchasetype = oDoc.PurchaseType(0)	
	If Not (purchasetype="Purchase Order") Then
		
		Set carddv = db.GetView("CHL")   ' getting the card holder lookup view             
		cardholdername = oDoc.CardHolder(0)   ' get the value of the card holder field from the order document
		orderamount = Ccur(oDoc.TotCostTaxed(0))  ' the field TotCostTaxed take in consideration the Custom, Exchange Rate, GST and GST Exemption.
		
		namekey(1) = purchasetype
		namekey(2) = cardholdername
		Set Carddoc = carddv.GetDocumentByKey(namekey)    ' according to the value of purchase type and card holder name, get the correct cardholder document from the card holder view
		If Not (Carddoc Is Nothing) Then				
			Select Case purchasetype
			Case "MasterCard"
				Carddoc.RemCreditM = Carddoc.RemCreditM(0) + orderamount   ' add the order amount from the remaining credit
			Case "VISA"
				Carddoc.RemCreditV = Carddoc.RemCreditV(0) + orderamount   ' add the order amount from the remaining credit
			End Select
			Carddoc.Save True, False
		End If
	End If
	
	Exit Sub
	
handleError:
	Messagebox "Error: " &amp; Str(Err) &amp; ": " &amp; Error$
	Exit Sub
	
End Sub</lotusscript></code>
