<wassignedby><name>CN=HC-R_AGENT-SC/OU=HC-SC/O=GC/C=CA</name></wassignedby>
<globals><code event='options'><lotusscript>Option Public
Use "AddressFill"
Use "LimitChecks"

</lotusscript></code><code event='declarations'><lotusscript>






</lotusscript></code></globals><code event='windowtitle'><formula>@If(@IsNewDoc;"New Order";"Order Number: " + RefNumber)</formula></code><code
 event='querysave'><lotusscript>Sub Querysave(Source As Notesuidocument, Continue As Variant)
	
	Dim s As New notessession
	Dim db As notesdatabase
	Dim dv As notesview
	Dim dv2 As notesview
	Dim doc2 As notesdocument
	Dim doc As NotesDocument
	Dim documentCounter As Integer
	Dim projName As String	
	Dim projdoc As notesdocument	
	Dim status As String
	Dim itemReceivedStatus As String
	Dim answer As Integer
	Dim category As String
	Dim currentPurchasetype As String
	Dim originalPurchasetype As String	
	Dim projectname As String	
	Dim language As String
	Dim carddv As notesview
	Dim CarddocCurr As notesdocument
	Dim CarddocOriginal As notesdocument
	Dim namekey(1 To 2) As String
	Dim originalCost As Currency
	Dim currentCost As Currency
	Dim costDifference As Currency
	
     ' Field Validation
	If Source.FieldGetText("ProjectSelection")="" Then 
		Messagebox "A Project must be selected." &amp; Chr(10) &amp; Chr(10) &amp; "Veuillez sélectionner un projet."
		continue = False
	Elseif Source.FieldGetText("FinCode")="" Then
		Messagebox "A financial code is needed for this order. Press the 'Generate Financial Code' button in the action bar above." &amp; Chr(10) &amp; Chr(10) &amp; _
		"Un code financier est nécessaire pour cette commande. Veuiller cliquer sur le bouton `Générer Code Financier`"
		continue = False  
	Elseif Source.FieldGetText("PurchaseType") = "" Then
		Messagebox "Please select a purchase type."&amp;Chr(10) &amp; Chr(10) &amp; "Veuillez sélectionner un Type d\'achat"
		continue = False
	Elseif Source.FieldGetText("CardHolder") = "" And Source.FieldGetText("SignAuth") = "" Then
		Messagebox "Please select a card holder/signing authority." &amp; Chr(10) &amp; Chr(10) &amp; "Veuillez sélectionner un détenteur de carte/pouvoir de signature."
		continue = False
	Elseif Source.FieldGetText("ShipTo") = "" Or Source.FieldGetText("InvName")="" Then
		Messagebox "Please ensure that shipping/billing information is complete." &amp; Chr(10) &amp; Chr(10) &amp; "Assurez-vous que la commande est complète"
		continue = False
	Elseif Source.FieldGetText("Floor") = "" Then
		Messagebox "Please ensure that floor information is entered." &amp; Chr(10) &amp; Chr(10) &amp; "Assurez-vous que l'information de l'étage est entrée"
		Call Source.GotoField("Floor")			
		continue = False
		Exit Sub
	Elseif Source.FieldGetText("Room") = "" Then
		Messagebox "Please ensure that room information is entered." &amp; Chr(10) &amp; Chr(10) &amp; "Assurez-vous que l'information de la pièce est entrée"
		Call Source.GotoField("Room")		
		continue = False
		Exit Sub
		Elseif Source.FieldGetText("CompanyName")="" Or Source.FieldGetText("CompPhone")="" Or _
	Source.FieldGetText("CompFax")="" Then
		Messagebox "Please ensure that company information is complete (Name, Phone, and Fax)."  &amp; Chr(10) &amp; Chr(10) &amp; "Veuillez sélectionner une compagnie (nom, téléphone et fax)."
		continue = False
	End If     
	
     ' Sets the readers and authors fields.
     ' This is done to limit documents to the Manager, PI, Employees of specific documents, as well as the Admin person responsible for placing orders
     ' If uidoc.IsnewDoc Then
     ' End If
	
	' 2009-07-21: ADR 3550: JML added this Refresh to make sure the Order's amount is recalculated 
	'before the budget and credit limits are verified. Otherwise the limit could be calculated using the old cost
	Source.Refresh
	
	Set doc=Source.Document
	status = source.FieldGetText("status")
	If Not(doc.SendWarning(0)="Sent" Or doc.SendWarning2(0)="Sent") And (status = "Submitted" Or status = "New")  Then
		Call BudgetLimit
		Call CreditCardLimit
	End If
	
	Call Source.FieldSetText("SaveOptions", "1")
	
	Source.Refresh
	Source.RefreshHideFormulas        
	
	' 2009-06-11: JML: ADR 3550: to handle cases where the CTRL-S is used before _
	' choosing a Project Name, the following exit has been created.	 Otherwise it was _
	' Generating a variable not found error with projdoc.
	If continue = False Then
		Exit Sub
	End If
	
	Set db=s.CurrentDatabase
	Set dv=db.GetView("PLV")
	Set dv2=db.GetView("KeywordLookup")
	Set doc2=dv2.GetDocumentByKey("SendToAdmin")
	
	projName=doc.ProjectSelection(0)
	Set projdoc=dv.GetDocumentByKey(projName)
	
	If projdoc Is Nothing Then
		' The project could not be found.  Its either a missing document or th eproject has been renamed.
		answer% = Messagebox( "The project " &amp; projName &amp; " could not be found.  Please contact the administrator.  The changes will not be saved.   Le projet " &amp; projName &amp; " n'a pas été trouvé.  Veuillez contacter l'administrateur. Les changements ne seront pas sauvegardés" , 0+16, "Operation Cancelled / Opération annulée" )					
		continue = False
		Exit Sub
	Else
		doc.ReplaceItemValue "Authors", "LNOG_HECS"
		doc.ReplaceItemValue "Readers", "LNOG_HECS"
		Source.Reload
		Set authorItem=doc.GetFirstItem("Authors")
		Set readerItem=doc.GetFirstItem("Readers")
		
		authorItem.AppendToTextList(doc2.EKeyWord(0))
		readerItem.AppendToTextList(doc2.EKeyWord(0))
		authorItem.AppendToTextList(db.Server)
		readerItem.AppendToTextList(db.Server)
		authorItem.AppendToTextList(projdoc.PI(0))
		readerItem.AppendToTextList(projdoc.PI(0))
		authorItem.AppendToTextList(projdoc.Manager(0))
		readerItem.AppendToTextList(projdoc.Manager(0))
		authorItem.AppendToTextList("[Admin]")
		readerItem.AppendToTextList("[Admin]")
		authorItem.AppendToTextList("[LNOG Admin]")
		readerItem.AppendToTextList("[LNOG Admin]")
		Forall x In projdoc.Employees
			If doc.Status(0)="New" Then
				authorItem.AppendToTextList(x)
			End If
			readerItem.AppendToTextList(x)
		End Forall		
	End If
	
	' /*******Track changes to the order's cost
	
	' Rules
	' 1. OriginalCost has changed
		' 1.1. OriginalPurchase Type has changed
			' 1.1.1. Original Purchase Type is "VISA"
				' 1.1.1.1. Current Purchase Type is "MasterCard"
					' 1.1.1.1.1. OriginalCard Holder has changed
						' Task: Increase the Remaining Credit on the VISA belonging to the original Card Holder using the original order's cost
						' Task: Reduce the Remaining Credit on the MasterCard belonging to the current Card Holder using the new order's cost
					' 1.1.1.1.2. OriginalCard Holder has not changed
						' Task: Increase the Remaining Credit on the VISA belonging to the original Card Holder using the original order's cost
						' Task: Reduce the Remaining Credit on the MasterCard belonging to the original Card Holder using the new order's cost
				' 1.1.1.2. Current Purchase Type is "Purchase Order"
					' Task: Increase the Remaining Credit on the VISA belonging to the original Card Holder using the original order's cost	
			' 1.1.2. OriginalPurchase Type is "MasterCard"
				' 1.1.2.1. Current Purchase Type is "VISA"
					' 1.1.2.1.1. OriginalCard Holder has changed
						' Task: Increase the Remaining Credit on the MasterCard belonging to the original Card Holder using the original order's cost
						' Task: Reduce the Remaining Credit on the VISA belonging to the current Card Holder using the new order's cost
					' 1.1.2.1.2. OriginalCard Holder has not changed
						' Task: Increase the Remaining Credit on the MasterCard belonging to the original Card Holder using the original order's cost
						' Task: Reduce the Remaining Credit on the VISA belonging to the current Card Holder using the new order's cost
				' 1.1.2.2. Current Purchase Type is "Purchase Order"
					' Task: Increase the Remaining Credit on the MasterCard belonging to the original Card Holder using the original order's cost	
			' 1.1.3. OriginalPurchase Type is "Purchase Order"	
				' 1.1.3.1. Current Purchase Type is "MasterCard"
					' Task: Reduce the Remaining Credit on the MasterCard belonging to the current Card Holder using the new order's cost
				' 1.1.3.2. Current Purchase Type is "VISA"
					' Task: Reduce the Remaining Credit on the VISA belonging to the current Card Holder using the new order's cost
		' 1.2. OriginalPurchase Type has not changed
			' 1.2.1. OriginalPurchase Type is "VISA"
				' 1.2.1.1. OriginalCard Holder has changed
					' Task: Increase the Remaining Credit on the original "VISA" Card Holder's Credit Card using the original order's cost
					' Task: Reduce the Remaining Credit on the current "VISA" Card Holder's Credit Card using the new order's cost
				' 1.2.1.2. OriginalCard Holder has not changed
					' Task: Update the Remaining Credit on the original "VISA"
			' 1.2.2. OriginalPurchase Type is "MasterCard"
				' 1.2.2.1. OriginalCard Holder has changed
					' Task: Increase the Remaining Credit on the original "MasterCard" Card Holder's Credit Card using the original order's cost
					' Task: Reduce the Remaining Credit on the current "MasterCard" Card Holder's Credit Card using the new order's cost
				' 1.2.2.2. OriginalCard Holder has not changed
					' Task: Update the Remaining Credit on the original "MasterCard"
			' 1.2.3. OriginalPurchase Type is "Purchase Order"
				' Task: nil, we do not care about these changes of signing authorities
	' 2. OriginalCost has not changed
		' 2.1. OriginalPurchase Type has changed
			' 2.1.1. Original Purchase Type is "VISA"
				' 2.1.1.1. Current Purchase Type is "MasterCard"
					' Task: Increase the Remaining Credit on the original VISA Card Holder's Credit Card using the original order's cost
					' Task: Reduce the Remaining Credit on the current MasterCard Card Holder's Credit Card using the current order's cost	
				' 2.1.1.2. Current Purchase Type is "Purchase Type"
					' Task: Increase the Remaining Credit on the original VISA Card Holder's Credit Card using the original order's cost
			' 2.1.2. OriginalPurchase Type is "MasterCard"
				' 2.1.2.1. Current Purchase Type is "Visa"
					' Task: Increase the Remaining Credit on the original MasterCard Card Holder's Credit Card using the original order's cost
					' Task: Reduce the Remaining Credit on the current VISA Card Holder's Credit Card using the current order's cost	
				' 2.1.2.2. Current Purchase Type is "Purchase Type"
					' Task: Increase the Remaining Credit on the original MasterCard Card Holder's Credit Card using the original order's cost
			' 2.1.3. OriginalPurchase Type is "Purchase Order"
				' 2.1.3.1. Current Purchase Type is "MasterCard"
					' Task: Reduce the Remaining Credit on the current MasterCard Card Holder's Credit Card using the current order's cost	
				' 2.1.3.1. Current Purchase Type is "Visa"
					' Task: Reduce the Remaining Credit on the current VISA Card Holder's Credit Card using the current order's cost	
		' 2.2. OriginalPurchase Type has not changed
			' 2.2.1. OriginalPurchase Type is "VISA"
				' 2.2.1.1. OriginalCard Holder has changed
					' Task: Increase the Remaining Credit on the original VISA Card Holder's Credit Card using the original order's cost
					' Task: Reduce the Remaining Credit on the current VISA Card Holder's Credit Card using the current order's cost
				' 2.2.1.2. OriginalCard Holder has not changed
					' Task: nothing to do
			' 2.2.2. OriginalPurchase Type is "MasterCard"
				' 2.2.2.1. OriginalCard Holder has changed
					' Task: Increase the Remaining Credit on the original MasterCard Card Holder's Credit Card using the original order's cost
					' Task: Reduce the Remaining Credit on the current MasterCard Card Holder's Credit Card using the current order's cost
				' 2.2.2.2. OriginalCard Holder has not changed
					' Task: nothing to do
			' 2.2.3. OriginalPurchase Type is "Purchase Order"
				' Task: nil, we do not care about these changes of signing authorities
	
	
	originalCost = Ccur(Replace(source.FieldGetText("TrackOriginalCost"), "$", "")) ' Remove the $ because the field is displayed as Curency
	currentCost = Ccur(Replace(source.FieldGetText("TotCostTaxed"), "$", ""))  ' Remove the $ because the field is displayed as Curency
	Language = s.GetEnvironmentString("HECS_Language")  ' get the current language
	currentPurchasetype = doc.PurchaseType(0)	
	originalPurchasetype = doc.TrackPaymentTypeChanges(0) 
	currentCardholder = doc.CardHolder(0)   ' get the value of the card holder field from the order document
	originalCardHolder = doc.TrackCardHolderChanges(0) ' Get the value of the original Card Holder
	
	Set carddv = db.GetView("CHL")   ' get the card holder lookup view  
	' In propation for the calculation below, get a handle on the Current Credit Card if it is available
	If purchasetype&lt;&gt;"Purchase Order" And currentCardholder &lt;&gt; "" Then
		namekey(1) = purchasetype		' Current Credit Card Type
		namekey(2) = currentCardholder	' Card Holder Name
		Set CarddocCurr = carddv.GetDocumentByKey(namekey) 
	End If
	
	' In propation for the calculation below, get a handle on the Original Credit Card if it is available
	If originalPurchasetype&lt;&gt;"Purchase Order" And originalCardHolder &lt;&gt; "" Then
		If currentCardholder = originalCardHolder Then
			' If the Card Holder is the same we will use a reference to the Original Card
			Set CarddocOriginal = CarddocCurr
		Else ' we get the card
			namekey(1) = originalPurchasetype		' Current Credit Card Type
			namekey(2) = originalCardHolder	' Card Holder Name
			Set CarddocOriginal = carddv.GetDocumentByKey(namekey)    ' according to the value of purchase type and card holder name, get the correct cardholder document from the card holder view
		End If
	End If
	
	If doc.BudgetCalculated(0) = "Yes" Then ' The budget for that Order has been calculated already
		If 	originalCost -  currentCost &lt;&gt; 0 Then  ' 1. OriginalCost has changed
			
			' Get the user's confirmation to make sure we can update the budget and save.
			If Language = "F" Then
				answer% = Messagebox ( "Le montant de la commande à changé.  En sauvegardant ce document, vous allez mettre à jour le montant engagé pour le projet et le montant restant sur la carte de crédit?" , 3+48, "Continuer ?" )					
			Else
				answer% = Messagebox ( "The cost of this Order has changed.  Saving the document will update the committed amount on the project's budget and the Remaining Credit on Credit Card?" , 3+48, "Continue?" )	
			End If
			If answer%&lt;&gt; 6 Then ' Answer is No or Cancel.  The user do not want to continue the save and update the budget
				answer% = Messagebox("The changes were not saved / Les changements n'ont pas été sauvegardés.", 0, "Operation Cancelled / Opération annulée")
				continue = False
				Exit Sub
			End If
			
			costDifference = currentCost - originalCost ' Calculate the difference.  Note that the positive and negative values are handled
			
			'If there is no project, the user should be informed and the operation will stop.  The user should make sure the project exist and retry.
			If projdoc Is Nothing Then					
				If Language = "F" Then
					Messagebox "Le projet n’a pas été trouvé, donc le budget n’a pas été calculé.  Veuillez vérifier que le projet existe et réessayer.", 0+48, "Le budget n'as pas été mis à jour"
				Else
					Messagebox "The project cannot be found.  The project`s budget has not been calculated.  Please ensure the project exists and try again.", 0+48, "The project's budget has not been calculated"				
				End If
				Exit Sub
			End If
			
			' Update the commited amount on the Project based on the specified category
			category = doc.FinCategory(0)   ' get the value of the financial category field
			Select Case category
			Case "Operating"
				projdoc.budgetOp_com=projdoc.budgetOp_com(0) + costDifference
				projdoc.TotCommitted = projdoc.TotCommitted(0) + costDifference
			Case "Travel"
				projdoc.budgetTrav_com=projdoc.budgetTrav_com(0) + costDifference
				projdoc.TotCommitted = projdoc.TotCommitted(0) + costDifference
			Case "Contract"
				projdoc.budgetContr_com=projdoc.budgetContr_com(0) + costDifference
				projdoc.TotCommitted = projdoc.TotCommitted(0) + costDifference
			Case "Capital"
				projdoc.budgetCap_com=projdoc.budgetCap_com(0) + costDifference
				projdoc.TotCommitted = projdoc.TotCommitted(0) + costDifference
			End Select
			
			projdoc.FreeBalance=projdoc.totBudget(0)-projdoc.totCommitted(0) 	' The Free Balance is updated on the project
			
			If originalPurchasetype &lt;&gt; currentPurchaseType Then ' 1.1. OriginalPurchase Type has changed
				If originalPurchasetype = "VISA" Then ' 1.1.1. Original Purchase Type is "VISA"	
					If currentPurchasetype = "MasterCard" Then '1.1.1.1. Current Purchase Type is "MasterCard"
						If originalCardHolder = currentCardHolder Then ' 1.1.1.1.2. OriginalCard Holder has not changed
							' Task: Increase the Remaining Credit on the VISA belonging to the original Card Holder using the original order's cost
							CarddocOriginal.RemCreditV = CarddocOriginal.RemCreditV(0) + originalCost							
							' Task: Reduce the Remaining Credit on the MasterCard belonging to the original Card Holder using the new order's cost
							CarddocCurr.RemCreditM = CarddocCurr.RemCreditM(0) - currentCost							
						Else ' 1.1.1.1.1. OriginalCard Holder has changed
							' Task: Increase the Remaining Credit on the VISA belonging to the original Card Holder using the original order's cost
							CarddocOriginal.RemCreditV = CarddocOriginal.RemCreditV(0) + originalCost														
							' Task: Reduce the Remaining Credit on the MasterCard belonging to the current Card Holder using the new order's cost
							CarddocCurr.RemCreditM = CarddocCurr.RemCreditM(0) - currentCost		
						End If
					Elseif currentPurchasetype = "Purchase Order" Then ' 1.1.1.2. Current Purchase Type is "Purchase Order"
					' Task: Increase the Remaining Credit on the VISA belonging to the original Card Holder using the original order's cost	
						CarddocOriginal.RemCreditV = CarddocOriginal.RemCreditV(0) + originalCost													
					End If
				Elseif originalPurchasetype = "MasterCard" Then ' 1.1.2. OriginalPurchase Type is "MasterCard"
					If currentPurchasetype = "VISA" Then ' 1.1.2.1. Current Purchase Type is "VISA"
						If originalCardHolder = currentCardHolder Then ' 1.1.2.1.2. OriginalCard Holder has not changed
							' Task: Increase the Remaining Credit on the MasterCard belonging to the original Card Holder using the original order's cost
							CarddocOriginal.RemCreditM = CarddocOriginal.RemCreditM(0) + originalCost														
							' Task: Reduce the Remaining Credit on the VISA belonging to the current Card Holder using the new order's cost
							CarddocCurr.RemCreditV = CarddocCurr.RemCreditV(0) - currentCost
						Else ' 1.1.2.1.1. OriginalCard Holder has changed
							' Task: Increase the Remaining Credit on the MasterCard belonging to the original Card Holder using the original order's cost
							CarddocOriginal.RemCreditM = CarddocOriginal.RemCreditM(0) + originalCost									
							' Task: Reduce the Remaining Credit on the VISA belonging to the current Card Holder using the new order's cost
							CarddocCurr.RemCreditV = CarddocCurr.RemCreditV(0) - currentCost
						End If
					Elseif currentPurchasetype = "Purchase Order" Then ' 1.1.2.2. Current Purchase Type is "Purchase Order"	
						' Task: Increase the Remaining Credit on the MasterCard belonging to the original Card Holder using the original order's cost	
						CarddocOriginal.RemCreditM = CarddocOriginal.RemCreditM(0) + originalCost								
					End If	
				Elseif originalPurchasetype = "Purchase Order" Then ' 1.1.3. OriginalPurchase Type is "Purchase Order"	
					If currentPurchasetype = "MasterCard" Then ' 1.1.3.1. Current Purchase Type is "MasterCard"
						' Task: Reduce the Remaining Credit on the MasterCard belonging to the current Card Holder using the new order's cost
						CarddocCurr.RemCreditM = CarddocCurr.RemCreditM(0) - currentCost															
					Elseif currentPurchasetype = "VISA" Then ' 1.1.3.2. Current Purchase Type is "VISA"
						' Task: Reduce the Remaining Credit on the VISA belonging to the current Card Holder using the new order's cost
						CarddocCurr.RemCreditV = CarddocCurr.RemCreditV(0) - currentCost							
					End If
				End If  'Verify the original Purchase Type
			Else '1.2. OriginalPurchase Type has not changed
				If originalPurchasetype = "VISA" Then ' 1.2.1. OriginalPurchase Type is "VISA" 
					If originalCardHolder = currentCardHolder Then ' 1.2.1.2. OriginalCard Holder has not changed
						' Task: Update the Remaining Credit on the original "VISA"
						CarddocOriginal.RemCreditV = CarddocOriginal.RemCreditV(0) - costDifference
					Else ' 1.2.1.1. OriginalCard Holder has changed
						' Task: Increase the Remaining Credit on the original "VISA" Card Holder's Credit Card using the original order's cost
						CarddocOriginal.RemCreditV = CarddocOriginal.RemCreditV(0) + originalCost	
						' Task: Reduce the Remaining Credit on the current "VISA" Card Holder's Credit Card using the new order's cost
						CarddocCurr.RemCreditV = CarddocCurr.RemCreditV(0) - currentCost	
					End If
				Elseif originalPurchasetype = "MasterCard" Then ' 1.2.2. OriginalPurchase Type is "MasterCard"
					If originalCardHolder = currentCardHolder Then ' 1.2.2.2. OriginalCard Holder has not changed
						' Task: Update the Remaining Credit on the original "MasterCard"
						CarddocOriginal.RemCreditM = CarddocOriginal.RemCreditM(0) - costDifference
					Else ' 1.2.2.1. OriginalCard Holder has changed
						' Task: Increase the Remaining Credit on the original "MasterCard" Card Holder's Credit Card using the original order's cost
						CarddocOriginal.RemCreditM = CarddocOriginal.RemCreditM(0) + originalCost
						' Task: Reduce the Remaining Credit on the current "MasterCard" Card Holder's Credit Card using the new order's cost
						CarddocCurr.RemCreditM = CarddocCurr.RemCreditM(0) - currentCost
					End If
				Elseif originalPurchasetype = "Purchase Order" Then	' 1.2.3. OriginalPurchase Type is "Purchase Order"				
					' Task: nil, we do not care about these changes of signing authorities					
				End If				
			End If ' verify if Purchase Type changed	
		Else ' 2. OriginalCost has not changed
			If originalPurchasetype &lt;&gt; currentPurchaseType  Then ' 2.1. OriginalPurchase Type has changed
				If originalPurchasetype = "VISA" Then ' 2.1.1. Original Purchase Type is "VISA"
					If currentPurchasetype = "MasterCard" Then '2.1.1.1. Current Purchase Type is "MasterCard"
						' Task: Increase the Remaining Credit on the original VISA Card Holder's Credit Card using the original order's cost
						CarddocOriginal.RemCreditV = CarddocOriginal.RemCreditV(0) + originalCost
						' Task: Reduce the Remaining Credit on the current MasterCard Card Holder's Credit Card using the current order's cost	
						CarddocCurr.RemCreditM = CarddocCurr.RemCreditM(0) - currentCost
					Elseif currentPurchasetype = "Purchase Order" Then ' 2.1.1.2. Current Purchase Type is "Purchase Type"
						' Task: Increase the Remaining Credit on the original VISA Card Holder's Credit Card using the original order's cost
						CarddocOriginal.RemCreditV = CarddocOriginal.RemCreditV(0) + originalCost
					End If
				Elseif originalPurchasetype = "MasterCard" Then ' 2.1.2. OriginalPurchase Type is "MasterCard"
					If currentPurchasetype = "VISA" Then ' 2.1.2.1. Current Purchase Type is "Visa"
						' Task: Increase the Remaining Credit on the original MasterCard Card Holder's Credit Card using the original order's cost
						CarddocOriginal.RemCreditM = CarddocOriginal.RemCreditM(0) + originalCost
						' Task: Reduce the Remaining Credit on the current VISA Card Holder's Credit Card using the current order's cost	
						CarddocCurr.RemCreditV = CarddocCurr.RemCreditV(0) - currentCost
					Elseif currentPurchasetype = "Purchase Order" Then ' 2.1.2.2. Current Purchase Type is "Purchase Type"
						' Task: Increase the Remaining Credit on the original MasterCard Card Holder's Credit Card using the original order's cost
						CarddocOriginal.RemCreditM = CarddocOriginal.RemCreditM(0) + originalCost						
					End If
				Elseif originalPurchasetype = "Purchase Order" Then ' 2.1.3. OriginalPurchase Type is "Purchase Order"
					If currentPurchasetype = "MasterCard" Then ' 2.1.3.1. Current Purchase Type is "MasterCard"
						' Task: Reduce the Remaining Credit on the current MasterCard Card Holder's Credit Card using the current order's cost	
						CarddocCurr.RemCreditM = CarddocCurr.RemCreditM(0) - currentCost	
					Elseif currentPurchasetype = "VISA" Then ' 2.1.3.1. Current Purchase Type is "Visa"
						' Task: Reduce the Remaining Credit on the current VISA Card Holder's Credit Card using the current order's cost	
						CarddocCurr.RemCreditV = CarddocCurr.RemCreditV(0) - currentCost
					End If
				End If
			Else ' 2.2. OriginalPurchase Type has not changed
				If originalPurchasetype = "VISA" Then ' 2.2.1. OriginalPurchase Type is "VISA"
					If originalCardHolder = currentCardHolder Then ' 2.2.1.2. OriginalCard Holder has not changed
						' Task: nothing to do
					Else ' 2.2.1.1. OriginalCard Holder has changed
						' Task: Increase the Remaining Credit on the original VISA Card Holder's Credit Card using the original order's cost
						CarddocOriginal.RemCreditV = CarddocOriginal.RemCreditV(0) + originalCost
						' Task: Reduce the Remaining Credit on the current VISA Card Holder's Credit Card using the current order's cost
						CarddocCurr.RemCreditV = CarddocCurr.RemCreditV(0) - currentCost
					End If
				Elseif originalPurchasetype = "MasterCard" Then ' 2.2.2. OriginalPurchase Type is "MasterCard"
					If originalCardHolder = currentCardHolder Then ' 2.2.2.2. OriginalCard Holder has not changed
						' Task: nothing to do
					Else ' 2.2.2.1. OriginalCard Holder has changed
						' Task: Increase the Remaining Credit on the original MasterCard Card Holder's Credit Card using the original order's cost
						CarddocOriginal.RemCreditM = CarddocOriginal.RemCreditM(0) + originalCost
						' Task: Reduce the Remaining Credit on the current MasterCard Card Holder's Credit Card using the current order's cost
						CarddocCurr.RemCreditM = CarddocCurr.RemCreditM(0) - currentCost
					End If
				Elseif originalPurchasetype = "Purchase Order" Then ' 2.2.3. OriginalPurchase Type is "Purchase Order"
				' Task: nil, we do not care about these changes of signing authorities
				End If
			End If
		End If  ' verify if cost has changed
		
		projdoc.Save True, True
		If status &lt;&gt; "Reconciled" Then '  We do not want to update the Credit Card if the Status is Reconciled.  Reconciled orders have already updated the Remaining Credit on the Credit Card.
			If Not (CarddocCurr Is Nothing) Then
				CarddocCurr.Save True, True
			End If
			If Not (CarddocOriginal Is Nothing) Then
				CarddocOriginal.Save True, True
			End If
		End If
	End If ' verify if the budget has been calculated already
	
	' Refresh the tracking fields with the current values
	Call doc.ReplaceItemValue("trackOriginalCost", doc.GetItemValue("TotCostTaxed")) 		
	Call doc.ReplaceItemValue("TrackPaymentTypeChanges", doc.GetItemValue("PurchaseType")) 	
	Call doc.ReplaceItemValue("TrackCardHolderChanges", doc.GetItemValue("CardHolder"))
	Call doc.ReplaceItemValue("TrackProjectChanges", doc.GetItemValue("ProjectSelection"))
	
	
	'/**** Change the Status is we detect changes in the Partial and Received orders.
	itemReceivedStatus = source.FieldGetText("itemsReceived")
	Select Case status
	Case "New"  'do nothing, not applicable at this status
	Case "Submitted"  'do nothing, not applicable at this status
	Case "On Order"
		' Make sure the Status is good.  The order may be Partially received or Received
		If itemReceivedStatus = "Partially Received" Then
			Call source.FieldSetText("Status", "Partially Received")
		Elseif  itemReceivedStatus = "Received" Then
			Call source.FieldSetText("Status", "Received")
		End If		
	Case "Partially Received"
		' Make sure the Status is good.  The order may be returned to On Order or Received
		If itemReceivedStatus = "None Received" Then
			Call source.FieldSetText("Status", "On Order")
		Elseif  itemReceivedStatus = "Received" Then
			Call source.FieldSetText("Status", "Received")
		End If	
	Case "Received"
		' Make sure the Status is good.  The order may be returned to On Order or Partially Received
		If itemReceivedStatus = "None Received" Then
			Call source.FieldSetText("Status", "On Order")
		Elseif  itemReceivedStatus = "Partially Received" Then
			Call source.FieldSetText("Status", "Partially Received")
		End If	
	Case "Cancelled"  'do nothing, document should not be editable
	End Select
	
End Sub
</lotusscript></code><code event='querymodechange'><lotusscript>Sub Querymodechange(Source As Notesuidocument, Continue As Variant)
' This is in order to prevent the author of an order to go back and edit an order that was already sent to the Admin.
	Dim sent As String
	Dim statusStr As String
	Dim role As Variant
	
	role = Evaluate("@IsMember('[Admin]';@UserRoles)")
	If Not ( source.EditMode ) Then        ' If we're not in edit mode then
		
		' 2009-06-29: ADR 3550: JML: Prevent the document to be edited if the status is cancelled
		statusStr = source.FieldGetText( "Status" )
		If statusStr = "Cancelled" Then
			Messagebox ( "Sorry! This order is cancelled and cannot be edited. Please use the button 'Copy Existing Order' on the views if you want to create a similar order." &amp; Chr(10) &amp; Chr(10) &amp; "Cette commande est annulée et ne peut être modifiée.  Veuillez utiliser le bouton 'Copier une commande' dans les vues si vous désirez créer une commande similaire." )
			continue = False
			Exit Sub			
		End If		
		
		sent = source.FieldGetText( "Sent" )
		If ( sent = "Yes" ) And ( role(0) = 0 ) Then     ' If the user does not have the [Admin] role and the order has already been sent to the admin
			Messagebox ( "Sorry! This document is available for browsing only." &amp; Chr(10) &amp; Chr(10) &amp; "Aucun modification est possible." )
			continue = False	
		End If
	End If    	
End Sub
</lotusscript></code><code event='postopen'><lotusscript>Sub Postopen(Source As Notesuidocument)
	
	Dim s As New notessession
	Dim db As notesdatabase
	Dim dv As notesview
	Dim projdoc As notesdocument
	Dim projitem As notesitem
	Dim inproj As Integer
	
	' 2009-06-15: JML: ADR 3550: this is to prevent the Author of the Order to edit the document upon ailing it to the admin.
	' The Querymodechange was taking care of that, but was not handling the users who were opening the document using CTRL-O
	Dim sent As String	
	Dim role As Variant	
	role = Evaluate("@IsMember('[Admin]';@UserRoles)")
	If source.EditMode=True Then		
		sent = source.FieldGetText( "Sent" )
		If ( sent = "Yes" ) And ( role(0) = 0 ) Then     ' If the user does not have the [Admin] role and the order has already been sent to the admin
			Messagebox ( "Sorry! This document is available for browsing only." &amp; Chr(10) &amp; Chr(10) &amp; "Aucun modification est possible." )
			source.EditMode = False ' go back to Read Mode
		End If		
	End If	
	
	' 2009-07-06: START: New method to populate the ProjectSelection1 field.
	' 2009-07-06: ADR 3550: JML: A more efficient method to populate the ProjectSelection1 field has been implemented.
	' The ProjectSelection1 field is now populated based on the current 
	' _ Project and the existing projects for which the user is listed as PI, Manager or Employee
	' A new view called "PLV2" was created.  The first column is categorized based on the list of PI, Manager and Emploeyes of each project.
	' The second column contains the project names
	' And now we check the list of projects only if we are opening the document in edit mode.
	If Source.EditMode = True Then
		Set db=s.currentdatabase
		Set dv=db.getview("PLV2")
		Dim docColl As NotesDocumentCollection
		Dim key As String
		key = s.Commonusername
		Set docColl = dv.GetAllDocumentsByKey(key, True)
		
		Set projdoc=docColl.GetFirstDocument
		Call Source.fieldsettext("ProjectSelection1", source.fieldgettext("ProjectSelection"))
		While Not projdoc Is Nothing
			' Add each project matching the search criteria
			Call Source.fieldsettext("ProjectSelection1", Source.fieldgettext("ProjectSelection1") + "," + projdoc.Project(0))
			Set projdoc=docColl.GetNextDocument(projdoc)
		Wend
		
		Source.Refresh ' This will ensure the new ProjectSelection1 field is used to populate the ProjectSelection combobox.
	End If	
	' 2009-07-06: END: 
	
	' 2009-07-06: Old method to check which projects the user can create order for.
	'inproj = 0
	'Set uidoc=ws.currentdocument
	'Set db=s.currentdatabase
	'Set dv=db.getview("PLV")
	'Set projdoc=dv.getfirstdocument
	'While Not (projdoc Is Nothing)
	'	Set projitem=projdoc.getfirstitem("PI")
	'	Forall x In projitem.values
	'		If x=s.Commonusername Then
	'			inproj=1
	'		End If
	'	End Forall
	'	If Not (inproj=1) Then
	'		Set projitem=projdoc.getfirstitem("Manager")
	'		Forall y In projitem.values
	'			If y=s.Commonusername Then
	'				inproj=1
	'			End If
	'		End Forall
	'	End If
	'	If Not (inproj=1) Then
	'		Set projitem=projdoc.getfirstitem("Employees")
	'		Forall z In projitem.values
	'			If z=s.commonusername Then
	'				inproj=1
	'			End If
	'		End Forall
	'	End If
	'	If inproj = 1 And uidoc.EditMode = True Then Call uidoc.fieldsettext("ProjectSelection1", uidoc.fieldgettext("ProjectSelection1") + "," + projdoc.Project(0))
	'	inproj = 0
	'	Set projdoc=dv.GetNextDocument(projdoc)
	'Wend
	
	' Populate the Addresses if the order is new.
	If Source.IsNewDoc Then 
		Call InvoiceAddress
		Call ShippingAddress
	End If
	
	' July 2009, ADR 3550: JML: Set the TrackOriginalCost field to track the changes to the Order's cost.
	' Also track the changes of payment type.
	' This code will work if the document is opened in Edit mode
	Dim tmpStr As String
	If Source.EditMode = True Then
		tmpStr = Source.FieldGetText("TotCostTaxed")
		Call Source.FieldSetText("TrackOriginalCost", tmpStr)
		tmpStr = Source.FieldGetText("PurchaseType")
		Call Source.FieldSetText("TrackPaymentTypeChanges", tmpStr)
		tmpStr = Source.FieldGetText("CardHolder")
		Call Source.FieldSetText("TrackCardHolderChanges", tmpStr)	
		tmpStr = Source.FieldGetText("ProjectSelection")
		Call Source.FieldSetText("TrackProjectChanges", tmpStr)	
	End If	
	
	If Source.EditMode=True Then Source.Refresh
	
End Sub
</lotusscript></code><code event='postmodechange'><lotusscript>Sub Postmodechange(Source As Notesuidocument)
	If source.EditMode = True Then
		Call source.FieldSetText("LastProjectSelected", source.FieldGetText("ProjectSelection"))
		
		' July 2009, ADR 3550: JML: To handle Order's opened in Read mode, we are setting the TrackOriginalCost field _
		'  to track the changes to the Order's cost.	
		Dim tmpStr As String
		tmpStr = Source.FieldGetText("TotCostTaxed")
		Call Source.FieldSetText("TrackOriginalCost", tmpStr)
		
		' 2009-07-10, ADR 3550: JML: To handle changes of payment type we have added a tracking field.
		tmpStr = Source.FieldGetText("PurchaseType")
		Call Source.FieldSetText("TrackPaymentTypeChanges", tmpStr)	
		
		' 2009-07-13, ADR 3550: JML: To handle changes of Card Holder.
		tmpStr = Source.FieldGetText("CardHolder")
		Call Source.FieldSetText("TrackCardHolderChanges", tmpStr)	
		
		' 2009-07-28, ADR 3550: JML: To handle changes of Project.
		tmpStr = Source.FieldGetText("ProjectSelection")
		Call Source.FieldSetText("TrackProjectChanges", tmpStr)	
		
		' 2009-07-06: ADR 3550: JML: the ProjectSelection1 field is now populated based on the current 
		' _ Project and the existing projects for which the user is listed as PI, Manager or Employee
		' A new view called "PLV2" was created.  The first column is categorized based on the list of PI, Manager and Emploeyes of each project.
		' The second column contains the project names.
		
		Dim s As New NotesSession
		Dim db As NotesDatabase
		Dim dv As NotesView
		Dim docColl As NotesDocumentCollection
		Dim key As String
		
		Set db=s.currentdatabase
		Set dv=db.getview("PLV2")
		key = s.Commonusername ' Get the Common name of the current user i.e. "John Smith"
		Set docColl = dv.GetAllDocumentsByKey(key, True)
		
		Set projdoc=docColl.GetFirstDocument
		Call Source.fieldsettext("ProjectSelection1", source.fieldgettext("ProjectSelection"))
		While Not projdoc Is Nothing
		' Add each project matching the search criteria
			Call Source.fieldsettext("ProjectSelection1", source.fieldgettext("ProjectSelection1") + "," + projdoc.Project(0))
			Set projdoc=docColl.GetNextDocument(projdoc)
		Wend
		
		Source.Refresh ' This will ensure the new ProjectSelection1 field is used to populate the ProjectSelection combobox
	End If
End Sub</lotusscript></code>
