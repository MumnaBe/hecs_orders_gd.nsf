<tablecell borderwidth='0px'>
<pardef id='9' leftmargin='2%' rightmargin='98%' keepwithnext='true' keeptogether='true'/>
<par def='9'><run><font style='bold'/></run><run><font style='bold'/><computedtext
><code event='value'><formula>@If(@Environment("HECS_Language") = "E"; "Project:"; "Projet:")</formula></code></computedtext></run><run
><font style='bold'/></run></par></tablecell>
<tablecell borderwidth='0px'>
<pardef id='10' leftmargin='1%' rightmargin='99%' keepwithnext='true' keeptogether='true'/>
<par def='10'><field lookupeachchar='false' lookupaddressonrefresh='false'
 type='keyword' kind='editable' name='ProjectSelection'><keywords recalconchange='true'
 recalcchoices='true' columns='1' ui='dialoglist'><formula>ProjectSelection1</formula></keywords><code
 event='defaultvalue'><formula>"--Please select a project--"</formula></code><code
 event='exiting'><lotusscript>Sub Exiting(Source As Field)
	Dim ws As New notesuiworkspace
	Dim uidoc As notesuidocument
	Set uidoc=ws.currentdocument
	Dim s As New notessession
	Dim db As notesdatabase
	Dim dv As notesview
	Dim projdoc As notesdocument
	Dim mykeys As String
	Dim strBudgetCalculated As String
	
	If Not(uidoc.FieldGetText("ProjectSelection") = "--Please select a project--") Then
		mykeys=uidoc.FieldGetText("ProjectSelection")
		
		Set db=s.CurrentDatabase
		Set dv=db.GetView("PLV")
		Set projdoc=dv.GetDocumentByKey(mykeys)
		
		'2009-07-28: ADR 3550: JML: Jean-Marc added a verification to handle cases where the selected project do not exist.  This handles existing Orders.
		If Not projdoc Is Nothing Then	' the project exists
			Call uidoc.FieldSetText("PI", projdoc.PI(0))
			Call uidoc.FieldSetText("SectionHead", projdoc.Manager(0))    
		Else ' the project no longer exists			
			answer% = Messagebox("The project no longer exists, please recreate the project or choose a different project." + Chr(10) + Chr(10) + "Le projet n'existe plus, veuillez recréer le projet ou choisissez un autre projet.", 0 + 48, "Project do not exists / Le projet n'existe pas")	
			Call uidoc.FieldSetText("ProjectSelection", uidoc.FieldGetText("TrackProjectChanges"))
			Exit Sub			
		End If
	End If
	
	strBudgetCalculated = uidoc.FieldGetText("BudgetCalculated")
	' If the proejct has changed for an order for which the budget has been calulated, then prompt the admin to recalculate the original and new projec'ts budget.
	If Not(uidoc.FieldGetText("ProjectSelection") = uidoc.FieldGetText("TrackProjectChanges")) And strBudgetCalculated = "Yes" Then
		answer% = Messagebox("The project has changed; please make sure the budget for the old and the new projects are recalculated. / Le projet a changé, veuillez vous assurer de recalculer le budget pour l'ancien et le nouveau projet.", 0 + 48, "Project changed / Projet modifié")
	End If
	
End Sub
</lotusscript></code><code event='initialize'><lotusscript>Sub Initialize
	
End Sub</lotusscript></code></field><run><font style='bold'/></run></par></tablecell>
