<action title='Mail to Admin' icon='3' hide='preview read'><code event='click'><formula
>FIELD SaveOptions := SaveOptions;
FIELD Sent := Sent;
FIELD Status := Status;
FIELD OrderComments := OrderComments;

REM{2009-06-16: JML: ADR 3550: a condition was added to prevent the unsaved orders to be mailed to the admin when the validation does not pass.  This was causing Variable not set errors.};
@If(@IsNewDoc;
  @Do(
    @Prompt([Ok]; "Operation cancelled"; "Please save the Order and try again");
    @Return(""));
  "");

@SetField("SaveOptions"; "1");
@SetField("Sent"; "Yes");
@SetField("Status"; "Submitted");
@DialogBox("CommentsDialog";[AutoHorzFit]:[AutoVertFit]:[NoNewFields];"Comments");
@PostedCommand([FileSave]);
@PostedCommand([FileCloseWindow]);
@MailSend(SendTo;"";"";"HECS Orders/commandes de SESC";"";"HECS Order form....Please follow the link below." + @NewLine + @NewLine + "Comments/Commentaires: " + OrderComments + @NewLine + @NewLine + "commandes de SESC....SVP suivre ce lien ---&gt; " ;[IncludeDoclink]);
@Prompt([Ok];"Confirmation";"Your order form has been sent to the Administrator "+ SendTo)</formula></code><code
 event='hidewhen'><formula>@Environment("HECS_Language") = "F"|FinCode="" | Status = "Cancelled"
| Status = "Reconciled"</formula></code></action>
<action title='Envoyer à l&apos;Admin' icon='3' hide='preview read'><code
 event='click'><formula>FIELD SaveOptions := SaveOptions;
FIELD Sent := Sent;
FIELD Status := Status;
FIELD OrderComments := OrderComments;


REM{2009-06-16: JML: ADR 3550: a condition was added to prevent the unsaved orders to be mailed to the admin when the validation does not pass.  This was causing Variable not set errors.};
@If(@IsNewDoc;
  @Do(
    @Prompt([Ok]; "Opération annullée"; "Veuillez sauvegarder la commande et essayer de nouveau.");
    @Return(""));
  "");

@SetField("SaveOptions"; "1");
@SetField("Sent"; "Yes");
@SetField("Status"; "Submitted");
@DialogBox("CommentsDialog";[AutoHorzFit]:[AutoVertFit]:[NoNewFields];"Comments");
@PostedCommand([FileSave]);

REM{2009-05-19: JML: ADR#3550: the FileCloseWindow was added to be consistant with the english button};
@PostedCommand([FileCloseWindow]);

@MailSend(SendTo;"";"";"HECS Orders/commandes de SESC";"";"HECS Order form....Please follow the link below." + @NewLine + @NewLine + "Comments/Commentaires: " +  OrderComments + @NewLine + @NewLine +"Commandes de SESC....SVP suivre ce lien ---&gt; " ;[IncludeDoclink]);
@Prompt([Ok];"Confirmation";"Votre commande a été envoyée à l'administrateur "+ SendTo)</formula></code><code
 event='hidewhen'><formula>@Environment("HECS_Language") = "E"|FinCode="" | Status = "Cancelled" | Status = "Reconciled"</formula></code></action>
<action title='Got it!' icon='110' showinmenu='false'><code event='click'><formula
>@Command( [EditDocument]; "1" );
FIELD SaveOptions := SaveOptions;
FIELD Status := Status;

REM{2009-06-12: JML: ADR 3550: If the cost of the order has changed, the user will be asked to save the document first then to try again.};
@Command([ViewRefreshFields]);
@If(@Round(@TextToNumber(@ReplaceSubstring(@Text(TrackOriginalCost);  "$"; ""))) - @Round(@TextToNumber(@ReplaceSubstring(@Text(TotCostTaxed);  "$"; ""))) != 0 &amp; BudgetCalculated = "Yes";
  @Do(
    @Prompt([Ok]; "Operation Cancelled"; "Please save the document and try again.  The system has detected a change in the Order's cost");
    @Return("")); "");

@SetField("SaveOptions"; "1");
@SetField("Status"; "On Order");
@PostedCommand([FileSave]);

REM{2009-06-10: JML: ADR 3550: prevent the button to generate a reference number if it already exist};
@If(RefNumber =""; @PostedCommand([ToolsRunMacro];"DocNumbering");"");
@PostedCommand([FileSave]);

REM{2009-06-10: JML: ADR 3550: the agent CalculateBudgetForOrder replace the button On Order};
@If(BudgetCalculated != "Yes"; @PostedCommand([ToolsRunMacro];"(CalculateBudgetForOrder)"); "");
@PostedCommand([FileSave]);

REM{Send the confirmation and warning emails};
@PostedCommand([ToolsRunMacro];"ConfirmReceipt");
@PostedCommand([FileSave]);

@PostedCommand([FileCloseWindow])</formula></code><code event='hidewhen'><formula
>REM{2009-06-30: ADR 3550: JML has hidden the button if the order is Reconciled};

@Environment("HECS_Language") = "F"
| (!@Contains(@UserRoles;"[Admin]"))
| @IsNewDoc
| Status = "Cancelled" | Status = "Reconciled"</formula></code></action>
<action title='Reçu!' icon='110' showinmenu='false'><code event='click'><formula
>@Command( [EditDocument]; "1" );
FIELD SaveOptions := SaveOptions;
FIELD Status := Status;

REM{2009-06-12: JML: ADR 3550: If the cost of the order has changed, the user will be asked to save the document first then to try again.};
@Command([ViewRefreshFields]);

@If(@Round(@TextToNumber(@ReplaceSubstring(@Text(TrackOriginalCost);  "$"; ""))) - @Round(@TextToNumber(@ReplaceSubstring(@Text(TotCostTaxed);  "$"; ""))) != 0 &amp; BudgetCalculated = "Yes";
  @Do(
    @Prompt([Ok]; "Operation annulée"; "Veuillez sauvegarder le document et essayer de nouveau.  Le système à détecté une différence dans le coût de la commande");
    @Return("")); "");

@SetField("SaveOptions"; "1");
@SetField("Status"; "On Order");
@PostedCommand([FileSave]);

REM{2009-06-10: JML: ADR 3550: prevent the button to generate a reference number if it already exist};
@If(RefNumber =""; @PostedCommand([ToolsRunMacro];"DocNumbering");"");
@PostedCommand([FileSave]);

REM{2009-06-10: JML: ADR 3550: the agent CalculateBudgetForOrder replace the button On Order};
@If(BudgetCalculated != "Yes"; @PostedCommand([ToolsRunMacro];"(CalculateBudgetForOrder)"); "");
@PostedCommand([FileSave]);

REM{Send the confirmation and warning emails};
@PostedCommand([ToolsRunMacro];"ConfirmReceipt");
@PostedCommand([FileSave]);

@PostedCommand([FileCloseWindow])</formula></code><code event='hidewhen'><formula
>REM{2009-06-30: ADR 3550: JML has hidden the button if the order is Reconciled};

@Environment("HECS_Language") = "E"
| (!@Contains(@UserRoles;"[Admin]"))
| @IsNewDoc | Status = "Cancelled"
| Status = "Reconciled"</formula></code></action>
<action title='Print' icon='98' showinmenu='false'><code event='click'><lotusscript
>Sub Click(Source As Button)
	
	Dim ws As New notesuiworkspace
	Dim uidoc As notesuidocument
	Dim uidoc2 As notesuidocument
	Dim doc As notesdocument
	Dim number As String
	Dim number2 As String
	Dim expdate As String
	Dim role As Variant
	Dim purchasetype As String
	
	Set uidoc=ws.currentdocument
	Set doc = uidoc.document
	
	If uidoc.isNewDoc Then
		uidoc.Save
	End If
	
	role = Evaluate("@IsMember('[Admin]';@UserRoles)")
	If role(0) = 1 Then   ' this user has the [Admin] role
		purchasetype = doc.PurchaseType(0)
		
		If Not (purchasetype = "Purchase Order") Then
			number = Inputbox$("Please enter the full " &amp; purchasetype &amp; " number (16 numbers, no spaces): ")
			While Not (number Like "################" Or number = "")
				number = Inputbox$("Please enter the full " &amp; purchasetype &amp; " number (16 numbers, no spaces): ")
			Wend
			If Not (number = "") Then
				number2 = Left(number,4) +" " + Left(Right(number,12),4) +" " + Left(Right(number, 8),4) + " " + Right(number,4)
				expdate = Inputbox$ ("Please enter the expiry date of the card (mm/yyyy): ")
			End If
			While Not (expdate Like "##/####" Or expdate = "")
				expdate = Inputbox$ ("Please enter the expiry date in the format mm/yyyy: ")
			Wend
			
			doc.ExpiryDate = expdate
			
		Else
			
			number2 = Inputbox$ ("Please enter the " &amp; purchasetype &amp; " number: ")
			
		End If          
		doc.CardNumber = number2   
		Call doc.Save( True, False )
	End If     
	
	Set uidoc2 = ws.ComposeDocument ( "", "", "New Print Order Form" )
	Call uidoc2.Print
	
	If role(0) = 1 Then
		doc.Printed = "Yes"
	End If
	
	If Not (purchasetype = "Purchase Order") Then
		doc.CardNumber = ""
	End If
	doc.ExpiryDate = ""
	Call doc.Save( True, False )          
	
End Sub</lotusscript></code><code event='hidewhen'><formula>@Environment("HECS_Language") = "F" | RefNumber=""</formula></code></action>
<action title='Imprimer' icon='98' showinmenu='false'><code event='click'><lotusscript
>Sub Click(Source As Button)
	Dim ws As New notesuiworkspace
	Dim uidoc As notesuidocument
	Dim uidoc2 As notesuidocument
	Dim doc As notesdocument
	Dim number As String
	Dim number2 As String
	Dim expdate As String
	Dim role As Variant
	Dim purchasetype As String
	
	Set uidoc=ws.currentdocument
	Set doc = uidoc.document
	
	If uidoc.isNewDoc Then
		uidoc.Save
	End If
	
	role = Evaluate("@IsMember('[Admin]';@UserRoles)")
	If role(0) = 1 Then   ' this user has the [Admin] role
		purchasetype = doc.PurchaseType(0)
		
		If Not (purchasetype = "Purchase Order") Then
			number = Inputbox$("S.V.P  entrez le numéro de la carte au complet (16 numéros, sans espaces): ")
			While Not (number Like "################" Or number = "")
				number = Inputbox$("S.V.P  entrez le numéro de la carte au complet (16 numéros, sans espaces): ")
			Wend
			If Not (number = "") Then
				number2 = Left(number,4) + " " +  Left(Right(number,12),4) +" " + Left(Right(number, 8),4) +" " + Right(number,4)
				expdate = Inputbox$ ("Date d'expiration de la carte d'aquisition (mm/aaaa): ")
			End If
			While Not (expdate Like "##/####" Or expdate = "")
				expdate = Inputbox$ ("Date d'expiration de la carte d'aquisition (mm/aaaa): ")
			Wend
			doc.ExpiryDate = expdate
		Else
			'** JML: fix problem: the field name should be "number2" to make sure the CardNumber value can be set and its to match the English coding 
			'** number = Inputbox$ ("S.V.P. entez le numéro du bon de commande: ")			
			number2 = Inputbox$ ("S.V.P. entez le numéro du bon de commande: ")
		End If          
		
		doc.CardNumber = number2          
		Call doc.Save( True, False )
	End If     
	
	Set uidoc2 = ws.ComposeDocument ( "", "", "New Print Order Form" )
	Call uidoc2.Print
	
	If role(0) = 1 Then
		doc.Printed = "Yes"
	End If
	
	If Not (purchasetype = "Purchase Order") Then
		doc.CardNumber = ""
	End If
	doc.ExpiryDate = ""
	Call doc.Save( True, False )          
	
End Sub</lotusscript></code><code event='hidewhen'><formula>@Environment("HECS_Language") = "E"|RefNumber=""</formula></code></action>
<action title='Reconciled' icon='127' showinmenu='false'><code event='click'><formula
>@Command( [EditDocument]; "1" );
FIELD SaveOptions := SaveOptions;
FIELD Status := Status;

REM{2009-06-12: JML: ADR 3550: If the cost of the order has changed, the user will be asked to save the document first then to try again.};
@Command([ViewRefreshFields]);
@If(@Round(@TextToNumber(@ReplaceSubstring(@Text(TrackOriginalCost);  "$"; ""))) - @Round(@TextToNumber(@ReplaceSubstring(@Text(TotCostTaxed);  "$"; ""))) != 0 &amp; BudgetCalculated = "Yes";
  @Do(
    @Prompt([Ok]; "Operation Cancelled"; "Please save the document and try again.  The system has detected a change in the Order's cost");
    @Return("")); "");

@SetField("SaveOptions"; "1");
@SetField("Status"; "Reconciled");

REM{2009-06-10: JML: ADR 3550: Increase the Remainig Credit on the Credit Card};
@Command([ToolsRunMacro];"(ReconcileCreditCard)");
@If(PurchaseType = "VISA" | PurchaseType = "MasterCard"; @Prompt([Ok];"Credit Card"; "The Remaining Credit on the Credit Card has been increased");"");

@Prompt([Ok];"Confirmation";"The Status of the order has been changed to Reconciled");
@PostedCommand([FileSave]);
@Command([FileCloseWindow])</formula></code><code event='hidewhen'><formula
>REM{2009-06-30: ADR 3550: JML has hidden the button if the order is not received};

@Environment("HECS_Language") = "F" |
(!@Contains(@UserRoles;"[Admin]"))
| @IsNewDoc
| Status = "Cancelled"
| Status = "Reconciled"
| Status != "Received"</formula></code></action>
<action title='Réconcilié' icon='127' showinmenu='false'><code event='click'><formula
>@Command( [EditDocument]; "1" );
FIELD SaveOptions := SaveOptions;
FIELD Status := Status;

REM{2009-06-12: JML: ADR 3550: If the cost of the order has changed, the user will be asked to save the document first then to try again.};
@Command([ViewRefreshFields]);
@If(@Round(@TextToNumber(@ReplaceSubstring(@Text(TrackOriginalCost);  "$"; ""))) - @Round(@TextToNumber(@ReplaceSubstring(@Text(TotCostTaxed);  "$"; ""))) != 0 &amp; BudgetCalculated = "Yes";
  @Do(
    @Prompt([Ok]; "Operation annulée"; "Veuillez sauvegarder le document et essayer de nouveau.  Le système à détecté une différence dans le coût de la commande");
    @Return("")); "");

@SetField("SaveOptions"; "1");
@SetField("Status"; "Reconciled");

REM{2009-06-10: JML: ADR 3550: Increase the Remainig Credit on the Credit Card};
@Command([ToolsRunMacro];"(ReconcileCreditCard)");
@If(PurchaseType = "VISA" | PurchaseType = "MasterCard"; @Prompt([Ok];"Carte de crédit"; "La valeur résiduelle de la carte de crédit à été augmentée");"");

@Prompt([Ok];"Confirmation";"Le cheminement de la commande est changé à Réconcilié");
@PostedCommand([FileSave]);
@Command([FileCloseWindow])</formula></code><code event='hidewhen'><formula
>REM{2009-06-30: ADR 3550: JML has hidden the button if the order is not received};

@Environment("HECS_Language") = "E" |
(!@Contains(@UserRoles;"[Admin]"))
| @IsNewDoc
| Status = "Cancelled"
| Status = "Reconciled"
| Status != "Received"</formula></code></action>
<action title='Cancel Order' icon='11' showinmenu='false'><code event='click'><formula
>@Command( [EditDocument]; "1" );
FIELD SaveOptions := SaveOptions;
FIELD Status := Status;
FIELD BudgetCalculated := BudgetCalculated;
@SetField("SaveOptions"; "1");
@SetField("Status"; "Cancelled");

REM{Start - 2009-05-15: JML: ADR#3550: the following line was modified to reset the BudgetCalculated flag and to add the message boxes};
REM{@If(BudgetCalculated="Yes";@Command([ToolsRunMacro];"ReCalculateThisBudget");"");};
@If(BudgetCalculated="Yes";
  @Do(
    @Command([ToolsRunMacro];"RecalculateThisBudget");
    @SetField("BudgetCalculated"; "No");
    @Prompt([Ok];"Cancelling Order";"The committed amount for the project have been adjusted")
