<par def='77'><run><font style='bold'/></run><run><font style='bold'/><computedtext
><code event='value'><formula>@If(@Environment("HECS_Language") = "E"; "Customs:"; "Douanes:")</formula></code></computedtext></run><run
><font style='bold'/></run></par></tablecell>
<tablecell borderwidth='0px'>
<par def='78'><run><font style='bold'/></run><field type='number' kind='editable'
 name='Customs'><numberformat format='currency' digits='2' punctuated='false'
 parens='false' percent='false' bytes='false'/><code event='defaultvalue'><formula
>0</formula></code></field><run><font style='bold'/></run></par></tablecell></tablerow>
<tablerow>
<tablecell borderwidth='0px'>
<par def='77'><run><font style='bold'/></run><run><font style='bold'/><computedtext
><code event='value'><formula>@If(@Environment("HECS_Language") = "E"; "Exchange Rate:"; "Taux d'échange:")</formula></code></computedtext></run><run
><font style='bold'/></run></par></tablecell>
<tablecell borderwidth='0px'>
<par def='78'><run><font style='bold'/></run><field type='number' kind='editable'
 name='Exchange'><numberformat format='fixed' digits='2' punctuated='false'
 parens='false' percent='true' bytes='false'/></field><run><font style='bold'/>	</run></par></tablecell></tablerow>
<tablerow>
<tablecell borderwidth='0px'>
<par def='77'><run><font style='bold'/></run><run><font style='bold'/><computedtext
><code event='value'><formula>@If(@Environment("HECS_Language") = "E"; "Cost:"; "Coût :")</formula></code></computedtext></run><run
><font style='bold'/></run></par></tablecell>
<tablecell borderwidth='0px'>
<par def='78'><field type='number' kind='computed' name='TotCost'><numberformat
 format='currency' digits='2' punctuated='false' parens='false' percent='false'
 bytes='false'/><code event='defaultvalue'><formula>@If(Exchange = "" | Exchange = 0;TotPrice + ShippingCost + Customs; (TotPrice + ShippingCost + Customs) + Exchange*(TotPrice + ShippingCost + Customs))</formula></code></field></par></tablecell></tablerow>
<tablerow>
<tablecell borderwidth='0px'>
<par def='77'><run><font style='bold'/></run><run><font style='bold'/><computedtext
><code event='value'><formula>@If(@Environment("HECS_Language") = "E"; "Cost w/Applicable HST:"; "Coût avec TVH applicable:")</formula></code></computedtext></run><run
><font style='bold'/>	</run></par></tablecell>
<tablecell borderwidth='0px'>
<par def='78'><run><font style='bold'/></run><field type='number' kind='computed'
 name='TotCostTaxed'><numberformat format='currency' digits='2' punctuated='false'
 parens='false' percent='false' bytes='false'/><code event='defaultvalue'><formula
>REM{2009-06-10: ADR 3550: JML: the verification for the currency was added.  GST is considered only for Canadian currency.};

@If(
  GSTExempt="No" &amp; (Currency = "CAD" | Currency = "CAN" | Currency = "CDN");
    @If(
      @IsError(TotCost * TotGst);
        0;
      TotCost * TotGst);
    TotCost)</formula></code></field><run><font style='bold'/></run></par>
<pardef id='79' leftmargin='0%' rightmargin='100%' keepwithnext='true' keeptogether='true'><code
 event='hidewhen'><formula>!GSTExempt="Yes"</formula></code></pardef>
<par def='79'><run><font style='bold'/></run><run><font color='red'/><computedtext
><code event='value'><formula>@If(@Environment("HECS_Language") = "E"; "Exempted from HST"; "Exempt de la TVH")</formula></code></computedtext></run><run
><font style='bold'/></run></par></tablecell></tablerow></table>
