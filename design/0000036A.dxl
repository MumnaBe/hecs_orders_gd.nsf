<tablecell borderwidth='0px'>
<par def='12'><field type='text' kind='editable' name='DateReq'><code event='defaultvalue'><formula
>FIELD DateReq := DateReq;
datereqd := @Adjust (@Today; 0; 0; 7; 0; 0; 0);
monthsE := "January" : "February" : "March" : "April" : "May" : "June" : "July" : "August" : "September" : "October" : "November" : "December";
monthsF := "Janvier" : "Février" : "Mars" : "Avril" : "Mai" : "Juin" : "Juillet" : "Août" : "Septembre" : "Octobre" : "Novembre" : "Décembre";
monthE := @Subset(@Subset(monthsE; @Month(datereqd)); -1);
monthF := @Subset(@Subset(monthsF; @Month(datereqd)); -1);

@If(@Environment("HECS_Language")="E";
                          @SetField("DateReq"; monthE +" " +@Text(@Day(datereqd)) + ", " + " " +@Text(@Year(datereqd)));
                          @SetField("DateReq"; @Text(@Day(datereqd)) + " " + monthF + ", " + @Text(@Year(datereqd))) )</formula></code></field><run
><font style='bold'/></run></par></tablecell></tablerow>
