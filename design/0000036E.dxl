<tablecell borderwidth='0px 1px'>
<pardef id='41' align='right' leftmargin='2%' rightmargin='98%' keepwithnext='true'
 keeptogether='true'><code event='hidewhen'><formula>(i2Desc="" &amp; i2Quant=0&amp;i2PricePer=0) &amp; (i3Desc=""&amp;i4Desc=""&amp;i5Desc=""&amp;i6Desc=""&amp;i7Desc=""&amp;i8Desc=""&amp;i9Desc=""&amp;i10Desc=""&amp;i11Desc=""&amp;i12Desc=""&amp;i13Desc=""&amp;i14Desc=""&amp;i15Desc=""&amp;i16Desc=""&amp;i17Desc=""&amp;i18Desc=""&amp;i19Desc=""&amp;i20Desc="")</formula></code></pardef>
<par def='41'><run><font style='bold'/></run><run><font style='bold'/><field
 type='number' kind='computed' name='i2PricePer'><numberformat format='currency'
 digits='2' punctuated='false' parens='false' percent='false' bytes='false'/><code
 event='defaultvalue'><formula>i2PricePer</formula></code><code event='exiting'><lotusscript
>Sub Exiting(Source As Field)
     
     
     Dim ws As New notesuiworkspace
     Dim uidoc As notesuidocument
     Dim doc As notesdocument
     Dim Quantity As Integer
     Dim UnitPrice As Currency
     Dim HideCounter As Integer
     Dim TempPrice As String
     Dim Length As Integer     
     Dim H2 As Integer
     
     Set uidoc=ws.currentdocument
     
     Quantity=Val(uidoc.FieldGetText("i2Quant"))
     TempPrice=Ltrim$(uidoc.FieldGetText("i2PricePer"))
     If (Instr(TempPrice, "$")) Then
          Length = Len(TempPrice) -1    ' To remove the $ sign
     Else
          Length = Len(TempPrice)
     End If     
     
     TempPrice = Right$(TempPrice, Length) 
     UnitPrice=Val(TempPrice)
     HideCounter=Val(uidoc.FieldGetText("HideCount"))
     
     
     If ((Quantity=0) And (UnitPrice=0)) Then
          H2 = 1
          Call uidoc.FieldSetText("i2Desc", "")          
          Call uidoc.FieldSetText("H2", Cstr(H2))
     End If
     
     If ((Quantity &gt; 0 Or UnitPrice&gt;0) And HideCounter &lt; 3) Then
          HideCounter = 3
          Call uidoc.FieldSetText("HideCount", Cstr(HideCounter))
     End If
     
     
     uidoc.Refresh
     uidoc.RefreshHideFormulas
     
End Sub</lotusscript></code></field></run><run><font style='bold'/></run></par></tablecell>
<tablecell borderwidth='0px 1px'>
<pardef id='42' align='right' leftmargin='2%' rightmargin='98%' keepwithnext='true'
 keeptogether='true'><code event='hidewhen'><formula>(i2Desc="" &amp; i2Quant=0&amp;i2PricePer=0) &amp; (i3Desc=""&amp;i4Desc=""&amp;i5Desc=""&amp;i6Desc=""&amp;i7Desc=""&amp;i8Desc=""&amp;i9Desc=""&amp;i10Desc=""&amp;i11Desc=""&amp;i12Desc=""&amp;i13Desc=""&amp;i14Desc=""&amp;i15Desc=""&amp;i16Desc=""&amp;i17Desc=""&amp;i18Desc=""&amp;i19Desc=""&amp;i20Desc="")</formula></code></pardef>
