<par def='33'>1.</par></tablecell>
<tablecell borderwidth='1px 1px 0px 0px'>
<pardef id='34' leftmargin='1%' rightmargin='99%' keepwithnext='true' keeptogether='true'><code
 event='hidewhen'><formula>(i1Desc="" &amp; i1Quant=0&amp;i1PricePer=0)</formula></code></pardef>
<par def='34'><run><font style='bold'/></run><run><font style='bold'/><field
 type='text' kind='computed' name='i1Desc'><code event='defaultvalue'><formula
>i1Desc</formula></code><code event='exiting'><lotusscript>Sub Exiting(Source As Field)
     
End Sub</lotusscript></code></field></run><run><font style='bold'/></run></par></tablecell>
<tablecell borderwidth='1px 1px 0px'>
<pardef id='35' align='right' leftmargin='3%' rightmargin='97%' keepwithnext='true'
 keeptogether='true'><code event='hidewhen'><formula>(i1Desc="" &amp; i1Quant=0&amp;i1PricePer=0)</formula></code></pardef>
<par def='35'><run><font style='bold'/></run><run><font style='bold'/><field
 type='number' kind='computed' name='i1Quant'><numberformat format='fixed'
 punctuated='false' parens='false' percent='false' bytes='false'/><code event='defaultvalue'><formula
>i1Quant</formula></code></field></run><run><font style='bold'/></run></par></tablecell>
<tablecell borderwidth='1px 1px 0px'>
<pardef id='36' align='right' leftmargin='2%' rightmargin='98%' keepwithnext='true'
 keeptogether='true'><code event='hidewhen'><formula>(i1Desc="" &amp; i1Quant=0&amp;i1PricePer=0)</formula></code></pardef>
<par def='36'><run><font style='bold'/></run><run><font style='bold'/><field
 type='number' kind='computed' name='i1PricePer'><numberformat format='currency'
 digits='2' punctuated='false' parens='false' percent='false' bytes='false'/><code
 event='defaultvalue'><formula>i1PricePer</formula></code><code event='exiting'><lotusscript
>Sub Exiting(Source As Field)
     
     Dim ws As New notesuiworkspace
     Dim uidoc As notesuidocument
     Dim doc As notesdocument
     Dim Quantity As Integer
     Dim UnitPrice As Currency
     Dim HideCounter As Integer
     Dim TempPrice As String
     Dim Length As Integer     
     Dim H1 As Integer
     
     Set uidoc=ws.currentdocument
     
' Fill variables for Quantity, Price Per, and Hidewhen Counter
     Quantity=Val(uidoc.FieldGetText("i1Quant"))
     TempPrice=Ltrim$(uidoc.FieldGetText("i1PricePer"))
     If (Instr(TempPrice, "$")) Then
          Length = Len(TempPrice) -1    ' To remove the $ sign
     Else
          Length = Len(TempPrice)
     End If     
     
     TempPrice = Right$(TempPrice, Length) 
     UnitPrice=Val(TempPrice)
     HideCounter=Val(uidoc.FieldGetText("HideCount"))
     
     'if there is no quantity and unit price, then this entry has been deleted, therefore we want to hide this entry only and clear the description
     If ((Quantity=0) And (UnitPrice=0)) Then
          H1 = 1
          Call uidoc.FieldSetText("i1Desc", "")          
          Call uidoc.FieldSetText("H1", Cstr(H1))
     End If
     
     ' if there are values for quantity/unit price, and the Hide Counter is lower than 2 (The position number of the next table row) then make the hide counter equal the position of the next
     ' row
     If ((Quantity &gt; 0 Or UnitPrice&gt;0) And HideCounter &lt; 2) Then
          HideCounter = 2
     End If
     
     ' update the hide counter and refresh the document
     Call uidoc.FieldSetText("HideCount", Cstr(HideCounter))
     
     uidoc.Refresh
     uidoc.RefreshHideFormulas
     
End Sub</lotusscript></code></field></run><run><font style='bold'/></run></par></tablecell>
<tablecell borderwidth='1px 1px 0px'>
<pardef id='37' align='right' leftmargin='2%' rightmargin='98%' keepwithnext='true'
 keeptogether='true'><code event='hidewhen'><formula>(i1Desc="" &amp; i1Quant=0&amp;i1PricePer=0)</formula></code></pardef>
<par def='37'><run><font style='bold'/></run><run><font style='bold'/><field
 type='number' kind='computed' name='i1PriceTot'><numberformat format='currency'
 digits='2' punctuated='false' parens='false' percent='false' bytes='false'/><code
 event='defaultvalue'><formula>i1Quant * i1PricePer</formula></code></field></run><run
><font style='bold'/></run></par></tablecell></tablerow>
