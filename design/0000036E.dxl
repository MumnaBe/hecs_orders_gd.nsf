 event='defaultvalue'><formula>REM{ADR 3550: 2009-08-04: JML: Old code: TotPrice * MyGST};

REM{The GST is displayed if the currency is canadian and if the project is not exempted from GST};
@If(
  GSTExempt="No" &amp; (Currency = "CAD" | Currency = "CAN" | Currency = "CDN");
    @If(
      @IsError(TotPrice * MyGST);
        0;
