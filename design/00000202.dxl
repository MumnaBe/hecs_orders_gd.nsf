 event='selection'><formula>SELECT (Form = "OrderForm" | Form = "NewOrderForm")</formula></code><code
 event='querypaste'><lotusscript>Sub Querypaste(Source As Notesuiview, Continue As Variant)
	answer% = Messagebox("You are not authorized to paste orders.  If you want to create a copy of an existing order, use the button ""Copy Existing Order""" + Chr(10) + Chr(10) +  "Vous n'êtes pas autorisé à coller des commandes.  Si vous désirez créer une copie d'une commande existante veuillez utiliser le bouton ""Copier une commande""", 0 + 48, "Orders cannot be pasted / Les commandes ne peuvent être collé")
	continue = False
End Sub</lotusscript></code>
