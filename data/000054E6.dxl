<tablecell>
<par def='10'><run><font size='11pt' style='bold' name='Arial' pitch='variable'
 truetype='true' familyid='20'/>Save &amp; New Entry:</run></par>
<par def='13'><run><font size='11pt' name='Arial' pitch='variable' truetype='true'
 familyid='20'/>This button can be used only by the Administrators</run></par>
<par def='13'><run><font size='11pt' name='Arial' pitch='variable' truetype='true'
 familyid='20'/>This button is displayed only if the Card Holder document is in Edition mode.</run></par>
<par def='13'><run><font size='11pt' name='Arial' pitch='variable' truetype='true'
 familyid='20'/>The button will save and close the current Credit Card document and will create a new one.</run></par></tablecell></tablerow></table>
