<item name='HelpEHelpText'><richtext>
<pardef id='1' leftmargin='1in' rightmargin='100%'/>
<par def='1'><run><font size='12pt' style='bold underline' name='Arial' pitch='variable'
 truetype='true' familyid='20' color='maroon'/>Summary of the buttons and special fields on the Card Holder Form</run></par>
<par def='1'><run><font size='12pt' style='bold underline' name='Arial' pitch='variable'
 truetype='true' familyid='20' color='maroon'/></run></par>
<pardef id='2' leftmargin='1in' rightmargin='100%' tabs='L1in L1.7500in L2.2500in L2.7500in L3.2500in L3.7500in L4.2500in L4.7500in L5.2500in L5.7500in'/>
<par def='2'><run><font size='11pt' name='Arial' pitch='variable' truetype='true'
 familyid='20'/>	</run></par>
<pardef id='3' leftmargin='1in' rightmargin='100%' tabs='L1in L1.3750in L1.7500in L2.2500in L2.7500in L3.2500in L3.7500in L4.2500in L4.7500in L5.2500in L5.7500in'/>
<par def='3'><run><font size='11pt' style='bold underline' name='Arial' pitch='variable'
 truetype='true' familyid='20'/>Purpose:</run><run><font size='11pt' name='Arial'
 pitch='variable' truetype='true' familyid='20'/> This form is used to identify the card holders in the application.  Card holders can have a MasterCard and / or a Visa.</run></par>
<par def='1'><run><font size='11pt' name='Arial' pitch='variable' truetype='true'
 familyid='20'/></run></par>
<pardef id='4' leftmargin='1in' rightmargin='100%' tabs='L1in L1.5000in L1.7500in L2.2500in L2.7500in L3.2500in L3.7500in L4.2500in L4.7500in L5.2500in L5.7500in'/>
<par def='4'><run><font size='11pt' style='bold underline' name='Arial' pitch='variable'
 truetype='true' familyid='20'/>Special Fields: </run></par>
<pardef id='5' leftmargin='1.2500in' rightmargin='100%' list='bullet' tabs='L1in L1.5000in L1.7500in L2.2500in L2.7500in L3.2500in L3.7500in L4.2500in L4.7500in L5.2500in L5.7500in'/>
<par def='5'><run><font size='11pt' style='bold' name='Arial' pitch='variable'
 truetype='true' familyid='20'/>Credit Limit (MasterCard or Visa):</run><run
><font size='11pt' name='Arial' pitch='variable' truetype='true' familyid='20'/> limit of the Credit Card. </run></par>
<par def='5'><run><font size='11pt' style='bold' name='Arial' pitch='variable'
 truetype='true' familyid='20'/>Remaining Credit (MasterCard or Visa): </run><run
><font size='11pt' name='Arial' pitch='variable' truetype='true' familyid='20'/>remaining credit on the Credit Card.  That amount is lowered when the button "Got It" calculate the budget.  The amount is increased when an order is cancelled or reconciled</run></par>
<par def='1'><run><font size='11pt' name='Arial' pitch='variable' truetype='true'
 familyid='20'/></run></par>
