<par def='1'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/></run></par>
<par def='1'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/></run></par>
<par def='1'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/></run></par>
<par def='1'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/></run></par>
<par def='1'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/></run></par>
<par def='1'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/></run></par>
<par def='1'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/></run></par>
<par def='1'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/></run></par>
<par def='1'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/></run></par>
<par def='1'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/></run></par>
<par def='1'><run><font style='bold underline' name='Arial' pitch='variable'
 truetype='true' familyid='20'/>This gives the new user access to orders from that moment on only.</run></par>
<par def='1'><run><font style='bold underline' name='Arial' pitch='variable'
 truetype='true' familyid='20'/></run></par>
<par def='1'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/>If you want the user to see past orders as well, you must trick the database.</run></par>
<par def='1'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/></run></par>
<par def='1'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/>The administrator has access to all orders.  So you must tell the database your new staff is the administrator, refresh the database, then put back the original administrator and refresh again.</run></par>
<par def='1'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/></run></par>
<par def='1'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/>Go to the Keyword Maintenance help file for further instructions.</run></par>
<pardef id='6' leftmargin='1in' spaceafter='1.5'/>
<par def='6'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/></run></par>
