<tablecell>
<pardef id='21' keepwithnext='true' keeptogether='true'/>
<par def='21'><run><font size='11pt' style='bold' name='Arial' pitch='variable'
 truetype='true' familyid='20'/>Re-Calculate Budget:</run></par>
<par def='19'><run><font size='11pt' name='Arial' pitch='variable' truetype='true'
 familyid='20'/>This button is displayed only to the Administrators when the Project document is in edition mode</run></par>
<par def='19'><run><font size='11pt' name='Arial' pitch='variable' truetype='true'
 familyid='20'/>This button will re-calculate the budget for the project based on the Orders falling within the same FY than the Project and that have been previously calculated.  This means that only the Orders for which the button "On Order" has been used.</run></par></tablecell></tablerow></table>
<par def='13'><run><font size='11pt' style='bold' name='Arial' pitch='variable'
 truetype='true' familyid='20'/></run></par>
<par def='13'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/></run></par>
<par def='13'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/></run></par>
<par def='13'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/></run></par></richtext></item>
<item name='HelpFHelpText'><richtext>
<pardef id='22' leftmargin='1in'/>
<par def='22'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/></run></par></richtext></item>
<item name='HelpESubject'><text>Summary: Buttons and Special Fields on the Project Form</text></item>
<item name='HelpFSubject'><text>Sommaire: boutons dans le formulaire de projets</text></item></document>

