<item name='HelpECategories'><text>2. Database Custodian Guide</text></item>
<item name='HelpESubCat'><text>Receiving and Reconciling Orders</text></item>
<item name='HelpFCategories'><text>2. Guide de gardien de base de données</text></item>
<item name='HelpFSubCat'><text>Receiving and Reconciling Orders</text></item>
<item name='HelpDocNumber'><number>3</number></item>
<item name='HelpSubCatNumber'><number>1</number></item>
<item name='HelpEHelpText'><richtext>
<pardef id='1' leftmargin='0.8125in' rightmargin='73%'/>
<par def='1'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/>An order is considered to be reconciled after the following conditions have been met.</run></par>
<par def='1'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/></run></par>
<par def='1'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/>	</run><run
><font style='bold' name='Arial' pitch='variable' truetype='true' familyid='20'/>Credit Card Order</run></par>
<pardef id='2' leftmargin='1.5000in' rightmargin='73%'/>
<par def='2'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/>Invoice from the supplier/company has been received</run></par>
<par def='2'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/>	</run><run
><font style='bold' name='Arial' pitch='variable' truetype='true' familyid='20'/>AND</run></par>
<par def='2'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/>Order has been reconciled on FIRMS credit card statement and accepted by SAP</run></par>
<par def='1'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/></run></par>
<pardef id='3' leftmargin='1.7500in' rightmargin='73%'/>
<par def='3'><run><font size='12pt' style='bold' name='Arial' pitch='variable'
 truetype='true' familyid='20'/>OR</run></par>
<par def='1'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/></run></par>
<par def='1'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/>	</run><run
><font style='bold' name='Arial' pitch='variable' truetype='true' familyid='20'/>Purchase Order or other (e.g. travel, petty cash)</run></par>
<par def='2'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/>Invoice from the supplier/company has been received and processed through to Finance</run></par>
<par def='2'><run><font style='bold' name='Arial' pitch='variable' truetype='true'
 familyid='20'/>	AND</run></par>
<par def='2'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/>Order has appeared in a SAP report</run></par>
<pardef id='4' leftmargin='0.8118in' rightmargin='73%'/>
<par def='4'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/></run></par>
<par def='4'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/></run></par>
<par def='4'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/>To change the status of an order to reconciled:</run></par>
<par def='4'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/></run></par>
<par def='1'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/>1.  Select the type of view you want to use to find the order.</run></par>
<par def='1'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/></run></par>
