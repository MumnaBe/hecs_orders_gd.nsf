<item name='HelpEHelpText'><richtext>
<pardef id='1' leftmargin='0.8125in' rightmargin='93%'/>
<par def='1'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/>For general questions or comments, please contact the database custodians (Josée Guenette, Pat Goegan) in your area.</run></par>
<par def='1'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/></run></par>
<par def='1'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/>For technical assistance, please contact the IMSD Helpdesk.</run></par>
<par def='1'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/></run></par>
<par def='1'><run><font size='9pt' style='underline' name='Arial' pitch='variable'
 truetype='true' familyid='20'/>Help Desk</run><run><font size='9pt' name='Arial'
 pitch='variable' truetype='true' familyid='20'/>:</run></par>
<pardef id='2'/>
<par def='2'><run><font size='9pt' name='Arial' pitch='variable' truetype='true'
 familyid='20'/>Phone:  954-8718 at headquarters, or 1-800-416-0358 nationally.</run></par>
<par def='2'><run><font size='9pt' name='Arial' pitch='variable' truetype='true'
 familyid='20'/>E-mail:  </run><run><font size='9pt' style='bold' name='Arial'
 pitch='variable' truetype='true' familyid='20' color='purple'/>To:</run><run
><font size='9pt' name='Arial' pitch='variable' truetype='true' familyid='20'/>  IMSD Helpdesk, </run><run
><font size='9pt' style='bold' name='Arial' pitch='variable' truetype='true'
 familyid='20' color='purple'/>Subject:</run><run><font size='9pt' name='Arial'
 pitch='variable' truetype='true' familyid='20'/>  OPEN CALL.</run></par>
<par def='2'><run><font size='9pt' name='Arial' pitch='variable' truetype='true'
 familyid='20'/></run></par>
<par def='2'><run><font size='9pt' name='Arial' pitch='variable' truetype='true'
 familyid='20'/>Where the subject must be uppercase 'OPEN CALL'.</run></par>
<par def='2'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/></run></par></richtext></item>
<item name='HelpFHelpText'><richtext>
<pardef id='3' leftmargin='0.8125in' rightmargin='93%'/>
<par def='3'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/></run></par>
<par def='3'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/>Pour toute question d'ordre général ou commentaires, veuillez communiquer avec les gestionnaires de la base de données (Josée Guénette, Pat Goegan).</run></par>
<par def='3'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/></run></par>
<par def='3'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/>Le soutien technique relève de DSGI - Bureau d'aide.</run></par>
<par def='3'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/></run></par>
<pardef id='4' leftmargin='1.0625in' rightmargin='93%' list='bullet'/>
<par def='4'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/>Téléphone : 954-8718 au bureau principal ou 1-800-416-0358 à l'échelle nationale.</run></par>
<par def='4'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/>Courrier électronique :</run><run
><font style='bold' name='Arial' pitch='variable' truetype='true' familyid='20'/>	</run><run
><font style='bold' name='Arial' pitch='variable' truetype='true' familyid='20'
 color='maroon'/>Destinataire</run><run><font name='Arial' pitch='variable'
 truetype='true' familyid='20'/> : DSGI - Bureau d'aide</run></par>
<pardef id='5' leftmargin='0.8125in' rightmargin='93%' list='bullet'/>
<par def='5'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/>				</run><run
><font style='bold' name='Arial' pitch='variable' truetype='true' familyid='20'
 color='maroon'/>Sujet</run><run><font name='Arial' pitch='variable' truetype='true'
 familyid='20'/> : OUVRIR UN APPEL (le sujet doit être écrit en lettres majuscules).</run></par></richtext></item>
