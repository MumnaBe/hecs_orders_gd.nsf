<par def='1'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/></run></par>
<par def='1'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/>13. Click on "Exit" to close the document.</run></par>
<par def='1'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/></run></par>
