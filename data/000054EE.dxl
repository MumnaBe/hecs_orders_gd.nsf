<item name='OriginalModTime'><datetime dst='true'>20090807T112953,02-04</datetime></item>
<item name='HFText'><text>Yes</text></item>
<item name='HelpECategories'><text>1. User Guide</text></item>
<item name='HelpESubCat'><text>Placing An Order</text></item>
<item name='HelpFCategories'><text>1. Guide d'utilisation</text></item>
<item name='HelpFSubCat'><text>Commander</text></item>
<item name='HelpDocNumber'><number>3</number></item>
<item name='HelpSubCatNumber'><number>1</number></item>
<item name='HelpEHelpText'><richtext>
<pardef id='1' leftmargin='1in'/>
<par def='1'><run><font size='12pt' style='bold underline' name='Arial' pitch='variable'
 truetype='true' familyid='20' color='maroon'/>Summary of the buttons and special fields on the Order Form</run></par>
<pardef id='2' leftmargin='1in' rightmargin='100%' tabs='L1in L1.7500in L2.2500in L2.7500in L3.2500in L3.7500in L4.2500in L4.7500in L5.2500in L5.7500in'/>
<par def='2'><run><font size='11pt' name='Arial' pitch='variable' truetype='true'
 familyid='20'/></run></par>
<pardef id='3' leftmargin='1in' rightmargin='100%' tabs='L1in L1.3750in L1.7500in L2.2500in L2.7500in L3.2500in L3.7500in L4.2500in L4.7500in L5.2500in L5.7500in'/>
<par def='3'><run><font size='11pt' style='bold underline' name='Arial' pitch='variable'
 truetype='true' familyid='20'/>Purpose of the Order Form:</run><run><font
 size='11pt' name='Arial' pitch='variable' truetype='true' familyid='20'/> Places orders based on projects, this form captures Order Information, Employee Information, Company Information, Items and Cost information. Most importantly it captures a Financial Code and Order Number.</run></par>
<par def='1'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/></run></par>
<pardef id='4' leftmargin='1in' rightmargin='100%' tabs='L1in L1.5000in L1.7500in L2.2500in L2.7500in L3.2500in L3.7500in L4.2500in L4.7500in L5.2500in L5.7500in'/>
<par def='4'><run><font size='11pt' style='bold underline' name='Arial' pitch='variable'
 truetype='true' familyid='20'/>Special Fields: </run></par>
<table widthtype='fitmargins' refwidth='9.7500in'><tablecolumn width='18.3403%'/><tablecolumn
 width='81.6597%'/>
<tablerow>
<tablecell>
<pardef id='6' keepwithnext='true' keeptogether='true'/>
<par def='6'><run><font size='11pt' style='bold' name='Arial' pitch='variable'
 truetype='true' familyid='20'/>Field name</run></par></tablecell>
<tablecell>
<pardef id='7' leftmargin='0.0104in' keepwithnext='true' keeptogether='true'/>
<par def='7'><run><font size='11pt' style='bold' name='Arial' pitch='variable'
 truetype='true' familyid='20'/>Description</run></par></tablecell></tablerow>
<tablerow>
<tablecell>
<pardef id='8' tabs='L1in L1.5000in L1.7500in L2.2500in L2.7500in L3.2500in L3.7500in L4.2500in L4.7500in L5.2500in L5.7500in'
 keepwithnext='true' keeptogether='true'/>
<par def='8'><run><font size='11pt' name='Arial' pitch='variable' truetype='true'
 familyid='20'/>Project</run></par></tablecell>
<tablecell>
<pardef id='9' tabs='L1in L1.5000in L1.7500in L2.2500in L2.7500in L3.2500in L3.7500in L4.2500in L4.7500in L5.2500in L5.7500in'
 keepwithnext='true' keeptogether='true'/>
<par def='9'><run><font size='11pt' name='Arial' pitch='variable' truetype='true'
 familyid='20'/>Opens a dialogue list associated to a keyword list of Projects which are created by the Administrator</run></par></tablecell></tablerow>
<tablerow>
<tablecell>
<par def='8'><run><font size='11pt' name='Arial' pitch='variable' truetype='true'
 familyid='20'/>Financial Code</run></par></tablecell>
<tablecell>
<par def='9'><run><font size='11pt' name='Arial' pitch='variable' truetype='true'
 familyid='20'/>Identify the Financial Code used to purchase the items.  The Project has to be selected prior to choose a Financial Code.  The Financial code is chosen by clicking on the button “Generate Financial Code”.</run></par></tablecell></tablerow>
<tablerow>
<tablecell>
<par def='8'><run><font size='11pt' name='Arial' pitch='variable' truetype='true'
 familyid='20'/>Card Holder</run></par></tablecell>
<tablecell>
<par def='9'><run><font size='11pt' name='Arial' pitch='variable' truetype='true'
 familyid='20'/>Identify the MasterCard and VISA card holder.  This field is not visible if the purchase type is "Purchase Order".</run></par></tablecell></tablerow>
<tablerow>
<tablecell>
<par def='8'><run><font size='11pt' name='Arial' pitch='variable' truetype='true'
 familyid='20'/>Signing Authorities</run></par></tablecell>
<tablecell>
<par def='9'><run><font size='11pt' name='Arial' pitch='variable' truetype='true'
 familyid='20'/>Identify the signing authorities for that order if the purchase type is not MasterCard or VISA.</run></par></tablecell></tablerow>
<tablerow>
<tablecell>
<par def='8'><run><font size='11pt' name='Arial' pitch='variable' truetype='true'
 familyid='20'/>Cost W/Applicable GST</run></par></tablecell>
<tablecell>
<par def='9'><run><font size='11pt' name='Arial' pitch='variable' truetype='true'
 familyid='20'/>This is the total cost of the order with the applicable GST amount.  If the Project is exempted from GST or if the currency is not Canadian, the GST is not included to the cost.  The Cost W/Applicable GST is used to commit amounts to the project and to adjust the remaining credit on the credit cards.  That cost also take in consideration the Exchange rate, custom cost, and the shipping cost.</run></par></tablecell></tablerow>
<tablerow>
<tablecell>
<par def='8'><run><font size='11pt' name='Arial' pitch='variable' truetype='true'
 familyid='20'/>Reference number</run></par></tablecell>
<tablecell>
<par def='9'><run><font size='11pt' name='Arial' pitch='variable' truetype='true'
 familyid='20'/>Sequential number generated when the Administrator clicks on the button [Got it].</run></par></tablecell></tablerow></table>
<par def='4'><run><font size='11pt' name='Arial' pitch='variable' truetype='true'
 familyid='20'/></run></par>
<par def='4'><run><font size='11pt' style='bold underline' name='Arial' pitch='variable'
 truetype='true' familyid='20'/>Buttons: </run></par>
<table widthtype='fitmargins' refwidth='9.7500in'><tablecolumn width='18.3403%'/><tablecolumn
 width='81.6597%'/>
<tablerow>
<tablecell>
