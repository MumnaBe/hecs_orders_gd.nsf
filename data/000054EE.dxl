lWdPl2vbup0od65XmnW/iiS4ta/fvmL/Ch78MTDhw4gjBp5K9SLaxJBDGpZ5kmpZsHT/ft3cUW9h
vhqnVi0gICpmmW939uTMNbNrvKjfxs44+XJG25Fzb5ysu7fRh8CDCx9OPKHv40x5I1/eUTnz5xYN
l0wrcTp03YZLo6xO1uz1xLy1U2rt7r217K16YXcOC5qjeNy3s8JeCxdvXPM+V+e9r5e3aPHUuXab
XOptdtdc56lW4IHn7TVQaOS5ZFpXsRVYIWoWmqdeam6pFl17dI1WnksifgceiBaNOJGKJgrmXIvL
vQjjccXVaOONxQUEADs=
</gif></picture><run
><font size='11pt' name='Arial' pitch='variable' truetype='true' familyid='20'/></run></par></tablecell>
<tablecell>
<par def='7'><run><font size='11pt' style='bold' name='Arial' pitch='variable'
 truetype='true' familyid='20'/>Cancel Order:</run></par>
<par def='13'><run><font size='11pt' name='Arial' pitch='variable' truetype='true'
 familyid='20'/>This button is displayed only to the Administrators</run></par>
<par def='13'><run><font size='11pt' name='Arial' pitch='variable' truetype='true'
 familyid='20'/>Allows the Administrators to cancel the order</run></par>
<par def='13'><run><font size='11pt' name='Arial' pitch='variable' truetype='true'
 familyid='20'/>The status of the Order is changed to “</run><run><font size='11pt'
 style='bold' name='Arial' pitch='variable' truetype='true' familyid='20'/>Cancelled</run><run
><font size='11pt' name='Arial' pitch='variable' truetype='true' familyid='20'/>”</run></par>
<par def='13'><run><font size='11pt' name='Arial' pitch='variable' truetype='true'
 familyid='20'/>(</run><run><font size='11pt' style='bold italic' name='Arial'
 pitch='variable' truetype='true' familyid='20'/>NEW added to the August 2009 release</run><run
><font size='11pt' name='Arial' pitch='variable' truetype='true' familyid='20'/>) The system will remove committed amount to the project and will adjust the Remaining Credit on the Credit Card if the purchase type was MasterCard or VISA.</run></par>
<par def='13'><run><font size='11pt' name='Arial' pitch='variable' truetype='true'
 familyid='20'/>The systems will also set the quantities and prices to zero on the order’s list.</run></par></tablecell></tablerow></table>
<par def='1'><run><font size='11pt' style='bold' name='Arial' pitch='variable'
 truetype='true' familyid='20'/></run></par>
<par def='1'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/></run></par>
<par def='1'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/></run></par>
<par def='1'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/></run></par></richtext></item>
<item name='HelpFHelpText'><richtext>
<pardef id='15' leftmargin='1in'/>
<par def='15'><run><font name='Arial' pitch='variable' truetype='true' familyid='20'/>Veuillez vous référez à l'anglais.  Pour obtenir la version française, veuillez contacter l'administrateur</run></par></richtext></item>
